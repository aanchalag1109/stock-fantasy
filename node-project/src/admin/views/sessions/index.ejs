<%
  function sched(d) {
    if (!d) return '';
    const parts = new Intl.DateTimeFormat('en-US', {
      timeZone: 'Asia/Kolkata',
      month: 'short',
      day: 'numeric',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
      hourCycle: 'h23',
    }).formatToParts(new Date(d));
    const get = (type) => (parts.find((part) => part.type === type) || {}).value || '';
    return get('month') + ' ' + get('day') + ', ' + get('year') + ' ' + get('hour') + ':' + get('minute');
  }
  const statusColors = { live: 'success', upcoming: 'info', completed: 'warning', draft: 'secondary', cancelled: 'danger' };
  const statusIcons = { live: 'broadcast', upcoming: 'clock', completed: 'check-circle', draft: 'file-earmark', cancelled: 'x-octagon' };
%>
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0"><i class="bi bi-calendar2-week me-2"></i>Leagues & Sessions</h1>
            <small class="text-muted">Current Time (IST): <span id="current-time"></span></small>
        </div>
        <div>
            <button onclick="bulkDelete()" class="btn btn-outline-danger me-2" id="bulkDeleteBtn" style="display:none;">
                <i class="bi bi-trash me-1"></i>Delete Selected
            </button>
            <a href="/league_sessions/create" class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i>Create New Session
            </a>
        </div>
    </div>
    <%- include('../partials/list_filters', {
        basePath: '/league_sessions', dateLabel: 'Start date',
        sortLabels: { latest: 'Latest first', oldest: 'Oldest first' },
        tabs: [
            { value: '', label: 'All', icon: 'list', color: 'dark' },
            { value: 'live', label: 'Live', icon: 'broadcast', color: 'success' },
            { value: 'upcoming', label: 'Upcoming', icon: 'clock', color: 'info' },
            { value: 'completed', label: 'Completed', icon: 'check-circle', color: 'warning' },
            { value: 'draft', label: 'Draft', icon: 'file-earmark', color: 'secondary' },
            { value: 'cancelled', label: 'Cancelled', icon: 'x-octagon', color: 'danger' },
        ],
    }) %>
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="fw-semibold"><input type="checkbox" id="selectAll"></th>
                            <th class="fw-semibold"><i class="bi bi-image me-1"></i>Image</th>
                            <th class="fw-semibold"><i class="bi bi-tag me-1"></i>Session Name</th>
                            <th class="fw-semibold"><i class="bi bi-graph-up me-1"></i>Market</th>
                            <th class="fw-semibold"><i class="bi bi-collection me-1"></i>Max Stocks</th>
                            <th class="fw-semibold"><i class="bi bi-calendar-event me-1"></i>Schedule</th>
                            <th class="fw-semibold"><i class="bi bi-door-open me-1"></i>Registration</th>
                            <th class="fw-semibold"><i class="bi bi-circle-fill me-1"></i>Status</th>
                            <th class="fw-semibold"><i class="bi bi-toggles me-1"></i>Active</th>
                            <th class="fw-semibold text-center"><i class="bi bi-gear me-1"></i>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% sessions.forEach(s => {
                            const st = s.status || 'upcoming';
                            const active = s.active !== false;
                        %>
                        <tr>
                            <td>
                                <% if (st !== 'live' || !active) { %>
                                <input type="checkbox" class="session-checkbox" value="<%= s._id %>">
                                <% } %>
                            </td>
                            <td>
                                <% if (s.image_url) { %>
                                    <img src="<%= s.image_url %>" alt="<%= s.name %>" class="rounded" style="width: 50px; height: 50px; object-fit: cover;">
                                <% } else { %>
                                    <div class="bg-light rounded d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;"><i class="bi bi-image text-muted"></i></div>
                                <% } %>
                            </td>
                            <td><div class="fw-semibold text-dark"><%= s.name %></div></td>
                            <td>
                                <span class="badge <%= s.market_type === 'stock' ? 'bg-primary' : 'bg-warning' %>">
                                    <i class="bi bi-<%= s.market_type === 'stock' ? 'graph-up' : 'currency-bitcoin' %> me-1"></i>
                                    <%= (s.market_type || 'stock').charAt(0).toUpperCase() + (s.market_type || 'stock').slice(1) %>
                                </span>
                            </td>
                            <td><span class="badge bg-light text-dark"><%= s.max_stocks || 0 %></span></td>
                            <td>
                                <div class="small">
                                    <div><i class="bi bi-play-circle text-success me-1"></i><%= sched(s.start_time) %></div>
                                    <div><i class="bi bi-stop-circle text-danger me-1"></i><%= sched(s.end_time) %></div>
                                </div>
                            </td>
                            <td>
                                <div class="small">
                                    <% if (s.user_joining_start_time) { %>
                                        <div><i class="bi bi-door-open text-info me-1"></i><%= sched(s.user_joining_start_time) %></div>
                                    <% } else { %>
                                        <div class="text-muted"><i class="bi bi-dash me-1"></i>Not Set</div>
                                    <% } %>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-<%= statusColors[st] || 'secondary' %> status-badge" data-session-id="<%= s.old_id || s._id %>">
                                    <i class="bi bi-<%= statusIcons[st] || 'circle' %> me-1"></i><%= st.charAt(0).toUpperCase() + st.slice(1) %>
                                </span>
                            </td>
                            <td>
                                <span class="badge <%= active ? 'bg-success' : 'bg-danger' %>">
                                    <i class="bi bi-<%= active ? 'check' : 'x' %>-circle me-1"></i><%= active ? 'Active' : 'Inactive' %>
                                </span>
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <% if (st === 'upcoming' || st === 'live') { %>
                                        <a href="/league_sessions/<%= s._id %>" class="btn btn-outline-success" title="View Session"><i class="bi bi-eye"></i></a>
                                    <% } %>
                                    <% if (st === 'completed') { %>
                                        <a href="/league_sessions/<%= s._id %>/edit" class="btn btn-outline-info" title="View Details"><i class="bi bi-eye"></i></a>
                                    <% } else if (st === 'live') { %>
                                        <a href="/league_sessions/<%= s._id %>/edit" class="btn btn-outline-warning" title="Deactivate Only"><i class="bi bi-pause-circle"></i></a>
                                    <% } else if (st !== 'upcoming') { %>
                                        <a href="/league_sessions/<%= s._id %>/edit" class="btn btn-outline-primary" title="Edit Session"><i class="bi bi-pencil"></i></a>
                                    <% } else { %>
                                        <a href="/league_sessions/<%= s._id %>/edit" class="btn btn-outline-primary" title="Edit Session"><i class="bi bi-pencil"></i></a>
                                    <% } %>
                                    <%# NEW IMPLEMENTATION — NODE.JS PROJECT: client feedback — cancel (with refunds) from the list %>
                                    <% if (can('sessions.cancel') && ['upcoming', 'live', 'draft'].includes(st)) { %>
                                    <button type="button" class="btn btn-outline-warning" title="Cancel Session (refunds joined users)" onclick="cancelSession('<%= s._id %>', <%= JSON.stringify(s.name || '') %>)"><i class="bi bi-x-octagon"></i></button>
                                    <% } %>
                                    <% if (st !== 'live' || !active) { %>
                                    <form action="/league_sessions/<%= s._id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Delete this session? Joined users of its open contests are refunded first. This action cannot be undone.')">
                                        <button type="submit" class="btn btn-outline-danger" title="Delete Session"><i class="bi bi-trash"></i></button>
                                    </form>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                        <% }) %>
                        <% if (!sessions.length) { %>
                        <tr>
                            <td colspan="10" class="text-center py-5">
                                <div class="text-muted">
                                    <i class="bi bi-inbox display-1 d-block mb-3"></i>
                                    <h5>No sessions found</h5>
                                    <p>Create your first league session to get started.</p>
                                    <a href="/league_sessions/create" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>Create New Session</a>
                                </div>
                            </td>
                        </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
        <% if (typeof pages !== 'undefined' && pages > 1) {
            const from = ((page - 1) * pageSize) + 1;
            const to = ((page - 1) * pageSize) + sessions.length;
        %>
        <div class="card-footer bg-light">
            <div class="d-flex justify-content-between align-items-center">
                <div class="text-muted small">Showing <%= from %> to <%= to %> of <%= total %> sessions</div>
                <div><%- include('../partials/pagination', { pages, page, extraQuery: filters.queryString }) %></div>
            </div>
        </div>
        <% } %>
    </div>
</div>
<script>
function tick() {
    const el = document.getElementById('current-time');
    if (!el) return;
    el.textContent = new Date().toLocaleString('en-US', { timeZone: 'Asia/Kolkata', month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false });
}
tick(); setInterval(tick, 1000);
setInterval(function() {
    fetch('/league_sessions/update-status', { method: 'POST' })
        .then(function(response) { return response.json(); })
        .then(function(data) {
            if (data.updated_to_live > 0 || data.updated_to_completed > 0) location.reload();
        })
        .catch(function() {});
}, 10000);
document.addEventListener('DOMContentLoaded', function() {
    const boxes = document.querySelectorAll('.session-checkbox');
    const btn = document.getElementById('bulkDeleteBtn');
    const all = document.getElementById('selectAll');
    function refresh() { if (btn) btn.style.display = document.querySelectorAll('.session-checkbox:checked').length ? 'inline-block' : 'none'; }
    all?.addEventListener('change', function() { boxes.forEach(b => { b.checked = this.checked; }); refresh(); });
    boxes.forEach(b => b.addEventListener('change', refresh));
});
// NEW IMPLEMENTATION — NODE.JS PROJECT: client feedback — cancel a session from the list
function cancelSession(id, name) {
    if (!confirm('Cancel session "' + name + '"?

All its contests will be cancelled and every joined user refunded their entry fee. This cannot be undone.')) return;
    fetch('/league_sessions/' + id + '/cancel', { method: 'POST', headers: { Accept: 'application/json' } })
        .then(function (r) { return r.json(); })
        .then(function (data) { alert(data.message || (data.success ? 'Session cancelled' : 'Could not cancel session')); if (data.success) location.reload(); })
        .catch(function () { alert('Could not cancel session'); });
}
function bulkDelete() {
    const checked = document.querySelectorAll('.session-checkbox:checked');
    if (!checked.length) return;
    if (!confirm('Delete ' + checked.length + ' selected session(s)?')) return;
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = '/league_sessions/bulk-delete';
    checked.forEach(cb => {
        const input = document.createElement('input');
        input.type = 'hidden'; input.name = 'session_ids'; input.value = cb.value;
        form.appendChild(input);
    });
    document.body.appendChild(form);
    form.submit();
}
</script>
