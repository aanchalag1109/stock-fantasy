<%#
  PHP PARITY — restored from PHP admin/league_sessions/edit.blade.php: status-dependent locking,
  Activation select (deactivating a LIVE session cancels it and refunds all users), times in IST,
  and asset selection (editable for draft sessions).
%>
<%
  const can = (field) => editable.includes(field);
  const lockNote = (text) => `<div class="form-text text-muted"><i class="bi bi-lock me-1"></i>${text}</div>`;
  const dt = (v) => v ? v.replace(' ', 'T').slice(0, 16) : '';
  const isLive = session.status === 'live';
  const isActive = session.active !== false;
%>
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1"><i class="bi bi-pencil-square text-warning me-2"></i>Edit Session</h1>
            <p class="text-muted mb-0">Modify session parameters and settings</p>
        </div>
        <a href="/league_sessions" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back to Sessions</a>
    </div>

    <% if (isLive) { %>
    <div class="alert alert-warning border-0 shadow-sm mb-4"><i class="bi bi-exclamation-triangle-fill me-2"></i><strong>Live Session:</strong> You can only rename it or deactivate it (deactivating cancels all contests and refunds all users).</div>
    <% } else if (session.status === 'upcoming') { %>
    <div class="alert alert-info border-0 shadow-sm mb-4"><i class="bi bi-info-circle-fill me-2"></i><strong>Upcoming Session:</strong> You can modify session times. To stop it, use Cancel Session on the session page or in Live Management.</div>
    <% } %>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-warning text-dark"><h5 class="mb-0"><i class="bi bi-gear-fill me-2"></i>Session Configuration</h5></div>
        <div class="card-body p-4">
            <form id="sessionEditForm" action="/league_sessions/<%= session._id %>?_method=PUT" method="POST">
                <h6 class="text-warning mb-3"><i class="bi bi-info-circle me-2"></i>Basic Information</h6>
                <div class="row mb-4">
                    <div class="col-md-6 mb-3">
                        <label for="name" class="form-label fw-semibold">Session Name <span class="text-danger">*</span></label>
                        <input type="text" name="name" id="name" class="form-control form-control-lg" value="<%= session.name %>" maxlength="255" <%= can('name') ? 'required' : 'readonly' %>>
                        <% if (!can('name')) { %><%- lockNote(`Locked for ${session.status} sessions`) %><% } %>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="market_type" class="form-label fw-semibold">Market Type <span class="text-danger">*</span></label>
                        <select class="form-select form-select-lg" id="market_type" name="market_type" <%= can('market_type') ? '' : 'disabled' %>>
                            <option value="stock" <%= session.market_type === 'stock' ? 'selected' : '' %>>Stock Market</option>
                            <option value="crypto" <%= session.market_type === 'crypto' ? 'selected' : '' %>>Cryptocurrency</option>
                        </select>
                        <% if (!can('market_type')) { %><%- lockNote(`Locked for ${session.status} sessions`) %><% } %>
                    </div>
                </div>

                <h6 class="text-warning mb-3"><i class="bi bi-collection me-2"></i>Asset Selection</h6>
                <div class="card border-0 bg-light mb-4"><div class="card-body">
                    <% if (can('assets')) { %>
                        <ul class="nav nav-pills mb-3" id="categoryTabs"></ul>
                        <div class="tab-content" id="categoryTabContent"><div class="text-muted">Loading assets…</div></div>
                        <div class="form-text">Selected: <strong id="selectedCount"><%= selectedAssets.length %></strong>. Leave everything unchecked to keep the current assets.</div>
                    <% } else { %>
                        <div class="d-flex flex-wrap gap-1 mb-2">
                            <% selectedAssets.forEach(sym => { %><span class="badge bg-secondary"><%= sym %></span><% }) %>
                            <% if (!selectedAssets.length) { %><span class="text-muted">No assets</span><% } %>
                        </div>
                        <%- lockNote(`Asset selection is locked for ${session.status} sessions.`) %>
                    <% } %>
                </div></div>

                <h6 class="text-warning mb-3"><i class="bi bi-briefcase me-2"></i>Portfolio Settings</h6>
                <div class="row mb-4">
                    <div class="col-md-6 mb-3">
                        <label for="max_stocks" class="form-label fw-semibold">Max Assets in Portfolio <span class="text-danger">*</span></label>
                        <input type="number" name="max_stocks" id="max_stocks" class="form-control form-control-lg" value="<%= session.max_stocks || 5 %>" min="1" max="50" <%= can('max_stocks') ? 'required' : 'readonly' %>>
                        <% if (!can('max_stocks')) { %><%- lockNote(`Locked for ${session.status} sessions`) %><% } else { %><div class="form-text">Maximum number of assets a user can hold in their portfolio</div><% } %>
                    </div>
                </div>

                <h6 class="text-warning mb-3"><i class="bi bi-calendar-event me-2"></i>Schedule Settings (IST)</h6>
                <div class="row mb-4">
                    <div class="col-md-4 mb-3">
                        <label for="user_joining_start_time" class="form-label fw-semibold">Joining Opens</label>
                        <input type="datetime-local" name="user_joining_start_time" id="user_joining_start_time" class="form-control form-control-lg" value="<%= dt(times.user_joining_start_time) %>" <%= can('user_joining_start_time') ? '' : 'readonly' %>>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label for="start_time" class="form-label fw-semibold">Session Starts <span class="text-danger">*</span></label>
                        <input type="datetime-local" name="start_time" id="start_time" class="form-control form-control-lg" value="<%= dt(times.start_time) %>" <%= can('start_time') ? 'required' : 'readonly' %>>
                        <% if (!can('start_time')) { %><%- lockNote('Cannot modify live session times') %><% } %>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label for="end_time" class="form-label fw-semibold">Session Ends <span class="text-danger">*</span></label>
                        <input type="datetime-local" name="end_time" id="end_time" class="form-control form-control-lg" value="<%= dt(times.end_time) %>" <%= can('end_time') ? 'required' : 'readonly' %>>
                        <% if (!can('end_time')) { %><%- lockNote('Cannot modify live session times') %><% } %>
                    </div>
                </div>

                <h6 class="text-warning mb-3"><i class="bi bi-toggles me-2"></i>Status &amp; Activation</h6>
                <div class="row mb-4">
                    <div class="col-md-6 mb-3">
                        <label for="status" class="form-label fw-semibold">Session Status</label>
                        <select name="status" id="status" class="form-select form-select-lg" <%= can('status') ? '' : 'disabled' %>>
                            <% ['draft', 'upcoming', 'live', 'completed'].forEach(st => { %>
                            <option value="<%= st %>" <%= session.status === st ? 'selected' : '' %>><%= st.charAt(0).toUpperCase() + st.slice(1) %></option>
                            <% }) %>
                        </select>
                        <% if (!can('status')) { %><%- lockNote(`Status locked for ${session.status} sessions`) %><% } %>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="active" class="form-label fw-semibold">Activation Status</label>
                        <select name="active" id="active" class="form-select form-select-lg" <%= can('active') ? '' : 'disabled' %>>
                            <option value="1" <%= isActive ? 'selected' : '' %>>🟢 Active</option>
                            <option value="0" <%= !isActive ? 'selected' : '' %>>🔴 Inactive</option>
                        </select>
                        <% if (!can('active')) { %><%- lockNote(`Locked for ${session.status} sessions`) %>
                        <% } else if (isLive) { %><div class="form-text text-warning"><i class="bi bi-exclamation-triangle me-1"></i>Deactivating cancels all contests and refunds all users</div><% } %>
                    </div>
                </div>

                <div class="d-flex gap-3 justify-content-end">
                    <a href="/league_sessions" class="btn btn-outline-secondary btn-lg px-4"><i class="bi bi-x-circle me-2"></i>Cancel</a>
                    <button type="submit" class="btn btn-warning btn-lg px-4"><i class="bi bi-check-circle me-2"></i>Update Session</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
(function () {
    var form = document.getElementById('sessionEditForm');
    var IS_LIVE_ACTIVE = <%= isLive && isActive ? 'true' : 'false' %>;
    form.addEventListener('submit', function (e) {
        var active = document.getElementById('active');
        if (IS_LIVE_ACTIVE && active && active.value === '0'
            && !confirm('Deactivating this live session will cancel all its contests and refund every user. Are you sure?')) {
            e.preventDefault();
        }
    });

    <% if (can('assets')) { %>
    var SELECTED = new Set(<%- JSON.stringify(selectedAssets) %>);
    var market = document.getElementById('market_type');
    var tabs = document.getElementById('categoryTabs');
    var content = document.getElementById('categoryTabContent');
    function esc(v) { return String(v == null ? '' : v).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
    function countSelected() { document.getElementById('selectedCount').textContent = content.querySelectorAll('input[type=checkbox]:checked').length; }
    function loadCategories() {
        var type = market.value;
        tabs.innerHTML = '';
        content.innerHTML = '<div class="text-muted">Loading assets…</div>';
        fetch('/api/categories/' + encodeURIComponent(type), { headers: { Accept: 'application/json' } })
            .then(function (r) { return r.json(); })
            .then(function (categories) {
                return Promise.all(categories.map(function (cat) {
                    return fetch('/api/assets/' + encodeURIComponent(cat.id), { headers: { Accept: 'application/json' } })
                        .then(function (r) { return r.json(); })
                        .then(function (assets) { return { cat: cat, assets: assets }; });
                }));
            })
            .then(function (groups) {
                tabs.innerHTML = groups.map(function (g, i) {
                    return '<li class="nav-item"><button class="nav-link' + (i === 0 ? ' active' : '') + '" type="button" data-bs-toggle="tab" data-bs-target="#cat-' + esc(g.cat.id) + '">' + esc(g.cat.name) + '</button></li>';
                }).join('');
                content.innerHTML = groups.map(function (g, i) {
                    var boxes = g.assets.map(function (a) {
                        var id = 'a_' + g.cat.id + '_' + String(a.symbol).replace(/[^A-Za-z0-9]/g, '_');
                        return '<div class="col-md-3 col-6"><div class="form-check"><input class="form-check-input" type="checkbox" id="' + esc(id) + '" name="asset_selection[]" value="' + esc(g.cat.id) + ':' + esc(a.symbol) + '"' + (SELECTED.has(a.symbol) ? ' checked' : '') + '>'
                            + '<label class="form-check-label small" for="' + esc(id) + '">' + esc(a.symbol) + ' <span class="text-muted">' + esc(a.name || '') + '</span></label></div></div>';
                    }).join('') || '<div class="text-muted">No assets in this category</div>';
                    return '<div class="tab-pane fade' + (i === 0 ? ' show active' : '') + '" id="cat-' + esc(g.cat.id) + '"><div class="row g-1">' + boxes + '</div></div>';
                }).join('') || '<div class="text-muted">No categories for this market type</div>';
                countSelected();
            })
            .catch(function () { content.innerHTML = '<div class="text-danger">Failed to load assets</div>'; });
    }
    content.addEventListener('change', countSelected);
    market.addEventListener('change', loadCategories);
    loadCategories();
    <% } %>
})();
</script>
