<div class="card" style="max-width:700px;">
  <div class="card-header">
    <div class="card-title">Edit Session</div>
    <a href="/league_sessions/<%= session._id %>" class="btn btn-secondary btn-sm">← Back</a>
  </div>
  <form method="POST" action="/league_sessions/<%= session._id %>?_method=PUT">
    <div class="form-grid">
      <div class="form-group" style="grid-column:1/-1">
        <label class="form-label">Session Name</label>
        <input type="text" name="name" class="form-control" value="<%= session.name %>" required/>
      </div>
      <div class="form-group">
        <label class="form-label">Market Type</label>
        <select name="market_type" class="form-control">
          <option value="stock" <%= session.market_type === 'stock' ? 'selected' : '' %>>Stock</option>
          <option value="crypto" <%= session.market_type === 'crypto' ? 'selected' : '' %>>Crypto</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label">Max Stocks</label>
        <input type="number" name="max_stocks" class="form-control" value="<%= session.max_stocks || 5 %>"/>
      </div>
      <div class="form-group">
        <label class="form-label">Status</label>
        <select name="status" class="form-control">
          <option value="upcoming" <%= session.status === 'upcoming' ? 'selected' : '' %>>Upcoming</option>
          <option value="live" <%= session.status === 'live' ? 'selected' : '' %>>Live</option>
          <option value="completed" <%= session.status === 'completed' ? 'selected' : '' %>>Completed</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label">Start Time</label>
        <input type="datetime-local" name="start_time" class="form-control" value="<%= session.start_time ? new Date(session.start_time).toISOString().slice(0,16) : '' %>"/>
      </div>
      <div class="form-group">
        <label class="form-label">End Time</label>
        <input type="datetime-local" name="end_time" class="form-control" value="<%= session.end_time ? new Date(session.end_time).toISOString().slice(0,16) : '' %>"/>
      </div>
    </div>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Update</button>
      <a href="/league_sessions/<%= session._id %>" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</div>
