<%#
  Create Session.
  NEW IMPLEMENTATION — NODE.JS PROJECT (client feedback): one Market Type dropdown (Indian Stock /
  US Stock / Crypto) replaces "Stock Market + country"; the market's active categories are loaded
  dynamically and assets are assigned to each category for this session only
  (public/js/session-asset-picker.js). Minimums are checked here and again on the server.
%>
<%
  const pf = typeof prefill !== 'undefined' && prefill ? prefill : {};
  const errs = typeof errors !== 'undefined' && errors ? errors : [];
  const v = (key, fallback) => (pf[key] === undefined || pf[key] === null || pf[key] === '' ? (fallback === undefined ? '' : fallback) : pf[key]);
  const dt = (value) => String(value || '').replace(' ', 'T').slice(0, 16);
  const json = (value) => JSON.stringify(value === undefined ? null : value).replace(/</g, '\\u003c');
%>
<div class="container-fluid">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1"><i class="bi bi-plus-circle-fill text-primary me-2"></i>Create New Session</h1>
            <p class="text-muted mb-0">Set up a new trading league session with custom parameters</p>
        </div>
        <a href="/league_sessions" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back to Sessions
        </a>
    </div>

    <% if (errs.length) { %>
    <div class="alert alert-danger border-0 shadow-sm" id="server-errors">
        <strong><i class="bi bi-exclamation-triangle-fill me-2"></i>The session was not created:</strong>
        <ul class="mb-0 mt-2"><% errs.forEach(function (e) { %><li><%= e %></li><% }) %></ul>
    </div>
    <% } %>

    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-gradient-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-gear-fill me-2"></i>Session Configuration</h5>
                </div>
                <div class="card-body p-4">
                    <form id="sessionCreateForm" action="/league_sessions" method="POST" enctype="multipart/form-data" novalidate>
                        <!-- Template Section -->
                        <% if (templates && templates.length) { %>
                        <div class="row mb-4">
                            <div class="col-12">
                                <h6 class="text-primary mb-3"><i class="bi bi-bookmark me-2"></i>Load from Template</h6>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="template_select" class="form-label fw-semibold">Select Template</label>
                                    <select class="form-select form-select-lg" id="template_select" onchange="loadTemplate()">
                                        <option value="">Choose a template...</option>
                                        <% templates.forEach(function (template) { %>
                                        <option value="<%= template.old_id || template._id %>"><%= template.template_name %></option>
                                        <% }) %>
                                    </select>
                                    <div class="form-text" id="template-status"></div>
                                </div>
                            </div>
                        </div>
                        <% } %>

                        <!-- Basic Information Section -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h6 class="text-primary mb-3"><i class="bi bi-info-circle me-2"></i>Basic Information</h6>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="name" class="form-label fw-semibold">Session Name <span class="text-danger">*</span></label>
                                    <input type="text" name="name" id="name" class="form-control form-control-lg" placeholder="Enter session name" maxlength="255" value="<%= v('name') %>" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3" id="image-field">
                                    <label for="session_image" class="form-label fw-semibold">Session Image</label>
                                    <input type="file" name="session_image" id="session_image" class="form-control form-control-lg" accept="image/*">
                                    <div class="form-text">Upload an image for this session (optional)</div>
                                    <% if (pf.existing_image) { %>
                                    <div class="mt-2" id="existing-image-preview">
                                        <img src="/<%= pf.existing_image %>" alt="Session image" class="img-thumbnail" style="max-width: 200px;">
                                        <input type="hidden" name="existing_image" value="<%= pf.existing_image %>">
                                        <p class="text-muted small mt-1">Image kept from your previous attempt. Upload a new one to replace it.</p>
                                    </div>
                                    <% } %>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="market" class="form-label fw-semibold">Market Type <span class="text-danger">*</span></label>
                                    <select class="form-select form-select-lg" id="market" name="market" required>
                                        <option value="">Choose market type</option>
                                        <% Object.entries(marketOptions).forEach(function ([key, m]) { %>
                                        <option value="<%= key %>" <%= v('market') === key ? 'selected' : '' %>><%= m.label %></option>
                                        <% }) %>
                                    </select>
                                    <div class="form-text">Decides which market categories and assets are available.</div>
                                </div>
                            </div>
                        </div>

                        <!-- Market Categories & Assets -->
                        <div class="mb-4">
                            <h6 class="text-primary mb-3"><i class="bi bi-collection me-2"></i>Market Categories &amp; Assets <span class="text-danger">*</span></h6>
                            <div class="card border-0 bg-light">
                                <div class="card-body" id="asset-picker"></div>
                            </div>
                        </div>

                        <!-- Live Prices Section -->
                        <div id="live-prices-section" style="display:none;" class="mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="text-primary mb-0"><i class="bi bi-currency-exchange me-2"></i>Live Asset Prices</h6>
                                <div>
                                    <span id="price-update-time" class="badge bg-light text-dark me-2">Last Updated: --:--</span>
                                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="refreshSelectedAssetPrices()">
                                        <i class="bi bi-arrow-clockwise"></i> Load / Refresh
                                    </button>
                                </div>
                            </div>
                            <div class="card border-0 bg-light">
                                <div class="card-body">
                                    <div class="row" id="live-prices-container">
                                        <div class="col-12 text-center py-4"><div class="text-muted">Click Load to see live prices of the selected assets</div></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Portfolio Settings -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h6 class="text-primary mb-3"><i class="bi bi-briefcase me-2"></i>Portfolio Settings</h6>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="max_stocks" class="form-label fw-semibold">Max Assets in Portfolio <span class="text-danger">*</span></label>
                                    <input type="number" name="max_stocks" id="max_stocks" class="form-control form-control-lg" placeholder="e.g., 10" min="1" max="50" value="<%= v('max_stocks') %>" required>
                                    <div class="form-text">Maximum number of assets a user can hold in their portfolio</div>
                                </div>
                            </div>
                        </div>

                        <!-- Schedule Settings -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h6 class="text-primary mb-3"><i class="bi bi-calendar-event me-2"></i>Schedule Settings</h6>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label for="user_joining_start_time" class="form-label fw-semibold">Registration Opens</label>
                                    <input type="datetime-local" name="user_joining_start_time" id="user_joining_start_time" class="form-control form-control-lg" value="<%= dt(v('user_joining_start_time')) %>">
                                    <div class="form-text">When users can start joining this session</div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label for="start_time" class="form-label fw-semibold">Session Starts <span class="text-danger">*</span></label>
                                    <input type="datetime-local" name="start_time" id="start_time" class="form-control form-control-lg" value="<%= dt(v('start_time')) %>" required onchange="validateDateTime()">
                                    <div class="form-text">Trading session start time</div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label for="end_time" class="form-label fw-semibold">Session Ends <span class="text-danger">*</span></label>
                                    <input type="datetime-local" name="end_time" id="end_time" class="form-control form-control-lg" value="<%= dt(v('end_time')) %>" required onchange="validateDateTime()">
                                    <div id="datetime-error" class="text-danger mt-2" style="display:none;"><i class="bi bi-exclamation-triangle me-1"></i>End date must be after start date</div>
                                </div>
                            </div>
                        </div>

                        <!-- Status & Activation -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h6 class="text-primary mb-3"><i class="bi bi-toggles me-2"></i>Status & Activation</h6>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="status" class="form-label fw-semibold">Session Status <span class="text-danger">*</span></label>
                                    <select name="status" id="status" class="form-select form-select-lg">
                                        <option value="draft" <%= v('status', 'draft') === 'draft' ? 'selected' : '' %>>📝 Draft</option>
                                        <option value="upcoming" <%= v('status') === 'upcoming' ? 'selected' : '' %>>⏰ Upcoming</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="active" class="form-label fw-semibold">Activation Status</label>
                                    <select name="active" id="active" class="form-select form-select-lg">
                                        <option value="1" <%= v('active', '1') !== '0' ? 'selected' : '' %>>🟢 Active</option>
                                        <option value="0" <%= v('active') === '0' ? 'selected' : '' %>>🔴 Inactive</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- Save as Template Section -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h6 class="text-primary mb-3"><i class="bi bi-bookmark-plus me-2"></i>Save as Template</h6>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check mb-3">
                                    <input class="form-check-input" type="checkbox" id="save_as_template" name="save_as_template" onchange="toggleTemplateField()" <%= pf.save_as_template ? 'checked' : '' %>>
                                    <label class="form-check-label fw-semibold" for="save_as_template">
                                        Save this session as a template
                                    </label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <input type="text" name="template_name" id="template_name" class="form-control form-control-lg" placeholder="Enter template name" aria-label="Template name" value="<%= v('template_name') %>" <%= pf.save_as_template ? 'required' : 'disabled' %>>
                                    <div class="form-text">This template can be reused for future sessions</div>
                                </div>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div id="form-errors" class="alert alert-danger" style="display:none;"></div>
                        <div class="d-flex gap-3 justify-content-end">
                            <a href="/league_sessions" class="btn btn-outline-secondary btn-lg px-4">
                                <i class="bi bi-x-circle me-2"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg px-4">
                                <i class="bi bi-check-circle me-2"></i>Create Session
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.bg-gradient-primary,
.card-header.bg-gradient-primary {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: #fff;
}
.card { border-radius: 15px; }
.form-control, .form-select { border-radius: 10px; border: 2px solid #e9ecef; transition: all 0.3s ease; }
.form-control:focus, .form-select:focus { border-color: #667eea; box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25); }
.btn { border-radius: 10px; font-weight: 500; transition: all 0.3s ease; }
.btn-primary { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border: none; }
.btn-primary:hover { transform: translateY(-2px); box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4); }
.text-primary { color: #667eea !important; }
.form-check-input:checked { background-color: #667eea; border-color: #667eea; }
</style>

<script src="/js/session-asset-picker.js"></script>
<script>
    var PREFILL = <%- json(pf.market ? { market: pf.market, selection: pf.selection || {}, categoryIds: pf.categoryIds || [] } : null) %>;
    var picker = SessionAssetPicker({
        root: document.getElementById('asset-picker'),
        marketSelect: document.getElementById('market'),
        market: PREFILL ? PREFILL.market : document.getElementById('market').value,
        selection: PREFILL ? PREFILL.selection : {},
        categoryIds: PREFILL ? PREFILL.categoryIds : [],
        onChange: function (p) {
            document.getElementById('live-prices-section').style.display = p.selectedSymbols().length ? 'block' : 'none';
        },
    });

    document.getElementById('sessionCreateForm').addEventListener('submit', function (e) {
        var problems = [];
        if (!document.getElementById('name').value.trim()) problems.push('Enter a session name.');
        if (!document.getElementById('market').value) problems.push('Choose a market type.');
        if (!document.getElementById('max_stocks').value) problems.push('Enter the max assets in portfolio.');
        if (!document.getElementById('start_time').value || !document.getElementById('end_time').value) problems.push('Enter the session start and end time.');
        else if (!validateDateTime()) problems.push('The end time must be after the start time.');
        var tpl = document.getElementById('save_as_template');
        if (tpl.checked && !document.getElementById('template_name').value.trim()) problems.push('Enter a template name.');
        if (document.getElementById('market').value) problems = problems.concat(picker.validate());
        var box = document.getElementById('form-errors');
        if (problems.length) {
            e.preventDefault();
            box.innerHTML = '<ul class="mb-0 ps-3">' + problems.map(function (p) { return '<li>' + String(p).replace(/[&<>]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]; }) + '</li>'; }).join('') + '</ul>';
            box.style.display = 'block';
            picker.showErrors();
        } else {
            box.style.display = 'none';
        }
    });

    function validateDateTime() {
        var startTime = document.getElementById('start_time').value;
        var endTime = document.getElementById('end_time').value;
        var errorDiv = document.getElementById('datetime-error');
        if (startTime && endTime && new Date(endTime) <= new Date(startTime)) {
            errorDiv.style.display = 'block';
            return false;
        }
        errorDiv.style.display = 'none';
        return true;
    }

    function toggleTemplateField() {
        var checkbox = document.getElementById('save_as_template');
        var templateName = document.getElementById('template_name');
        templateName.disabled = !checkbox.checked;
        templateName.required = checkbox.checked;
        if (!checkbox.checked) templateName.value = '';
    }

    function loadTemplate() {
        var select = document.getElementById('template_select');
        var status = document.getElementById('template-status');
        if (!select.value) return;
        status.textContent = 'Loading template…';
        fetch('/league_sessions/template/' + encodeURIComponent(select.value), { headers: { Accept: 'application/json' } })
            .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
            .then(function (template) {
                document.getElementById('name').value = template.name || '';
                document.getElementById('max_stocks').value = template.max_stocks || '';
                if (template.user_joining_start_time) document.getElementById('user_joining_start_time').value = template.user_joining_start_time.replace(' ', 'T').substring(0, 16);
                if (template.start_time) document.getElementById('start_time').value = template.start_time.replace(' ', 'T').substring(0, 16);
                if (template.end_time) document.getElementById('end_time').value = template.end_time.replace(' ', 'T').substring(0, 16);
                if (template.status) document.getElementById('status').value = template.status;
                if (template.active !== undefined) document.getElementById('active').value = template.active ? '1' : '0';
                var old = document.getElementById('existing-image-preview');
                if (old) old.remove();
                if (template.image_url) {
                    document.getElementById('image-field').insertAdjacentHTML('beforeend',
                        '<div class="mt-2" id="existing-image-preview"><img src="/' + template.image_url + '" alt="Template image" class="img-thumbnail" style="max-width: 200px;">'
                        + '<input type="hidden" name="existing_image" value="' + template.image_url + '">'
                        + '<p class="text-muted small mt-1">Template image loaded. Upload a new image to replace it.</p></div>');
                }
                var selection = template.selection || {};
                picker.set(template.market, selection, Object.keys(selection));
                status.textContent = 'Template loaded — check the categories and minimums below.';
            })
            .catch(function (err) { status.textContent = 'Could not load the template (' + err.message + ').'; });
    }

    document.addEventListener('DOMContentLoaded', function () {
        var templateId = new URLSearchParams(window.location.search).get('template');
        var select = document.getElementById('template_select');
        if (templateId && select && !PREFILL) { select.value = templateId; loadTemplate(); }
        var serverErrors = document.getElementById('server-errors');
        if (serverErrors) serverErrors.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    // Live prices of the selected assets (on demand, so price API credits aren't spent on every tick)
    function refreshSelectedAssetPrices() {
        var symbols = picker.selectedSymbols();
        var market = picker.market();
        var container = document.getElementById('live-prices-container');
        if (!symbols.length) {
            container.innerHTML = '<div class="col-12 text-center py-4"><div class="text-muted">Select assets to see live prices</div></div>';
            return;
        }
        container.innerHTML = '<div class="col-12 text-center py-4"><div class="spinner-border text-primary" role="status"></div><p class="mt-2 text-muted">Loading live prices...</p></div>';
        var request = market === 'crypto'
            ? fetch('/api/v1/crypto-live-price').then(function (r) { return r.json(); }).then(function (data) {
                var wanted = symbols.map(function (s) { return s.replace(/-USD$/i, ''); });
                return data.success && data.data ? data.data.filter(function (c) { return wanted.indexOf(c.symbol) >= 0; }) : [];
            })
            : Promise.all(symbols.map(function (symbol) {
                return fetch('/api/v1/stock-live-price?symbol=' + encodeURIComponent(symbol) + '&market=' + (market === 'us_stock' ? 'us' : 'indian'))
                    .then(function (r) { return r.json(); }).then(function (d) { return d.success ? d : null; }).catch(function () { return null; });
            })).then(function (rows) { return rows.filter(Boolean); });
        request.then(function (rows) {
            if (!rows.length) {
                container.innerHTML = '<div class="col-12 text-center py-4"><div class="text-muted">No price data available</div></div>';
                return;
            }
            var currency = market === 'indian_stock' ? '₹' : '$';
            container.innerHTML = rows.map(function (price) {
                var ok = price.price && price.price > 0;
                var pct = Number(price.change_percent || 0);
                return '<div class="col-md-4 col-lg-3 mb-3"><div class="card border-0 shadow-sm h-100"><div class="card-body p-3 text-center">'
                    + '<h6 class="fw-bold mb-1">' + price.symbol + '</h6><small class="text-muted d-block mb-2">' + (price.name || price.symbol) + '</small>'
                    + '<div class="h5 mb-2">' + (ok ? currency + Number(price.price).toFixed(2) : '<span class="text-muted">N/A</span>') + '</div>'
                    + '<div class="' + (ok ? (pct >= 0 ? 'text-success' : 'text-danger') : 'text-muted') + ' fw-bold">' + (ok ? (pct >= 0 ? '↗ +' : '↘ ') + pct.toFixed(2) + '%' : 'Not Available') + '</div>'
                    + '</div></div></div>';
            }).join('');
            document.getElementById('price-update-time').textContent = 'Last Updated: ' + new Date().toLocaleTimeString();
        }).catch(function () {
            container.innerHTML = '<div class="col-12 text-center py-4"><div class="alert alert-danger">Error loading live prices</div></div>';
        });
    }
</script>
