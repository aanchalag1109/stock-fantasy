<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>👤 <%= user.name %> - Contest History</h2>
        <a href="/contest-analysis/users" class="btn btn-secondary">← Back to Users</a>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <div class="row">
                <div class="col-md-3">
                    <h6 class="text-muted">Mobile</h6>
                    <p class="mb-0"><strong><%= user.mobile || '' %></strong></p>
                </div>
                <div class="col-md-3">
                    <h6 class="text-muted">Email</h6>
                    <p class="mb-0"><%= user.email || '' %></p>
                </div>
                <div class="col-md-3">
                    <h6 class="text-muted">Deposit Balance</h6>
                    <p class="mb-0"><strong>₹<%= money2(user.deposit_balance) %></strong></p>
                </div>
                <div class="col-md-3">
                    <h6 class="text-muted">Winnings Balance</h6>
                    <p class="mb-0"><strong class="text-success">₹<%= money2(user.winnings_balance) %></strong></p>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white">
                <div class="card-body text-center">
                    <h6>Total Contests</h6>
                    <h3><%= stats.total_contests %></h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body text-center">
                    <h6>Total Winnings</h6>
                    <h3>₹<%= money2(stats.total_winnings) %></h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-white">
                <div class="card-body text-center">
                    <h6>Total Spent</h6>
                    <h3>₹<%= money2(stats.total_spent) %></h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card <%= stats.net_profit >= 0 ? 'bg-info' : 'bg-danger' %> text-white">
                <div class="card-body text-center">
                    <h6>Net Profit/Loss</h6>
                    <h3>₹<%= money2(stats.net_profit) %></h3>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header bg-primary text-white">
            <h5>Contest History</h5>
        </div>
        <div class="card-body">
            <form method="GET" class="mb-3">
                <div class="row g-2">
                    <div class="col-md-4">
                        <input type="date" name="from_date" class="form-control" value="<%= from_date || '' %>">
                    </div>
                    <div class="col-md-4">
                        <input type="date" name="to_date" class="form-control" value="<%= to_date || '' %>">
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-primary">Filter</button>
                        <a href="/contest-analysis/user/<%= user.old_id || user._id %>" class="btn btn-secondary">Clear</a>
                    </div>
                </div>
            </form>
            <% if (!contestsData.length) { %>
                <div class="alert alert-info">No contests played yet</div>
            <% } else { %>
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Contest ID</th>
                                <th>Session</th>
                                <th>Category</th>
                                <th>Entry Fee</th>
                                <th>Rank</th>
                                <th>Score</th>
                                <th>Winning</th>
                                <th>Date</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% contestsData.forEach(contest => { %>
                            <tr class="<%= Number(contest.winning) > 0 ? 'table-success' : '' %>">
                                <td><strong>#<%= contest.contest_id %></strong></td>
                                <td><%= contest.session_name %></td>
                                <td><span class="badge bg-info"><%= contest.category %></span></td>
                                <td>₹<%= contest.entry_fee %></td>
                                <td>
                                    <% if (contest.rank == 1) { %>🥇 1
                                    <% } else if (contest.rank == 2) { %>🥈 2
                                    <% } else if (contest.rank == 3) { %>🥉 3
                                    <% } else { %><%= contest.rank == null ? '' : contest.rank %><% } %>
                                </td>
                                <td><%= money2(contest.score) %></td>
                                <td>
                                    <% if (Number(contest.winning) > 0) { %>
                                        <strong class="text-success">₹<%= money2(contest.winning) %></strong>
                                    <% } else { %>
                                        <span class="text-muted">-</span>
                                    <% } %>
                                </td>
                                <td><%= formatIst(contest.created_at, 'date') %></td>
                                <td>
                                    <a href="/contest-analysis/contest/<%= contest.contest_id %>" class="btn btn-sm btn-primary">View Contest</a>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>
    </div>
</div>
