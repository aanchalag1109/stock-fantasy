<%#
  NEW IMPLEMENTATION — NODE.JS PROJECT

  Feature: Admin User Access Control
  Purpose: Manage admin users, roles, and feature-level permissions
  Origin: Newly implemented in node-project; not directly converted
           from the original PHP implementation.

  Important: Keep this implementation distinguishable from the
  original PHP project when comparing functionality in the future.
%>
<div class="container-fluid">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1"><i class="bi bi-shield-lock text-primary me-2"></i>Roles &amp; Permissions</h1>
            <p class="text-muted mb-0">A role is a set of module permissions. Changes apply to every admin with that role immediately.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/admin-users" class="btn btn-outline-primary"><i class="bi bi-person-badge me-1"></i>Admin Users</a>
            <a href="/admin-roles/create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Create Role</a>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Role</th>
                        <th>Permissions</th>
                        <th>Admins</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (!roles.length) { %>
                    <tr><td colspan="4" class="text-center text-muted py-4">No roles yet. Create one to give admins limited access.</td></tr>
                    <% } %>
                    <% roles.forEach(r => { const assigned = adminCounts[String(r._id)] || 0; %>
                    <tr>
                        <td>
                            <div class="fw-semibold"><%= r.name %></div>
                            <% if (r.description) { %><div class="small text-muted"><%= r.description %></div><% } %>
                        </td>
                        <td><span class="badge bg-light text-dark border"><%= (r.permissions || []).length %> permission(s)</span></td>
                        <td><%= assigned %></td>
                        <td class="text-end text-nowrap">
                            <a href="/admin-roles/<%= r._id %>/edit" class="btn btn-sm btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                            <form action="/admin-roles/<%= r._id %>?_method=DELETE" method="POST" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="<%= assigned ? 'Reassign its admins before deleting' : 'Delete' %>"
                                        <%= assigned ? 'disabled' : '' %> data-confirm="Delete role <%= r.name %>?">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>
