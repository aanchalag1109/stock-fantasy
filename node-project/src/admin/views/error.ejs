<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <title>Error | ProbTrade Admin</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet"/>
  <style>
    body { font-family: 'Inter',sans-serif; background:#0f1117; color:#e2e8f0; min-height:100vh; display:flex; align-items:center; justify-content:center; text-align:center; }
    .err-box { max-width:400px; }
    .err-code { font-size:72px; font-weight:700; color:#6c63ff; }
    .err-title { font-size:20px; font-weight:600; margin-bottom:8px; }
    .err-msg { color:#8892a4; font-size:14px; margin-bottom:24px; }
    a { color:#6c63ff; text-decoration:none; background:rgba(108,99,255,0.1); border:1px solid rgba(108,99,255,0.3); padding:8px 20px; border-radius:8px; font-size:14px; }
  </style>
</head>
<body>
  <div class="err-box">
    <div class="err-code">!</div>
    <div class="err-title"><%= typeof title !== 'undefined' ? title : 'Error' %></div>
    <div class="err-msg"><%= typeof message !== 'undefined' ? message : 'An unexpected error occurred.' %></div>
    <a href="/dashboard">← Go to Dashboard</a>
  </div>
</body>
</html>
