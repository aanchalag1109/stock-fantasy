<%#
  NEW IMPLEMENTATION — NODE.JS PROJECT

  Feature: Admin User Access Control
  Purpose: Manage admin users, roles, and feature-level permissions
  Origin: Newly implemented in node-project; not directly converted
           from the original PHP implementation.

  Important: Keep this implementation distinguishable from the
  original PHP project when comparing functionality in the future.
%>
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 text-center">
                <div class="card-body p-5">
                    <i class="bi bi-shield-lock text-danger" style="font-size: 3.5rem;"></i>
                    <h1 class="h4 mt-3">Access Denied</h1>
                    <p class="text-muted mb-4"><%= message %></p>
                    <% if (landing === '/profile') { %>
                    <p class="small text-muted">No modules are assigned to your account yet. Ask a super admin to assign you a role.</p>
                    <% } %>
                    <a href="<%= landing %>" class="btn btn-primary"><i class="bi bi-arrow-left me-1"></i> Go to my home page</a>
                </div>
            </div>
        </div>
    </div>
</div>
