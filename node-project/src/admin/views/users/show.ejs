<%
  function money(n) {
    return Number(n || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }
  function day(date) {
    if (!date) return '';
    const parts = new Intl.DateTimeFormat('en-US', {
      timeZone: 'Asia/Kolkata', month: 'short', day: '2-digit', year: 'numeric',
    }).formatToParts(new Date(date));
    const get = (kind) => (parts.find((part) => part.type === kind) || {}).value || '';
    return get('month') + ' ' + get('day') + ', ' + get('year');
  }
%>
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1"><i class="bi bi-person-circle text-info me-2"></i>User Profile</h1>
            <p class="text-muted mb-0">Detailed information about <%= user.name %></p>
        </div>
        <div class="d-flex gap-2">
            <a href="/users/<%= user._id %>/edit" class="btn btn-warning">
                <i class="bi bi-pencil me-1"></i>Edit User
            </a>
            <a href="/users" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Back to Users
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header text-white text-center" style="background: linear-gradient(135deg, #17a2b8 0%, #138496 100%);">
                    <div class="py-3">
                        <div class="bg-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                            <i class="bi bi-<%= user.is_admin ? 'shield-fill text-warning' : 'person-fill text-info' %>" style="font-size: 2.5rem;"></i>
                        </div>
                        <h5 class="mb-1"><%= user.name %></h5>
                        <p class="mb-0 opacity-75"><%= user.email || '' %></p>
                        <% if (user.is_admin) { %><span class="badge bg-warning text-dark mt-2">Administrator</span><% } %>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-6">
                            <div class="border-end">
                                <div class="h4 text-success mb-0">₹<%= money(user.deposit_balance) %></div>
                                <small class="text-muted">Wallet Balance</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="h4 text-info mb-0">₹<%= money(user.winnings_balance) %></div>
                            <small class="text-muted">Total Winnings</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-light">
                    <h6 class="mb-0"><i class="bi bi-graph-up text-primary me-2"></i>Quick Stats</h6>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-muted">User ID</span>
                        <span class="fw-bold">#<%= user.old_id || user._id %></span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-muted">Member Since</span>
                        <span class="fw-bold"><%= day(user.created_at) %></span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted">Last Active</span>
                        <span class="fw-bold"><%= day(user.updated_at) %></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header text-white" style="background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);">
                    <h5 class="mb-0"><i class="bi bi-person-gear me-2"></i>Account Information</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-semibold text-muted">Full Name</label>
                                <div class="form-control-plaintext fw-bold"><%= user.name %></div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold text-muted">Email Address</label>
                                <div class="form-control-plaintext"><%= user.email || '' %></div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold text-muted">Phone Number</label>
                                <div class="form-control-plaintext"><%= user.mobile || 'Not provided' %></div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-semibold text-muted">Date of Birth</label>
                                <div class="form-control-plaintext">Not provided</div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold text-muted">Gender</label>
                                <div class="form-control-plaintext">Not specified</div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold text-muted">Address</label>
                                <div class="form-control-plaintext">Not provided</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header text-white" style="background: linear-gradient(135deg, #28a745 0%, #20c997 100%);">
                    <h5 class="mb-0"><i class="bi bi-wallet2 me-2"></i>Financial Information</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="text-center p-3 bg-light rounded">
                                <div class="h4 text-success mb-1">₹<%= money(user.deposit_balance) %></div>
                                <small class="text-muted">Current Balance</small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="text-center p-3 bg-light rounded">
                                <div class="h4 text-info mb-1">₹<%= money(user.winnings_balance) %></div>
                                <small class="text-muted">Total Winnings</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<style>
.card { border-radius: 15px; }
.btn { border-radius: 8px; font-weight: 500; }
</style>
