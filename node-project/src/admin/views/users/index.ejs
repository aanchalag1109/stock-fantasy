<%
  function money(n) {
    return Number(n || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }
  function stamp(d) {
    if (!d) return { date: 'N/A', time: '' };
    const parts = new Intl.DateTimeFormat('en-US', {
      timeZone: 'Asia/Kolkata',
      month: 'short', day: 'numeric', year: 'numeric',
      hour: '2-digit', minute: '2-digit', hourCycle: 'h23',
    }).formatToParts(new Date(d));
    const get = (kind) => (parts.find((part) => part.type === kind) || {}).value || '';
    return { date: get('month') + ' ' + get('day') + ', ' + get('year'), time: get('hour') + ':' + get('minute') };
  }
  const pageSize = 20;
  const fromItem = total ? ((page - 1) * pageSize) + 1 : 0;
  const toItem = Math.min(page * pageSize, total);
  const adminOnPage = users.filter(u => u.is_admin).length;
  const q = (search ? 'search=' + encodeURIComponent(search) + '&' : '') + (is_admin !== undefined && is_admin !== '' ? 'is_admin=' + encodeURIComponent(is_admin) : '');
%>
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1"><i class="bi bi-people-fill text-primary me-2"></i>User Management</h1>
            <p class="text-muted mb-0">Manage all registered users and their permissions</p>
        </div>
        <div>
            <a href="/users/create" class="btn btn-primary btn-lg">
                <i class="bi bi-person-plus me-2"></i>Add New User
            </a>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="bg-primary bg-opacity-10 rounded-circle p-3">
                                <i class="bi bi-people text-primary" style="font-size: 1.5rem;"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <div class="small text-muted">Total Users</div>
                            <div class="h4 mb-0"><%= total %></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="bg-info bg-opacity-10 rounded-circle p-3">
                                <i class="bi bi-shield-check text-info" style="font-size: 1.5rem;"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <div class="small text-muted">Admin Users</div>
                            <div class="h4 mb-0"><%= adminOnPage %></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header text-white" style="background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);">
            <h6 class="mb-0 text-white"><i class="bi bi-funnel me-2"></i>Search & Filter</h6>
        </div>
        <div class="card-body">
            <form action="/users" method="GET" class="row g-3" id="userFilterForm">
                <div class="col-md-4">
                    <label for="search" class="form-label fw-semibold">Search Users</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" class="form-control border-start-0" id="search" name="search"
                               placeholder="Search by name or email..." value="<%= search || '' %>">
                    </div>
                </div>
                <div class="col-md-3">
                    <label for="is_admin" class="form-label fw-semibold">User Type</label>
                    <select class="form-select" id="is_admin" name="is_admin">
                        <option value="">All Users</option>
                        <option value="1" <%= String(is_admin) === '1' ? 'selected' : '' %>>🛡️ Admin Users</option>
                        <option value="0" <%= String(is_admin) === '0' ? 'selected' : '' %>>👤 Regular Users</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search me-1"></i>Search
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header text-white d-flex justify-content-between align-items-center" style="background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);">
            <h5 class="mb-0 text-white"><i class="bi bi-people me-2"></i>All Users</h5>
            <div class="d-flex align-items-center">
                <button type="button" class="btn btn-danger btn-sm me-2" id="bulkDeleteBtn" style="display: none;">
                    <i class="bi bi-trash me-1"></i>Delete Selected (<span id="selectedCount">0</span>)
                </button>
                <button type="button" class="btn btn-outline-light btn-sm" id="selectAllBtn">
                    <i class="bi bi-check-square me-1"></i>Select All
                </button>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="fw-semibold"><input type="checkbox" class="form-check-input" id="selectAll"></th>
                        <th class="fw-semibold">#</th>
                        <th class="fw-semibold"><i class="bi bi-person me-1"></i>User Details</th>
                        <th class="fw-semibold"><i class="bi bi-wallet2 me-1"></i>Wallet</th>
                        <th class="fw-semibold"><i class="bi bi-trophy me-1"></i>Winnings</th>
                        <th class="fw-semibold"><i class="bi bi-calendar me-1"></i>Joined</th>
                        <th class="fw-semibold text-center"><i class="bi bi-gear me-1"></i>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% users.forEach(user => { const j = stamp(user.created_at); %>
                    <tr>
                        <td><input type="checkbox" class="form-check-input user-checkbox" value="<%= user._id %>"></td>
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="bg-<%= user.is_admin ? 'warning' : 'primary' %> rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                    <i class="bi bi-<%= user.is_admin ? 'shield-fill' : 'person-fill' %> text-white"></i>
                                </div>
                                <span class="ms-2 fw-semibold"><%= user.old_id || user._id %></span>
                            </div>
                        </td>
                        <td>
                            <div>
                                <div class="fw-semibold text-dark"><%= user.name || '—' %></div>
                                <div class="small text-muted"><%= user.email || '' %></div>
                                <% if (user.mobile) { %>
                                    <div class="small text-info"><i class="bi bi-telephone me-1"></i><%= user.mobile %></div>
                                <% } %>
                                <% if (user.is_admin) { %>
                                    <span class="badge bg-warning text-dark small">Admin</span>
                                <% } %>
                            </div>
                        </td>
                        <td>
                            <div class="fw-bold text-success"><%= money(user.deposit_balance) %> probcoins</div>
                            <div class="small text-muted">Deposit Balance</div>
                        </td>
                        <td>
                            <div class="fw-bold text-info"><%= money(user.winnings_balance) %> probcoins</div>
                            <div class="small text-muted">Winnings Balance</div>
                        </td>
                        <td>
                            <div class="small">
                                <div class="fw-semibold"><%= j.date %></div>
                                <div class="text-muted"><%= j.time %></div>
                            </div>
                        </td>
                        <td class="text-center">
                            <div class="btn-group btn-group-sm">
                                <a href="/users/<%= user._id %>" class="btn btn-outline-info" title="View User"><i class="bi bi-eye"></i></a>
                                <a href="/users/<%= user._id %>/edit" class="btn btn-outline-primary" title="Edit User"><i class="bi bi-pencil"></i></a>
                            </div>
                        </td>
                    </tr>
                    <% }) %>
                    <% if (!users.length) { %>
                    <tr>
                        <td colspan="7" class="text-center py-5">
                            <div class="text-muted">
                                <i class="bi bi-people display-1 d-block mb-3"></i>
                                <h5>No users found</h5>
                                <p>Try adjusting your search criteria or add a new user.</p>
                                <a href="/users/create" class="btn btn-primary"><i class="bi bi-person-plus me-1"></i>Add New User</a>
                            </div>
                        </td>
                    </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
        <% if (pages > 0) { %>
        <div class="card-footer bg-light py-3">
            <div class="d-flex justify-content-between align-items-center">
                <div class="text-muted small">Showing <%= fromItem %> to <%= toItem %> of <%= total %> users</div>
                <nav><%- include('../partials/pagination', { pages, page, extraQuery: q }) %></nav>
            </div>
        </div>
        <% } %>
    </div>
</div>

<form id="bulkDeleteForm" method="POST" action="/users/bulk-delete" style="display: none;">
    <input type="hidden" name="user_ids" id="bulkDeleteIds">
</form>

<div class="modal fade" id="bulkDeleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Bulk Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete <strong><span id="deleteCount">0</span></strong> selected user(s)?</p>
                <p class="text-danger"><i class="bi bi-exclamation-triangle me-1"></i>This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmBulkDelete"><i class="bi bi-trash me-1"></i>Delete Users</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="walletModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="walletModalTitle">Manage Wallet</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="walletForm" method="POST">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">User</label>
                        <div class="form-control-plaintext" id="walletUserName"></div>
                    </div>
                    <div class="mb-3">
                        <label for="amount" class="form-label fw-semibold">Amount (Probcoins)</label>
                        <input type="number" class="form-control" id="amount" name="amount" min="0.01" step="0.01" required>
                    </div>
                    <div class="mb-3">
                        <label for="reason" class="form-label fw-semibold">Reason</label>
                        <textarea class="form-control" id="reason" name="reason" rows="3" placeholder="Enter reason for this transaction..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn" id="walletSubmitBtn">Update Wallet</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function openWalletModal(userId, userName, action) {
    const form = document.getElementById('walletForm');
    const title = document.getElementById('walletModalTitle');
    const submitBtn = document.getElementById('walletSubmitBtn');
    if (action === 'add') {
        title.textContent = 'Add Probcoins';
        form.action = '/users/' + userId + '/wallet/add';
        submitBtn.textContent = 'Add Probcoins';
        submitBtn.className = 'btn btn-success';
    } else {
        title.textContent = 'Remove Probcoins';
        form.action = '/users/' + userId + '/wallet/remove';
        submitBtn.textContent = 'Remove Probcoins';
        submitBtn.className = 'btn btn-danger';
    }
    document.getElementById('walletUserName').textContent = userName;
    document.getElementById('amount').value = '';
    document.getElementById('reason').value = '';
    new bootstrap.Modal(document.getElementById('walletModal')).show();
}
document.addEventListener('DOMContentLoaded', function() {
    const filterForm = document.getElementById('userFilterForm');
    if (filterForm) {
        filterForm.querySelectorAll('select').forEach(select => {
            select.addEventListener('change', function() { filterForm.submit(); });
        });
    }
    if (!document.querySelector('.user-checkbox')) return;
    const selectAllCheckbox = document.getElementById('selectAll');
    const selectAllBtn = document.getElementById('selectAllBtn');
    const userCheckboxes = document.querySelectorAll('.user-checkbox');
    const bulkDeleteBtn = document.getElementById('bulkDeleteBtn');
    const selectedCountSpan = document.getElementById('selectedCount');
    const bulkDeleteModal = new bootstrap.Modal(document.getElementById('bulkDeleteModal'));
    const deleteCountSpan = document.getElementById('deleteCount');
    function updateBulkControls() {
        const count = document.querySelectorAll('.user-checkbox:checked').length;
        if (selectedCountSpan) selectedCountSpan.textContent = count;
        if (bulkDeleteBtn) bulkDeleteBtn.style.display = count > 0 ? 'inline-block' : 'none';
        if (selectAllCheckbox) {
            selectAllCheckbox.indeterminate = count > 0 && count < userCheckboxes.length;
            selectAllCheckbox.checked = count === userCheckboxes.length && count > 0;
        }
    }
    if (selectAllCheckbox) {
        selectAllCheckbox.addEventListener('change', function() {
            userCheckboxes.forEach(checkbox => {
                checkbox.checked = this.checked;
                checkbox.closest('tr').classList.toggle('selected', this.checked);
            });
            updateBulkControls();
        });
    }
    if (selectAllBtn) {
        selectAllBtn.addEventListener('click', function() {
            const shouldCheck = !Array.from(userCheckboxes).every(cb => cb.checked);
            userCheckboxes.forEach(checkbox => {
                checkbox.checked = shouldCheck;
                checkbox.closest('tr').classList.toggle('selected', shouldCheck);
            });
            updateBulkControls();
        });
    }
    userCheckboxes.forEach(checkbox => {
        checkbox.addEventListener('change', function() {
            this.closest('tr').classList.toggle('selected', this.checked);
            updateBulkControls();
        });
    });
    if (bulkDeleteBtn) {
        bulkDeleteBtn.addEventListener('click', function() {
            const count = document.querySelectorAll('.user-checkbox:checked').length;
            if (count > 0) { deleteCountSpan.textContent = count; bulkDeleteModal.show(); }
        });
    }
    document.getElementById('confirmBulkDelete').addEventListener('click', function() {
        const userIds = Array.from(document.querySelectorAll('.user-checkbox:checked')).map(cb => cb.value);
        document.getElementById('bulkDeleteIds').value = JSON.stringify(userIds);
        document.getElementById('bulkDeleteForm').submit();
    });
    updateBulkControls();
});
</script>
