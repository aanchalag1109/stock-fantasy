<%
  function money(n) {
    return Number(n || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }
  const totalWallet = money((Number(user.deposit_balance) || 0) + (Number(user.winnings_balance) || 0));
%>
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1"><i class="bi bi-pencil-square text-warning me-2"></i>Edit User</h1>
            <p class="text-muted mb-0">Modify user information and settings</p>
        </div>
        <a href="/users" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back to Users
        </a>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header text-white" style="background: linear-gradient(135deg, #ffc107 0%, #ff8c00 100%);">
                    <h5 class="mb-0"><i class="bi bi-gear-fill me-2"></i>User Information</h5>
                </div>
                <div class="card-body p-4">
                    <form method="POST" action="/users/<%= user._id %>?_method=PUT">
                        <div class="row mb-4">
                            <div class="col-12">
                                <h6 class="text-warning mb-3"><i class="bi bi-info-circle me-2"></i>Basic Information</h6>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="name" class="form-label fw-semibold">Full Name <span class="text-danger">*</span></label>
                                    <input type="text" id="name" name="name" class="form-control form-control-lg" value="<%= user.name || '' %>" placeholder="Enter full name" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="email" class="form-label fw-semibold">Email Address <span class="text-danger">*</span></label>
                                    <input type="email" id="email" name="email" class="form-control form-control-lg" value="<%= user.email || '' %>" placeholder="Enter email address" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="mobile" class="form-label fw-semibold">Mobile Number</label>
                                    <input type="text" id="mobile" name="mobile" class="form-control form-control-lg" value="<%= user.mobile || '' %>" placeholder="Enter mobile number">
                                </div>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-12">
                                <h6 class="text-warning mb-3"><i class="bi bi-shield-lock me-2"></i>Security Settings</h6>
                            </div>
                            <div class="col-md-12">
                                <div class="mb-3">
                                    <label for="password" class="form-label fw-semibold">New Password</label>
                                    <div class="input-group">
                                        <input type="password" id="password" name="password" class="form-control form-control-lg" placeholder="Leave blank to keep current">
                                        <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('password')">
                                            <i class="bi bi-eye" id="password-icon"></i>
                                        </button>
                                    </div>
                                    <div class="form-text">Leave empty to keep current password</div>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-12">
                                <h6 class="text-warning mb-3"><i class="bi bi-wallet2 me-2"></i>Financial Information</h6>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label for="deposit_balance" class="form-label fw-semibold">Deposit Balance</label>
                                    <div class="input-group">
                                        <span class="input-group-text">₹</span>
                                        <input type="number" step="0.01" id="deposit_balance" name="deposit_balance" class="form-control form-control-lg" value="<%= user.deposit_balance || 0 %>" min="0">
                                    </div>
                                    <div class="form-text">Deposit balance</div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label for="winnings_balance" class="form-label fw-semibold">Winnings Balance</label>
                                    <div class="input-group">
                                        <span class="input-group-text">₹</span>
                                        <input type="number" step="0.01" id="winnings_balance" name="winnings_balance" class="form-control form-control-lg" value="<%= user.winnings_balance || 0 %>" min="0">
                                    </div>
                                    <div class="form-text">Winnings balance</div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Total Wallet</label>
                                    <div class="input-group">
                                        <span class="input-group-text">₹</span>
                                        <input type="text" class="form-control form-control-lg" value="<%= totalWallet %>" readonly>
                                    </div>
                                    <div class="form-text">Total (read-only)</div>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-12">
                                <h6 class="text-warning mb-3"><i class="bi bi-shield-check me-2"></i>Permissions</h6>
                            </div>
                            <div class="col-12">
                                <div class="card bg-light border-0">
                                    <div class="card-body">
                                        <div class="form-check form-switch">
                                            <input type="checkbox" id="is_admin" name="is_admin" value="1" class="form-check-input" <%= user.is_admin ? 'checked' : '' %>>
                                            <label for="is_admin" class="form-check-label fw-semibold">
                                                <i class="bi bi-shield-fill text-warning me-2"></i>Admin Role
                                            </label>
                                            <div class="form-text">Grant administrative privileges to this user</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-3 justify-content-end">
                            <a href="/users" class="btn btn-outline-secondary btn-lg px-4">
                                <i class="bi bi-x-circle me-2"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-warning btn-lg px-4">
                                <i class="bi bi-check-circle me-2"></i>Update User
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light">
                    <h6 class="mb-0"><i class="bi bi-person-circle text-info me-2"></i>Current User Info</h6>
                </div>
                <div class="card-body">
                    <div class="text-center mb-3">
                        <div class="bg-<%= user.is_admin ? 'warning' : 'primary' %> rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 60px; height: 60px;">
                            <i class="bi bi-<%= user.is_admin ? 'shield-fill' : 'person-fill' %> text-white" style="font-size: 24px;"></i>
                        </div>
                        <div class="fw-bold"><%= user.name %></div>
                        <div class="text-muted small"><%= user.email || '' %></div>
                        <% if (user.is_admin) { %><span class="badge bg-warning text-dark mt-1">Admin User</span><% } %>
                    </div>
                    <div class="mb-3">
                        <h6 class="text-primary">User ID</h6>
                        <small class="text-muted">#<%= user.old_id || user._id %></small>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-light">
                    <h6 class="mb-0"><i class="bi bi-lightbulb text-warning me-2"></i>Guidelines</h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <h6 class="text-primary">Security Notes</h6>
                        <ul class="small text-muted mb-0">
                            <li>Only change password if necessary</li>
                            <li>Admin role grants full system access</li>
                            <li>KYC status affects user privileges</li>
                            <li>Wallet balance can be adjusted manually</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<style>
.card { border-radius: 15px; }
.form-control, .form-select { border-radius: 10px; border: 2px solid #e9ecef; }
.btn { border-radius: 10px; font-weight: 500; }
.btn-warning { background: linear-gradient(135deg, #ffc107 0%, #ff8c00 100%); border: none; color: #fff; }
</style>
<script>
function togglePassword(fieldId) {
    const field = document.getElementById(fieldId);
    const icon = document.getElementById(fieldId + '-icon');
    if (field.type === 'password') {
        field.type = 'text';
        icon.className = 'bi bi-eye-slash';
    } else {
        field.type = 'password';
        icon.className = 'bi bi-eye';
    }
}
</script>
