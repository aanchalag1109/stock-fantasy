<%
  const user = request.user_id;
  const statusColor = { pending: 'warning', accepted: 'success', approved: 'success', rejected: 'danger' };
  const sc = statusColor[request.status] || 'secondary';
  const displayStatus = request.status === 'approved' ? 'Accepted' : (request.status ? request.status.charAt(0).toUpperCase() + request.status.slice(1) : '—');
  const isPending = request.status === 'pending';

  // USDT details — prefer values stored on the withdrawal request itself
  const usdtAddr = request.usdt_wallet_address || (user && user.payment_details && user.payment_details.usdt_wallet_address) || null;
  const usdtNet  = request.usdt_network || (user && user.payment_details && user.payment_details.usdt_network) || 'BEP20';

  function fmtDate(d) {
    if (!d) return '—';
    return new Date(d).toLocaleString('en-IN', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  }
%>

<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0">
      <i class="bi bi-cash-coin text-warning me-2"></i>
      Withdrawal Request #<%= request.old_id || request._id %>
    </h3>
    <a href="/withdrawal_requests" class="btn btn-outline-secondary btn-sm">
      <i class="bi bi-arrow-left me-1"></i>Back to List
    </a>
  </div>

  <div class="row">
    <!-- LEFT: User + Request + USDT Details -->
    <div class="col-lg-7">

      <!-- User Details -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
          <i class="bi bi-person-fill me-2"></i>User Details
        </div>
        <div class="card-body">
          <% if (user) { %>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="text-muted small">Name</label>
              <div class="fw-semibold fs-5"><%= user.name || 'N/A' %></div>
            </div>
            <div class="col-md-6 mb-3">
              <label class="text-muted small">Mobile</label>
              <div class="fw-semibold"><%= user.mobile || 'N/A' %></div>
            </div>
            <div class="col-md-6 mb-3">
              <label class="text-muted small">Email</label>
              <div class="fw-semibold"><%= user.email || 'N/A' %></div>
            </div>
            <div class="col-md-6 mb-3">
              <label class="text-muted small">User ID</label>
              <div class="fw-semibold">#<%= user.old_id || user._id %></div>
            </div>
            <div class="col-md-4 mb-2">
              <div class="p-3 bg-light rounded text-center">
                <small class="text-muted d-block">Deposit Balance</small>
                <strong class="text-success"><%= Number(user.deposit_balance || 0).toLocaleString('en-IN') %></strong>
              </div>
            </div>
            <div class="col-md-4 mb-2">
              <div class="p-3 bg-light rounded text-center">
                <small class="text-muted d-block">Winnings Balance</small>
                <strong class="text-warning"><%= Number(user.winnings_balance || 0).toLocaleString('en-IN') %></strong>
              </div>
            </div>
            <div class="col-md-4 mb-2">
              <div class="p-3 bg-light rounded text-center">
                <small class="text-muted d-block">Total Balance</small>
                <strong class="text-primary"><%= (Number(user.deposit_balance || 0) + Number(user.winnings_balance || 0)).toLocaleString('en-IN') %></strong>
              </div>
            </div>
          </div>
          <% } else { %>
          <p class="text-muted">User not found</p>
          <% } %>
        </div>
      </div>

      <!-- Request Details -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-warning text-white">
          <i class="bi bi-info-circle me-2"></i>Request Details
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="text-muted small">Amount</label>
              <div class="fw-bold fs-4 text-danger"><%= Number(request.amount || 0).toLocaleString('en-IN') %> coins</div>
            </div>
            <div class="col-md-6 mb-3">
              <label class="text-muted small">Status</label>
              <div><span class="badge bg-<%= sc %> fs-6"><%= displayStatus %></span></div>
            </div>
            <div class="col-md-6 mb-3">
              <label class="text-muted small">Requested At</label>
              <div class="fw-semibold"><%= fmtDate(request.created_at) %></div>
            </div>
            <% if (request.admin_message) { %>
            <div class="col-12 mb-3">
              <label class="text-muted small">Admin Message</label>
              <div class="fw-semibold"><%= request.admin_message %></div>
            </div>
            <% } %>
          </div>
        </div>
      </div>

      <!-- USDT Payout Details -->
      <div class="card border-0 shadow-sm mb-4 border-warning">
        <div class="card-header bg-warning text-white">
          <i class="bi bi-wallet2 me-2"></i>USDT Payout Details
        </div>
        <div class="card-body">
          <% if (usdtAddr) { %>
          <div class="mb-3">
            <label class="text-muted small">Network</label>
            <div><span class="badge bg-info fs-6"><%= usdtNet %></span></div>
          </div>
          <div class="mb-3">
            <label class="text-muted small">USDT Wallet Address</label>
            <div class="input-group mt-1">
              <input type="text" class="form-control font-monospace" id="usdtAddr" value="<%= usdtAddr %>" readonly>
              <button class="btn btn-outline-secondary" type="button" onclick="copyAddr(this)">
                <i class="bi bi-clipboard"></i> Copy
              </button>
            </div>
          </div>
          <div class="alert alert-warning border-0 mb-0">
            <i class="bi bi-exclamation-triangle me-2"></i>
            Send <strong><%= Number(request.amount || 0).toLocaleString('en-IN') %> coins worth USDT</strong>
            on <strong><%= usdtNet %></strong> network only.
          </div>
          <% } else { %>
          <div class="alert alert-danger mb-0">
            <i class="bi bi-exclamation-circle me-2"></i>User has not added USDT wallet details.
          </div>
          <% } %>
        </div>
      </div>

    </div>

    <!-- RIGHT: Action + History -->
    <div class="col-lg-5">

      <% if (isPending) { %>
      <!-- Take Action -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-dark text-white">
          <i class="bi bi-check2-circle me-2"></i>Take Action
        </div>
        <div class="card-body">
          <form method="POST" action="/withdrawal_requests/<%= request._id %>">
            <input type="hidden" name="_method" value="PUT">
            <div class="mb-4">
              <label class="form-label fw-semibold">Message to User (optional)</label>
              <textarea name="admin_message" class="form-control" rows="3"
                placeholder="e.g. Payment sent via BEP20, TxID: 0x..."></textarea>
            </div>
            <div class="d-grid gap-2">
              <button type="submit" name="status" value="accepted" class="btn btn-success btn-lg"
                onclick="return confirm('Mark this withdrawal as ACCEPTED? Make sure you have sent the USDT payment first.')">
                <i class="bi bi-check-circle-fill me-2"></i>Accept & Mark as Paid
              </button>
              <button type="submit" name="status" value="rejected" class="btn btn-danger btn-lg"
                onclick="return confirm('Reject this withdrawal? Amount will be refunded to user wallet.')">
                <i class="bi bi-x-circle-fill me-2"></i>Reject & Refund
              </button>
            </div>
            <small class="text-muted d-block mt-3">
              <i class="bi bi-info-circle me-1"></i>
              Rejecting will automatically refund <strong><%= Number(request.amount || 0).toLocaleString('en-IN') %></strong> coins to user's winnings balance.
            </small>
          </form>
        </div>
      </div>
      <% } else { %>
      <!-- Already processed -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body text-center py-5">
          <% if (request.status === 'accepted' || request.status === 'approved') { %>
          <i class="bi bi-check-circle-fill text-success" style="font-size:3rem"></i>
          <h5 class="mt-3 text-success">Withdrawal Accepted</h5>
          <p class="text-muted">Payment has been processed.</p>
          <% } else { %>
          <i class="bi bi-x-circle-fill text-danger" style="font-size:3rem"></i>
          <h5 class="mt-3 text-danger">Withdrawal Rejected</h5>
          <p class="text-muted">Amount has been refunded to user.</p>
          <% } %>
        </div>
      </div>
      <% } %>

      <!-- Withdrawal History -->
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-light">
          <i class="bi bi-graph-up me-2"></i>User Withdrawal History
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-sm mb-0">
              <thead class="table-light">
                <tr><th>Amount</th><th>Status</th><th>Date</th></tr>
              </thead>
              <tbody>
                <% if (!history || !history.length) { %>
                <tr><td colspan="3" class="text-center text-muted py-3">No history found.</td></tr>
                <% } %>
                <% (history || []).forEach(h => {
                  const hSc = statusColor[h.status] || 'secondary';
                  const hDisplay = h.status === 'approved' ? 'Accepted' : (h.status ? h.status.charAt(0).toUpperCase() + h.status.slice(1) : '—');
                  const isCurrent = String(h._id) === String(request._id);
                %> 
                <tr class="<%= isCurrent ? 'table-warning' : '' %>">
                  <td class="fw-semibold"><%= Number(h.amount || 0).toLocaleString('en-IN') %></td>
                  <td><span class="badge bg-<%= hSc %>"><%= hDisplay %></span></td>
                  <td><small><%= h.created_at ? new Date(h.created_at).toLocaleString('en-IN', { day:'2-digit', month:'short', hour:'2-digit', minute:'2-digit' }) : '—' %></small></td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
function copyAddr(btn) {
  const val = document.getElementById('usdtAddr').value;
  navigator.clipboard.writeText(val).then(() => {
    btn.innerHTML = "<i class='bi bi-check'></i> Copied";
    setTimeout(() => { btn.innerHTML = "<i class='bi bi-clipboard'></i> Copy"; }, 2000);
  });
}
</script>
