<%#
  Market category create / edit.
  NEW IMPLEMENTATION — NODE.JS PROJECT (client feedback): dynamic categories — Market Type
  (Indian Stock / US Stock / Crypto), Category Name, Description, Min / Max stocks a player picks, Status.
  Assets are not attached here; they're assigned to categories when a session is created.
%>
<%
  const editing = !!category;
  const accent = editing ? 'warning' : 'success';
  const errs = typeof errors !== 'undefined' && errors ? errors : [];
  const legacyMarket = editing && category.market && !marketOptions[category.market] ? category.market : null;
  function stamp(date) {
    if (!date) return '';
    const parts = new Intl.DateTimeFormat('en-US', {
      timeZone: 'Asia/Kolkata',
      month: 'short', day: '2-digit', year: 'numeric',
      hour: '2-digit', minute: '2-digit', hourCycle: 'h23',
    }).formatToParts(new Date(date));
    const get = (kind) => (parts.find((part) => part.type === kind) || {}).value || '';
    return get('month') + ' ' + get('day') + ', ' + get('year') + ' ' + get('hour') + ':' + get('minute');
  }
%>
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">
                <i class="bi bi-<%= editing ? 'pencil-square text-warning' : 'plus-circle-fill text-success' %> me-2"></i>
                <%= editing ? 'Edit Market Category' : 'Create Market Category' %>
            </h1>
            <p class="text-muted mb-0">Categories belong to a market type and set how many assets a session must assign to them.</p>
        </div>
        <a href="/market_type_categories" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back to Categories
        </a>
    </div>

    <% if (errs.length) { %>
    <div class="alert alert-danger border-0 shadow-sm">
        <strong><i class="bi bi-exclamation-triangle-fill me-2"></i>Please fix the following:</strong>
        <ul class="mb-0 mt-2"><% errs.forEach(function (e) { %><li><%= e %></li><% }) %></ul>
    </div>
    <% } %>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header text-white" style="background: <%= editing ? 'linear-gradient(135deg, #ffc107 0%, #ff8c00 100%)' : 'linear-gradient(135deg, #28a745 0%, #20c997 100%)' %>;">
                    <h5 class="mb-0"><i class="bi bi-gear-fill me-2"></i>Category Configuration</h5>
                </div>
                <div class="card-body p-4">
                    <form action="<%= editing ? '/market_type_categories/' + category._id + '?_method=PUT' : '/market_type_categories' %>" method="POST" novalidate>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="market" class="form-label fw-semibold">Market Type <span class="text-danger">*</span></label>
                                <select name="market" id="market" class="form-select form-select-lg" required>
                                    <option value="">Choose market type</option>
                                    <% Object.entries(marketOptions).forEach(function ([key, m]) { %>
                                    <option value="<%= key %>" <%= values.market === key ? 'selected' : '' %>><%= m.label %></option>
                                    <% }) %>
                                    <% if (legacyMarket) { %><option value="<%= legacyMarket %>" <%= values.market === legacyMarket ? 'selected' : '' %>><%= allMarkets[legacyMarket].label %></option><% } %>
                                </select>
                                <div class="form-text">Only sessions of this market type can use the category.</div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="status" class="form-label fw-semibold">Status</label>
                                <select name="status" id="status" class="form-select form-select-lg">
                                    <option value="active" <%= values.status !== 'inactive' ? 'selected' : '' %>>🟢 Active</option>
                                    <option value="inactive" <%= values.status === 'inactive' ? 'selected' : '' %>>🔴 Inactive</option>
                                </select>
                                <div class="form-text">Only active categories can be chosen when creating a session.</div>
                            </div>
                            <div class="col-12 mb-3">
                                <label for="name" class="form-label fw-semibold">Category Name <span class="text-danger">*</span></label>
                                <input type="text" name="name" id="name" class="form-control form-control-lg" value="<%= values.name %>" maxlength="100" placeholder="e.g., Large Cap Indian, Top Cryptocurrencies" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <%# NEW IMPLEMENTATION — NODE.JS PROJECT (client feedback): limits apply to the player's basket %>
                                <label for="min_assets" class="form-label fw-semibold">Min Stocks a Player Must Pick <span class="text-danger">*</span></label>
                                <input type="number" name="min_assets" id="min_assets" class="form-control form-control-lg" value="<%= values.min_assets %>" min="1" max="500" step="1" required>
                                <div class="form-text">Fewest stocks a player must pick from this category in a basket. A session using this category needs at least this many assets in it.</div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="max_assets" class="form-label fw-semibold">Max Stocks a Player Can Pick <span class="text-danger">*</span></label>
                                <input type="number" name="max_assets" id="max_assets" class="form-control form-control-lg" value="<%= values.max_assets %>" min="1" max="500" step="1" required>
                                <div class="form-text">Most stocks a player can pick from this category (at least the minimum). The app disables the rest once this is reached.</div>
                            </div>
                            <div class="col-12 mb-4">
                                <label for="description" class="form-label fw-semibold">Description</label>
                                <textarea name="description" id="description" class="form-control" rows="3" maxlength="500" placeholder="Brief description of this category (optional)"><%= values.description %></textarea>
                            </div>
                        </div>

                        <div class="d-flex gap-3 justify-content-end">
                            <a href="/market_type_categories" class="btn btn-outline-secondary btn-lg px-4">
                                <i class="bi bi-x-circle me-2"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-<%= accent %> btn-lg px-4">
                                <i class="bi bi-check-circle me-2"></i><%= editing ? 'Update Category' : 'Create Category' %>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <% if (editing) { %>
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light">
                    <h6 class="mb-0"><i class="bi bi-info-circle text-info me-2"></i>Category Information</h6>
                </div>
                <div class="card-body">
                    <div class="mb-3"><h6 class="text-primary">Category ID</h6><small class="text-muted">#<%= category.old_id || category._id %></small></div>
                    <% if (category.created_at) { %><div class="mb-3"><h6 class="text-primary">Created</h6><small class="text-muted"><%= stamp(category.created_at) %></small></div><% } %>
                    <% if (category.updated_at) { %><div class="mb-3"><h6 class="text-primary">Last Updated</h6><small class="text-muted"><%= stamp(category.updated_at) %></small></div><% } %>
                    <div class="small text-muted">Changing the name or minimum affects new sessions only; existing sessions keep the categories and assets they were created with.</div>
                </div>
            </div>
            <% } %>
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light">
                    <h6 class="mb-0"><i class="bi bi-lightbulb text-warning me-2"></i>How categories work</h6>
                </div>
                <div class="card-body small text-muted">
                    <ul class="mb-0 ps-3">
                        <li>Create any category you need, for example <strong>Large Cap Indian</strong> (min 10) or <strong>Top Cryptocurrencies</strong> (min 5).</li>
                        <li>Assets are not attached to categories here. When creating a session, you assign assets to each category you pick.</li>
                        <li>The same asset can be in different categories in different sessions.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<style>
.card { border-radius: 15px; }
.form-control, .form-select { border-radius: 10px; border: 2px solid #e9ecef; }
.btn { border-radius: 10px; font-weight: 500; }
.btn-warning { background: linear-gradient(135deg, #ffc107 0%, #ff8c00 100%); border: none; color: white; }
.btn-success { background: linear-gradient(135deg, #28a745 0%, #20c997 100%); border: none; }
</style>
