<%#
  Market categories list.
  NEW IMPLEMENTATION — NODE.JS PROJECT (client feedback): filter by market type (Indian Stock /
  US Stock / Crypto), and show each category's minimum number of assets.
%>
<%
  function when(date) {
    if (!date) return { date: 'N/A', time: '' };
    const parts = new Intl.DateTimeFormat('en-US', {
      timeZone: 'Asia/Kolkata',
      month: 'short', day: 'numeric', year: 'numeric',
      hour: '2-digit', minute: '2-digit', hourCycle: 'h23',
    }).formatToParts(new Date(date));
    const get = (kind) => (parts.find((part) => part.type === kind) || {}).value || '';
    return { date: get('month') + ' ' + get('day') + ', ' + get('year'), time: get('hour') + ':' + get('minute') };
  }
  const style = { indian_stock: ['success', 'graph-up'], us_stock: ['primary', 'graph-up-arrow'], crypto: ['warning', 'currency-bitcoin'], uk: ['secondary', 'archive'] };
  const styleOf = (m) => style[m] || ['secondary', 'tag'];
%>
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1"><i class="bi bi-tags text-success me-2"></i>Market Categories</h1>
            <p class="text-muted mb-0">Create categories per market type and set the minimum assets a session must assign to each.</p>
        </div>
        <a href="/market_type_categories/create" class="btn btn-success btn-lg">
            <i class="bi bi-plus-circle me-2"></i>Add New Category
        </a>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <div class="d-flex flex-wrap gap-2" role="group" aria-label="Filter by market type">
                <a href="/market_type_categories" class="btn <%= !market ? 'btn-dark' : 'btn-outline-dark' %>">
                    <i class="bi bi-list me-1"></i>All <span class="badge bg-light text-dark ms-1"><%= counts.all %></span>
                </a>
                <% Object.entries(allMarkets).forEach(function ([key, m]) { if (!marketOptions[key] && !counts[key]) return; const s = styleOf(key); %>
                <a href="?market=<%= key %>" class="btn <%= market === key ? 'btn-' + s[0] : 'btn-outline-' + s[0] %>">
                    <i class="bi bi-<%= s[1] %> me-1"></i><%= m.label %> <span class="badge bg-light text-dark ms-1"><%= counts[key] || 0 %></span>
                </a>
                <% }) %>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header text-white" style="background: linear-gradient(135deg, #28a745 0%, #20c997 100%);">
            <h5 class="mb-0"><i class="bi bi-collection-fill me-2"></i><%= market ? allMarkets[market].label + ' Categories' : 'All Categories' %></h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th class="fw-semibold">#</th>
                            <th class="fw-semibold">Category Name</th>
                            <th class="fw-semibold">Market Type</th>
                            <th class="fw-semibold text-center">Min. Assets</th>
                            <th class="fw-semibold text-center">Max. Assets</th>
                            <th class="fw-semibold">Status</th>
                            <th class="fw-semibold">Created</th>
                            <th class="fw-semibold text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (!categories.length) { %>
                        <tr>
                            <td colspan="8" class="text-center py-5">
                                <div class="text-muted">
                                    <i class="bi bi-tags display-1 d-block mb-3"></i>
                                    <h5>No categories found</h5>
                                    <p>Create a market category to use it in sessions.</p>
                                    <a href="/market_type_categories/create" class="btn btn-success"><i class="bi bi-plus-circle me-1"></i>Add New Category</a>
                                </div>
                            </td>
                        </tr>
                        <% } %>
                        <% categories.forEach(function (category) {
                            const created = when(category.created_at);
                            const s = styleOf(category.market);
                        %>
                        <tr>
                            <td class="fw-semibold"><%= category.old_id || category._id %></td>
                            <td>
                                <div class="fw-semibold text-dark"><%= category.name %></div>
                                <% if (category.description) { %><small class="text-muted"><%= category.description %></small><% } %>
                            </td>
                            <td><span class="badge bg-<%= s[0] %>"><i class="bi bi-<%= s[1] %> me-1"></i><%= category.market ? allMarkets[category.market].label : 'Not set' %></span></td>
                            <td class="text-center"><span class="badge bg-light text-dark border fs-6"><%= category.min_assets || 1 %></span></td>
                            <td class="text-center"><% if (category.max_assets) { %><span class="badge bg-light text-dark border fs-6"><%= category.max_assets %></span><% } else { %><span class="text-muted small">No limit</span><% } %></td>
                            <td>
                                <span class="badge <%= category.status === 'active' ? 'bg-success' : 'bg-secondary' %>">
                                    <%= category.status === 'active' ? 'Active' : 'Inactive' %>
                                </span>
                            </td>
                            <td><div class="small"><div class="fw-semibold"><%= created.date %></div><div class="text-muted"><%= created.time %></div></div></td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a href="/market_type_categories/<%= category._id %>/edit" class="btn btn-outline-warning" title="Edit Category"><i class="bi bi-pencil"></i></a>
                                    <form action="/market_type_categories/<%= category._id %>?_method=DELETE" method="POST" class="d-inline">
                                        <button type="submit" class="btn btn-outline-danger" title="Delete Category" onclick="return confirm('Delete this category? Existing sessions keep the assets they had in it.')"><i class="bi bi-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<style>
.card { border-radius: 15px; }
.btn { border-radius: 8px; font-weight: 500; }
.table tbody tr:hover { background-color: #f8f9fa; }
</style>
