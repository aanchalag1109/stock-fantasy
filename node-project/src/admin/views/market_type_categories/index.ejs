<%
  function when(date) {
    if (!date) return { date: 'N/A', time: '' };
    const parts = new Intl.DateTimeFormat('en-US', {
      timeZone: 'Asia/Kolkata',
      month: 'short', day: 'numeric', year: 'numeric',
      hour: '2-digit', minute: '2-digit', hourCycle: 'h23',
    }).formatToParts(new Date(date));
    const get = (kind) => (parts.find((part) => part.type === kind) || {}).value || '';
    return { date: get('month') + ' ' + get('day') + ', ' + get('year'), time: get('hour') + ':' + get('minute') };
  }
  function label(value) {
    return value ? value.charAt(0).toUpperCase() + value.slice(1) : '';
  }
%>
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1"><i class="bi bi-tags text-success me-2"></i>Market Categories</h1>
            <p class="text-muted mb-0">Manage stock and crypto market categories</p>
        </div>
        <a href="/market_type_categories/create" class="btn btn-success btn-lg">
            <i class="bi bi-plus-circle me-2"></i>Add New Category
        </a>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <div class="btn-group" role="group">
                <a href="?type=stock" class="btn <%= type === 'stock' ? 'btn-success' : 'btn-outline-success' %>">
                    <i class="bi bi-graph-up me-1"></i>Stock Categories
                    <span class="badge bg-light text-dark ms-1"><%= stockCount %></span>
                </a>
                <a href="?type=crypto" class="btn <%= type === 'crypto' ? 'btn-warning' : 'btn-outline-warning' %>">
                    <i class="bi bi-currency-bitcoin me-1"></i>Crypto Categories
                    <span class="badge bg-light text-dark ms-1"><%= cryptoCount %></span>
                </a>
                <a href="/market_type_categories" class="btn <%= !type ? 'btn-dark' : 'btn-outline-dark' %>">
                    <i class="bi bi-list me-1"></i>All Categories
                    <span class="badge bg-light text-dark ms-1"><%= allCount %></span>
                </a>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header text-white" style="background: linear-gradient(135deg, #28a745 0%, #20c997 100%);">
            <h5 class="mb-0"><i class="bi bi-collection-fill me-2"></i>All Categories</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="fw-semibold">#</th>
                            <th class="fw-semibold"><i class="bi bi-tag me-1"></i>Category Name</th>
                            <th class="fw-semibold"><i class="bi bi-diagram-3 me-1"></i>Market Type</th>
                            <th class="fw-semibold"><i class="bi bi-circle-fill me-1"></i>Status</th>
                            <th class="fw-semibold"><i class="bi bi-calendar me-1"></i>Created</th>
                            <th class="fw-semibold text-center"><i class="bi bi-gear me-1"></i>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (!categories.length) { %>
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <div class="text-muted">
                                    <i class="bi bi-tags display-1 d-block mb-3"></i>
                                    <h5>No categories found</h5>
                                    <p>Create your first market category to get started.</p>
                                    <a href="/market_type_categories/create" class="btn btn-success">
                                        <i class="bi bi-plus-circle me-1"></i>Add New Category
                                    </a>
                                </div>
                            </td>
                        </tr>
                        <% } %>
                        <% categories.forEach(category => {
                            const created = when(category.created_at);
                            const stock = category.category_type === 'stock';
                        %>
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="bg-<%= stock ? 'success' : 'warning' %> rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                        <i class="bi bi-<%= stock ? 'graph-up' : 'currency-bitcoin' %> text-white"></i>
                                    </div>
                                    <span class="ms-2 fw-semibold"><%= category.old_id || category._id %></span>
                                </div>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark"><%= category.name %></div>
                                <% if (category.description) { %><small class="text-muted"><%= category.description %></small><% } %>
                            </td>
                            <td>
                                <span class="badge <%= stock ? 'bg-success' : 'bg-warning' %> fs-6">
                                    <i class="bi bi-<%= stock ? 'graph-up' : 'currency-bitcoin' %> me-1"></i>
                                    <%= label(category.category_type) %>
                                </span>
                            </td>
                            <td>
                                <span class="badge <%= category.status === 'active' ? 'bg-success' : 'bg-secondary' %> fs-6">
                                    <i class="bi bi-<%= category.status === 'active' ? 'check' : 'x' %>-circle me-1"></i>
                                    <%= label(category.status) %>
                                </span>
                            </td>
                            <td>
                                <div class="small">
                                    <div class="fw-semibold"><%= created.date %></div>
                                    <div class="text-muted"><%= created.time %></div>
                                </div>
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a href="/market_type_categories/<%= category._id %>/edit" class="btn btn-outline-warning" title="Edit Category">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form action="/market_type_categories/<%= category._id %>?_method=DELETE" method="POST" class="d-inline">
                                        <button type="submit" class="btn btn-outline-danger" title="Delete Category" onclick="return confirm('Are you sure you want to delete this category?')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<style>
.card { border-radius: 15px; }
.btn { border-radius: 8px; font-weight: 500; }
.table tbody tr:hover { background-color: #f8f9fa; }
</style>
