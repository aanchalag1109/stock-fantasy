<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3">Test Users List</h1>
        <form action="/testing/generate-users" method="POST" class="d-inline" onsubmit="return confirm('Generate 100 random test users?');">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-plus-circle me-2"></i>Generate 100 Test Users
            </button>
        </form>
    </div>
    <div class="card shadow-sm">
        <div class="card-header fw-bold">All Test Users</div>
        <div class="card-body p-0">
            <form method="POST" action="/testing/bulk-delete-users" id="bulkForm">
                <div class="p-3">
                    <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Delete selected test users?')">Delete Selected</button>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th><input type="checkbox" id="selectAll"></th>
                                <th>Name</th><th>Mobile</th><th>Email</th>
                                <th>Deposit Balance</th><th>Winning Balance</th><th>Registered</th><th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% users.forEach(user => { %>
                            <tr>
                                <td><input type="checkbox" class="user-checkbox" name="ids" value="<%= user._id %>"></td>
                                <td><%= user.name %></td>
                                <td><%= user.mobile %></td>
                                <td><%= user.email || 'N/A' %></td>
                                <td><%= user.deposit_balance || 0 %></td>
                                <td><%= user.winnings_balance || 0 %></td>
                                <td><%= user.created_at ? new Date(user.created_at).toLocaleDateString('en-IN') : '' %></td>
                                <td><a href="/testing/user/<%= user._id %>" class="btn btn-sm btn-outline-primary">View</a></td>
                            </tr>
                            <% }) %>
                            <% if (!users.length) { %>
                            <tr><td colspan="8" class="text-center py-4 text-muted">No test users yet.</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </form>
        </div>
    </div>
</div>
<script>
document.getElementById('selectAll')?.addEventListener('change', function () {
    document.querySelectorAll('.user-checkbox').forEach(cb => { cb.checked = this.checked; });
});
</script>
