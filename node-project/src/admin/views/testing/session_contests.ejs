<div class="container-fluid">
    <div class="card">
        <div class="card-header d-flex justify-content-between">
            <div>
                <h5 class="mb-0">Contests in <%= session.name %></h5>
                <small class="text-muted">Session ID: <%= session.old_id || session._id %></small>
            </div>
            <a href="/testing" class="btn btn-sm btn-outline-secondary">Back to Testing</a>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Category</th>
                            <th>Entry Fee</th>
                            <th>Participants</th>
                            <th>Created</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (contests.length === 0) { %>
                        <tr><td colspan="6" class="text-center text-muted py-3">No contests found for this session.</td></tr>
                        <% } %>
                        <% contests.forEach(contest => { %>
                        <tr>
                            <td><%= contest.old_id || contest._id %></td>
                            <td><%= contest.category %></td>
                            <td><%= contest.entry_fee %></td>
                            <td><%= contest.participants || 0 %></td>
                            <td><%= contest.created_at ? new Date(contest.created_at).toLocaleString('en-IN', { month:'short', day:'2-digit', hour:'2-digit', minute:'2-digit' }) : '—' %></td>
                            <td>
                                <a href="/testing/contest/<%= contest._id %>" class="btn btn-sm btn-outline-primary">View</a>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
