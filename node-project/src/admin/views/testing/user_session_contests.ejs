<div class="container-fluid">
    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header d-flex justify-content-between">
                    <div>
                        <h5 class="mb-0">Contests in <%= session.name %></h5>
                        <small class="text-muted">User: <%= user.name || 'User' %> | Session ID: <%= session.old_id || session._id %></small>
                    </div>
                    <a href="/testing/user/<%= user._id %>" class="btn btn-sm btn-outline-secondary">Back to User</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr><th>ID</th><th>Category</th><th>Entry Fee</th><th>Participants</th><th>Action</th></tr>
                            </thead>
                            <tbody>
                                <% if (contests.length === 0) { %>
                                <tr><td colspan="5" class="text-center text-muted py-3">No contests found.</td></tr>
                                <% } %>
                                <% contests.forEach(contest => { %>
                                <tr>
                                    <td><%= contest.old_id || contest._id %></td>
                                    <td><%= contest.category %></td>
                                    <td><%= contest.entry_fee %></td>
                                    <td><%= contest.participants || 0 %></td>
                                    <td>
                                        <a href="/testing/contest/<%= contest._id %>" class="btn btn-xs btn-outline-primary">Detail</a>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Baskets</h5>
                    <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#createBasketModal">
                        <i class="bi bi-plus-circle me-1"></i>Create Basket
                    </button>
                </div>
                <div class="card-body p-0" id="basketsContainer">
                    <% if (baskets.length === 0) { %>
                    <div class="text-center text-muted py-3">No baskets found.</div>
                    <% } else { %>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead><tr><th>Serial</th><th>Score</th><th>Created</th><th>Action</th></tr></thead>
                            <tbody>
                                <% baskets.forEach(basket => { %>
                                <tr>
                                    <td><%= basket.serial_no || 'N/A' %></td>
                                    <td><%= basket.total_score || 0 %></td>
                                    <td><%= basket.created_at ? new Date(basket.created_at).toLocaleDateString('en-IN') : '—' %></td>
                                    <td>
                                        <button class="btn btn-xs btn-outline-danger" onclick="deleteBasket('<%= basket._id %>')">Delete</button>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Create Basket Modal -->
<div class="modal fade" id="createBasketModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create Basket - Select Assets</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="assetCategories"><div class="text-center text-muted py-3">Loading assets...</div></div>
                <div class="mt-3">
                    <label class="form-label fw-bold">Selected Assets (<span id="selectedCount">0</span>)</label>
                    <div id="selectedAssets" class="border rounded p-2" style="min-height:40px;">
                        <span class="text-muted">No assets selected</span>
                    </div>
                </div>
                <div class="mt-3" id="multipliersSection" style="display:none;">
                    <label class="form-label fw-bold">Multipliers</label>
                    <div id="multiplierInputs" class="border rounded p-2"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="createBasket()" id="createBtn" disabled>Create Basket</button>
            </div>
        </div>
    </div>
</div>

<style>
.asset-card { cursor:pointer; border:2px solid #dee2e6; border-radius:8px; padding:10px; margin-bottom:8px; transition:all 0.2s; }
.asset-card:hover { border-color:#0d6efd; }
.asset-card.selected { border-color:#0d6efd; background:#f0f7ff; }
.selected-tag { display:inline-block; background:#e3f2fd; border:1px solid #2196f3; border-radius:12px; padding:3px 8px; margin:2px; font-size:12px; }
</style>

<script>
const USER_ID = '<%= user._id %>';
const SESSION_ID = '<%= session._id %>';
let selectedAssets = [];
let availableCategories = [];

document.getElementById('createBasketModal').addEventListener('show.bs.modal', loadAssets);

async function loadAssets() {
    try {
        const res = await fetch('/api/session-assets/' + SESSION_ID);
        const data = await res.json();
        if (data.success) {
            availableCategories = data.categories || [];
            renderAssetCategories();
        } else {
            document.getElementById('assetCategories').innerHTML = '<div class="text-danger">No assets found for this session.</div>';
        }
    } catch(e) {
        document.getElementById('assetCategories').innerHTML = '<div class="text-danger">Error loading assets.</div>';
    }
}

function renderAssetCategories() {
    let html = '';
    availableCategories.forEach(cat => {
        html += `<div class="mb-3"><h6 class="text-primary">${cat.display_name || cat.category_name} <span class="badge bg-secondary">${cat.count || cat.assets.length}</span></h6><div class="row">`;
        cat.assets.forEach(asset => {
            html += `<div class="col-md-6 col-lg-4">
                <div class="asset-card" data-symbol="${asset.symbol}" onclick="toggleAsset('${cat.category_name}', '${asset.symbol}', '${asset.name}')">
                    <div class="fw-bold text-success">${asset.symbol}</div>
                    <small class="text-muted">${asset.name}</small>
                </div>
            </div>`;
        });
        html += '</div></div>';
    });
    document.getElementById('assetCategories').innerHTML = html || '<div class="text-muted">No assets available.</div>';
}

function toggleAsset(category, symbol, name) {
    const el = document.querySelector(`[data-symbol="${symbol}"]`);
    const idx = selectedAssets.findIndex(a => a.symbol === symbol);
    if (idx >= 0) {
        selectedAssets.splice(idx, 1);
        el.classList.remove('selected');
    } else {
        selectedAssets.push({ symbol, name, sector: category, prediction: 'UP' });
        el.classList.add('selected');
    }
    updateSelectedDisplay();
}

function removeAsset(symbol) {
    selectedAssets = selectedAssets.filter(a => a.symbol !== symbol);
    const el = document.querySelector(`[data-symbol="${symbol}"]`);
    if (el) el.classList.remove('selected');
    updateSelectedDisplay();
}

function updateSelectedDisplay() {
    document.getElementById('selectedCount').textContent = selectedAssets.length;
    const container = document.getElementById('selectedAssets');
    if (!selectedAssets.length) {
        container.innerHTML = '<span class="text-muted">No assets selected</span>';
        document.getElementById('createBtn').disabled = true;
        document.getElementById('multipliersSection').style.display = 'none';
    } else {
        container.innerHTML = selectedAssets.map(a =>
            `<span class="selected-tag">${a.symbol}<button type="button" class="btn-close btn-close ms-1" style="font-size:10px;" onclick="removeAsset('${a.symbol}')"></button></span>`
        ).join('');
        document.getElementById('createBtn').disabled = false;
        document.getElementById('multipliersSection').style.display = 'block';
        updateMultiplierInputs();
    }
}

function updateMultiplierInputs() {
    document.getElementById('multiplierInputs').innerHTML = selectedAssets.map(a =>
        `<div class="row mb-2 align-items-center">
            <div class="col-5"><strong>${a.symbol}</strong><small class="text-muted d-block">${a.name}</small></div>
            <div class="col-4"><input type="number" class="form-control form-control-sm" id="mult_${a.symbol}" value="1" min="0.1" max="5" step="0.1"></div>
            <div class="col-3">
                <select class="form-select form-select-sm" id="pred_${a.symbol}">
                    <option value="UP">UP ↑</option>
                    <option value="DOWN">DOWN ↓</option>
                </select>
            </div>
        </div>`
    ).join('');
}

async function createBasket() {
    if (!selectedAssets.length) return alert('Select at least one asset');
    const assets = selectedAssets.map(a => ({
        name: a.symbol, symbol: a.symbol, sector: a.sector,
        prediction: document.getElementById('pred_' + a.symbol)?.value || 'UP'
    }));
    const multipliers = assets.map((a, i) => ({
        index: i, asset_name: a.name,
        multiplier: parseFloat(document.getElementById('mult_' + a.symbol)?.value) || 1,
        prediction: a.prediction, selected: true
    }));

    try {
        const res = await fetch('/testing/create-basket', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ user_id: USER_ID, session_id: SESSION_ID, assets, multipliers })
        });
        const data = await res.json();
        if (data.success) {
            bootstrap.Modal.getInstance(document.getElementById('createBasketModal')).hide();
            location.reload();
        } else {
            alert('Error: ' + data.message);
        }
    } catch(e) { alert('Error creating basket'); }
}

async function deleteBasket(basketId) {
    if (!confirm('Delete this basket?')) return;
    try {
        const res = await fetch('/testing/delete-basket/' + basketId, { method: 'DELETE' });
        const data = await res.json();
        if (data.success) location.reload();
        else alert('Error: ' + data.message);
    } catch(e) { alert('Error'); }
}
</script>
