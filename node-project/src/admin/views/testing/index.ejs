<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between">
                    <h5 class="mb-0">Users List</h5>
                    <button class="btn btn-sm btn-outline-secondary" onclick="location.reload()">Refresh</button>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr><th>Name</th><th>Mobile</th><th>Email</th><th>Balance</th><th>Created</th><th>Action</th></tr>
                            </thead>
                            <tbody>
                                <% users.forEach(user => { %>
                                <tr>
                                    <td><%= user.name || 'N/A' %></td>
                                    <td><%= user.mobile || '' %></td>
                                    <td><%= user.email || 'N/A' %></td>
                                    <td><%= user.winnings_balance || 0 %></td>
                                    <td><%= user.created_at ? new Date(user.created_at).toLocaleDateString('en-US', { month:'short', day:'2-digit' }) : '' %></td>
                                    <td><a href="/testing/user/<%= user._id %>" class="btn btn-sm btn-outline-primary">View</a></td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <%- include('../partials/pagination', { pages, page, extraQuery: '' }) %>
                </div>
            </div>
        </div>
    </div>
</div>
