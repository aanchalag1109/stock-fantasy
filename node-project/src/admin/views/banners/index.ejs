<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1"><i class="bi bi-images text-info me-2"></i>Banner Management</h1>
            <p class="text-muted mb-0">Manage promotional banners and advertisements</p>
        </div>
        <a href="/banners/create" class="btn btn-info btn-lg text-white">
            <i class="bi bi-plus-circle me-2"></i>Add New Banner
        </a>
    </div>
    <div class="card shadow-sm border-0">
        <div class="card-header text-white" style="background: linear-gradient(135deg, #17a2b8 0%, #138496 100%);">
            <h5 class="mb-0 text-white"><i class="bi bi-collection-fill me-2"></i>All Banners</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="fw-semibold"><i class="bi bi-card-text me-1"></i>Title</th>
                            <th class="fw-semibold"><i class="bi bi-image me-1"></i>Preview</th>
                            <th class="fw-semibold"><i class="bi bi-link-45deg me-1"></i>Link</th>
                            <th class="fw-semibold"><i class="bi bi-circle-fill me-1"></i>Status</th>
                            <th class="fw-semibold text-center"><i class="bi bi-gear me-1"></i>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% items.forEach(banner => { %>
                        <tr>
                            <td>
                                <div class="fw-semibold text-dark"><%= banner.title %></div>
                                <% if (banner.description) { %><small class="text-muted"><%= String(banner.description).slice(0, 50) %></small><% } %>
                            </td>
                            <td>
                                <% if (banner.image) { %>
                                <img src="/<%= banner.image %>" alt="<%= banner.title %>" class="rounded shadow-sm" style="width: 120px; height: 60px; object-fit: cover;">
                                <% } else { %><span class="text-muted">No image</span><% } %>
                            </td>
                            <td>
                                <% if (banner.link) { %>
                                    <a href="<%= banner.link %>" target="_blank" class="text-decoration-none"><i class="bi bi-box-arrow-up-right me-1"></i><%= String(banner.link).slice(0, 30) %></a>
                                <% } else { %><span class="text-muted">No link</span><% } %>
                            </td>
                            <td>
                                <span class="badge <%= banner.status === 'active' ? 'bg-success' : 'bg-secondary' %> fs-6">
                                    <i class="bi bi-<%= banner.status === 'active' ? 'check' : 'x' %>-circle me-1"></i>
                                    <%= banner.status ? banner.status.charAt(0).toUpperCase() + banner.status.slice(1) : '' %>
                                </span>
                            </td>
                            <td class="text-center">
                                <form action="/banners/<%= banner._id %>?_method=DELETE" method="POST" class="d-inline">
                                    <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Are you sure you want to delete this banner?')"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                        <% }) %>
                        <% if (!items.length) { %>
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <div class="text-muted">
                                    <i class="bi bi-images display-1 d-block mb-3"></i>
                                    <h5>No banners found</h5>
                                    <a href="/banners/create" class="btn btn-info text-white">Add New Banner</a>
                                </div>
                            </td>
                        </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
