<%
  function fmtNum(n) { return Number(n || 0).toLocaleString('en-IN'); }
  function fmtDec(n, d) { return Number(n || 0).toFixed(d || 2); }
  function when(d) {
    if (!d) return '—';
    return new Date(d).toLocaleString('en-US', { timeZone: 'Asia/Kolkata', day:'2-digit', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit' });
  }
  const sessionStatus = contest.session_status || 'upcoming';
  const statusBadgeClass = sessionStatus === 'live' ? 'bg-success' : sessionStatus === 'completed' ? 'bg-secondary' : 'bg-warning';
%>
<div class="container-fluid">
  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center flex-wrap gap-2">
          <h5 class="mb-0"><i class="bi bi-calculator-fill me-2"></i>Contest Calculation Results</h5>
          <div class="d-flex flex-wrap gap-2 align-items-center">
            <%# PHP PARITY: "How It Works" and RUN ALL (PHP performance/show.blade.php header) %>
            <button class="btn btn-light btn-sm" data-bs-toggle="modal" data-bs-target="#workingModal">
              <i class="bi bi-info-circle me-1"></i>How It Works
            </button>
            <% if (can('performance.manage')) { %>
            <div class="d-flex align-items-center gap-2 p-2 bg-dark rounded">
              <input type="time" id="runAllStartTime" class="form-control form-control-sm" style="width:120px" aria-label="RUN ALL start time (IST)">
              <span class="text-white small">to</span>
              <input type="time" id="runAllEndTime" class="form-control form-control-sm" style="width:120px" aria-label="RUN ALL end time (IST)">
              <button class="btn btn-warning btn-sm fw-bold" id="runAllBtn"><i class="bi bi-lightning-charge-fill"></i> RUN ALL</button>
              <span class="badge bg-danger" id="runAllStatusBadge" style="display:none">RUNNING</span>
              <button class="btn btn-outline-danger btn-sm" id="stopRunAllBtn" style="display:none"><i class="bi bi-stop-fill"></i> Stop</button>
            </div>
            <% } %>
            <button class="btn btn-info btn-sm" onclick="showPricesModal()">
              <i class="bi bi-currency-exchange me-1"></i>Show Prices
            </button>
            <button class="btn btn-warning btn-sm" onclick="loadTransactions()">
              <i class="bi bi-cash-coin me-1"></i>Transactions
            </button>
            <a href="/performance/session/<%= contest.session_id %>" class="btn btn-outline-light btn-sm">
              <i class="bi bi-arrow-left me-1"></i>Back to Session
            </a>
            <span class="badge <%= statusBadgeClass %>">
              <% if (sessionStatus === 'live') { %>🔴 LIVE<% } else if (sessionStatus === 'completed') { %>✅ COMPLETED<% } else { %>🟡 UPCOMING<% } %>
            </span>
          </div>
        </div>
        <div class="card-body">

          <!-- Stats Row -->
          <div class="row mb-4">
            <div class="col">
              <div class="text-center p-3 bg-light rounded">
                <h6 class="text-muted mb-1">Total Winners</h6>
                <h4 class="text-primary mb-0"><%= fmtNum(stats.actual_winners) %></h4>
              </div>
            </div>
            <div class="col">
              <div class="text-center p-3 bg-light rounded">
                <h6 class="text-muted mb-1">Total Pool</h6>
                <h4 class="text-success mb-0"><%= fmtNum(stats.total_pool_generated) %> coins</h4>
              </div>
            </div>
            <div class="col">
              <div class="text-center p-3 bg-light rounded">
                <h6 class="text-muted mb-1">Platform Fee</h6>
                <h4 class="text-danger mb-0"><%= fmtNum(stats.platform_fee_collected) %> coins</h4>
              </div>
            </div>
            <div class="col">
              <div class="text-center p-3 bg-light rounded">
                <h6 class="text-muted mb-1">Prize Pool</h6>
                <h4 class="text-warning mb-0"><%= fmtNum(stats.actual_prize_pool) %> coins</h4>
              </div>
            </div>
            <div class="col">
              <div class="text-center p-3 bg-light rounded">
                <h6 class="text-muted mb-1">Participants</h6>
                <h4 class="text-info mb-0"><%= fmtNum(stats.total_participants) %></h4>
              </div>
            </div>
            <div class="col" id="sessionAssetsStatBox">
              <div class="text-center p-3 bg-light rounded">
                <h6 class="text-muted mb-1">Session Assets</h6>
                <h4 class="text-info mb-0" id="statTotalAssets">—</h4>
                <small id="statPriceSummary" class="text-muted">loading...</small>
              </div>
            </div>
          </div>

          <!-- Contest Details -->
          <div class="row mb-4">
            <div class="col-md-6">
              <h6 class="text-muted mb-2">Contest Details:</h6>
              <p class="mb-1"><strong>Contest ID:</strong> #<%= contest.old_id || contest._id %></p>
              <p class="mb-1"><strong>Category:</strong> <%= (contest.category || '').charAt(0).toUpperCase() + (contest.category || '').slice(1) %></p>
              <p class="mb-1"><strong>Session:</strong> <%= contest.session_name || 'N/A' %></p>
            </div>
            <div class="col-md-6">
              <h6 class="text-muted mb-2">Fee Structure:</h6>
              <p class="mb-1"><strong>Entry Fee:</strong> <%= fmtNum(contest.entry_fee) %> probcoins</p>
              <p class="mb-1"><strong>Platform Fee:</strong> <%= contest.platform_fee || 0 %>%</p>
              <p class="mb-1"><strong>Winning %:</strong> <%= contest.winning_percentage || 30 %>%</p>
            </div>
          </div>

          <!-- Session Asset Prices (auto-loads on page ready) -->
          <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center" style="background:linear-gradient(135deg,#17a2b8 0%,#138496 100%);color:#fff">
              <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>Session Asset Prices</h5>
              <button class="btn btn-sm btn-light" onclick="loadPrices()" id="loadPricesBtn">
                <i class="bi bi-arrow-clockwise me-1"></i>Refresh
              </button>
            </div>
            <div class="card-body">
              <div class="alert alert-info mb-3">
                <i class="bi bi-info-circle me-2"></i>Prices are saved at session level. All contests in this session share the same prices.
              </div>
              <div id="pricesContainer">
                <div class="text-center p-3"><div class="spinner-border text-info"></div><p class="mt-2 text-muted">Loading prices...</p></div>
              </div>
            </div>
          </div>

          <!-- Transactions (lazy load) -->
          <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center" style="background:linear-gradient(135deg,#fd7e14 0%,#e83e8c 100%);color:#fff">
              <h5 class="mb-0"><i class="bi bi-cash-coin me-2"></i>Transactions</h5>
              <button class="btn btn-sm btn-light" onclick="loadTransactions()" id="loadTxnBtn">
                <i class="bi bi-arrow-clockwise me-1"></i>Load Transactions
              </button>
            </div>
            <div class="card-body p-0">
              <div id="transactionsContainer">
                <div class="text-center p-3 text-muted">Click "Load Transactions" to view contest transactions</div>
              </div>
            </div>
          </div>

          <!-- Prize Distribution -->
          <div class="card mb-4">
            <div class="card-header bg-success text-white">
              <h5 class="mb-0"><i class="bi bi-trophy-fill me-2"></i>Prize Distribution</h5>
            </div>
            <div class="card-body">
              <%# PHP PARITY: "Calculate Results" — same routine as POST /api/v1/calculate-results (credits prizes once) %>
              <% if (can('performance.manage')) { %>
              <div class="mb-3">
                <button class="btn btn-sm btn-warning" id="calculateResultsBtn"><i class="bi bi-calculator"></i> Calculate Results</button>
              </div>
              <% } %>
              <% if (flexibleDistribution && flexibleDistribution.length > 0) { %>
              <div class="row">
                <% flexibleDistribution.forEach(dist => { %>
                <div class="col-md-6 mb-3">
                  <div class="p-3 border rounded">
                    <div class="d-flex justify-content-between align-items-center">
                      <div>
                        <h6 class="mb-1"><%= dist.label %></h6>
                        <small class="text-muted"><%= dist.winners %> winners · <%= fmtDec(dist.percent, 2) %>%</small>
                      </div>
                      <div class="text-end">
                        <div class="fw-bold text-success fs-5"><%= fmtNum(dist.perWinner) %> coins</div>
                        <small class="text-muted">per winner</small>
                      </div>
                    </div>
                  </div>
                </div>
                <% }) %>
              </div>
              <% } else { %>
              <div class="alert alert-warning"><i class="bi bi-exclamation-triangle me-2"></i>No prize distribution data available.</div>
              <% } %>
            </div>
          </div>

          <!-- Participants / Leaderboard -->
          <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center" style="background:linear-gradient(135deg,#007bff 0%,#6610f2 100%);color:#fff">
              <h5 class="mb-0"><i class="bi bi-people-fill me-2"></i>Joined Users (<span id="participantCount"><%= stats.total_participants %></span>)</h5>
              <button class="btn btn-sm btn-light" onclick="loadParticipants()" id="loadParticipantsBtn">
                <i class="bi bi-arrow-clockwise me-1"></i>Load Participants
              </button>
            </div>
            <div class="card-body p-0">
              <div id="participantsContainer">
                <div class="text-center p-3 text-muted">Click "Load Participants" to view leaderboard data</div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
</div>

<%- include('_how_it_works') %>

<!-- Prices Modal -->
<div class="modal fade" id="pricesModal" tabindex="-1">
  <div class="modal-dialog modal-xl">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title"><i class="bi bi-currency-exchange me-2"></i>Session Asset Prices</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" id="pricesModalBody">
        <div class="text-center p-4"><div class="spinner-border text-primary"></div></div>
      </div>
      <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button></div>
    </div>
  </div>
</div>

<script>
const CONTEST_ID = '<%= contest._id %>';
const SESSION_ID = '<%= contest.session_id %>';
const TOTAL_WINNERS = <%= stats.actual_winners || 0 %>;
const FLEXIBLE_DIST = <%- JSON.stringify(flexibleDistribution || []) %>;

// ── Load Prices ────────────────────────────────────────────────────────────
function loadPrices() {
  // Update inline card container
  document.getElementById('pricesContainer').innerHTML =
    '<div class="text-center p-3"><div class="spinner-border text-info"></div><p class="mt-2 text-muted">Loading prices...</p></div>';

  // Also open modal if triggered via top button (check caller)
  const btn = document.getElementById('loadPricesBtn');
  if (btn) btn.disabled = true;

  fetch('/api/performance/' + CONTEST_ID + '/prices')
    .then(r => r.json())
    .then(data => {
      const html = buildPricesHtml(data);
      document.getElementById('pricesContainer').innerHTML = html;
      // Update modal body if modal is open
      const modalBody = document.getElementById('pricesModalBody');
      if (modalBody) modalBody.innerHTML = html;
      // Update stat box
      updateAssetStatBox(data);
      if (btn) btn.disabled = false;
    })
    .catch(err => {
      const msg = '<div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-2"></i>Failed to load prices: ' + err.message + '</div>';
      document.getElementById('pricesContainer').innerHTML = msg;
      const modalBody = document.getElementById('pricesModalBody');
      if (modalBody) modalBody.innerHTML = msg;
      if (btn) btn.disabled = false;
    });
}

function updateAssetStatBox(data) {
  const startPrices = data.start_prices || [];
  const endPrices   = data.end_prices   || [];
  const total = Math.max(startPrices.length, endPrices.length);
  const statBox = document.getElementById('sessionAssetsStatBox');
  if (!statBox) return;

  document.getElementById('statTotalAssets').textContent = total || '—';
  const missing = total - startPrices.length;
  const endMissing = total - endPrices.length;
  let summary = '';
  if (total === 0) {
    summary = 'no prices captured';
    statBox.querySelector('.rounded').classList.add('border', 'border-warning');
  } else {
    summary = `<span class="text-success fw-bold">${startPrices.length} start</span> / ` +
              `<span class="${endPrices.length === total ? 'text-success' : 'text-danger'} fw-bold">${endPrices.length} end</span>`;
    if (missing > 0) {
      summary += `<br><small class="text-warning">⚠️ ${missing} prices missing</small>`;
      statBox.querySelector('.rounded').classList.add('border', 'border-warning');
    }
  }
  document.getElementById('statPriceSummary').innerHTML = summary;
}

// Show prices in modal (top header button)
function showPricesModal() {
  const modal = new bootstrap.Modal(document.getElementById('pricesModal'));
  modal.show();
  document.getElementById('pricesModalBody').innerHTML =
    document.getElementById('pricesContainer').innerHTML;
}

// Auto-load prices on page load
document.addEventListener('DOMContentLoaded', () => { loadPrices(); });

function buildPricesHtml(data) {
  const startPrices = data.start_prices || [];
  const endPrices   = data.end_prices   || [];
  const sessionInfo = data.session_info || {};

  if (!startPrices.length && !endPrices.length) {
    return '<div class="alert alert-warning text-center"><i class="bi bi-exclamation-triangle display-4 text-warning d-block mb-2"></i>No Price Data Available.<br>This session has not started yet or prices have not been captured.</div>';
  }

  const startTable = startPrices.length ? `
    <div class="table-responsive" style="max-height:400px;overflow-y:auto">
    <table class="table table-sm table-hover mb-0">
      <thead class="table-light sticky-top"><tr><th>Symbol</th><th>Start Price</th><th>Time</th></tr></thead>
      <tbody>${startPrices.map(p => `
        <tr>
          <td class="fw-bold">${p.asset_symbol}</td>
          <td class="text-success">₹${Number(p.start_price || 0).toLocaleString('en-IN')}</td>
          <td class="text-muted small">${p.start_price_fetched_at ? new Date(p.start_price_fetched_at).toLocaleString() : 'N/A'}</td>
        </tr>`).join('')}
      </tbody>
    </table></div>` : '<div class="text-center p-3 text-muted">No start prices available</div>';

  const endTable = endPrices.length ? `
    <div class="table-responsive" style="max-height:400px;overflow-y:auto">
    <table class="table table-sm table-hover mb-0">
      <thead class="table-light sticky-top"><tr><th>Symbol</th><th>End Price</th><th>Change</th><th>Time</th></tr></thead>
      <tbody>${endPrices.map(p => {
        const sp = startPrices.find(s => s.asset_symbol === p.asset_symbol);
        const change = sp && sp.start_price > 0 ? ((p.end_price - sp.start_price) / sp.start_price * 100) : 0;
        const cls  = change > 0 ? 'text-success' : change < 0 ? 'text-danger' : 'text-muted';
        const icon = change > 0 ? '↑' : change < 0 ? '↓' : '→';
        return `<tr>
          <td class="fw-bold">${p.asset_symbol}</td>
          <td class="text-danger">₹${Number(p.end_price || 0).toLocaleString('en-IN')}</td>
          <td class="${cls}">${icon} ${change.toFixed(2)}%</td>
          <td class="text-muted small">${p.end_price_fetched_at ? new Date(p.end_price_fetched_at).toLocaleString() : 'N/A'}</td>
        </tr>`;
      }).join('')}
      </tbody>
    </table></div>` : '<div class="text-center p-3 text-muted">No end prices available</div>';

  return `
    <div class="alert alert-info mb-3">
      <strong>Session:</strong> ${sessionInfo.name || 'N/A'} &nbsp;|&nbsp;
      <strong>Status:</strong> <span class="badge bg-${sessionInfo.status === 'live' ? 'success' : 'secondary'}">${sessionInfo.status || 'N/A'}</span>
    </div>
    <div class="row">
      <div class="col-md-6">
        <div class="card border-success"><div class="card-header bg-success text-white"><h6 class="mb-0">Start Prices (${startPrices.length})</h6></div>
        <div class="card-body p-0">${startTable}</div></div>
      </div>
      <div class="col-md-6">
        <div class="card border-danger"><div class="card-header bg-danger text-white"><h6 class="mb-0">End Prices (${endPrices.length})</h6></div>
        <div class="card-body p-0">${endTable}</div></div>
      </div>
    </div>`;
}

// ── Load Transactions ──────────────────────────────────────────────────────
function loadTransactions() {
  document.getElementById('transactionsContainer').innerHTML = '<div class="text-center p-3"><div class="spinner-border text-warning"></div></div>';

  fetch('/api/performance/' + CONTEST_ID + '/transactions')
    .then(r => r.json())
    .then(data => {
      const txns = data.transactions || [];
      if (!txns.length) {
        document.getElementById('transactionsContainer').innerHTML = '<div class="text-center p-4 text-muted"><i class="bi bi-inbox display-4 d-block mb-2"></i>No transactions found for this contest.</div>';
        return;
      }
      let html = `<div class="table-responsive">
        <table class="table table-hover table-sm mb-0">
          <thead class="table-light">
            <tr><th>ID</th><th>User</th><th>Type</th><th>Amount</th><th>Status</th><th>Description</th><th>Date</th></tr>
          </thead><tbody>`;
      txns.forEach(t => {
        const typeBadge = t.type === 'winnings' ? 'bg-success' : t.type === 'contest_entry' ? 'bg-primary' : 'bg-secondary';
        const statusBadge = t.status === 'success' ? 'bg-success' : t.status === 'failed' ? 'bg-danger' : 'bg-warning';
        html += `<tr>
          <td class="fw-bold">#${t.old_id || t._id}</td>
          <td><div class="fw-semibold">${t.user_name || 'Unknown'}</div><small class="text-muted">${t.user_mobile || ''}</small></td>
          <td><span class="badge ${typeBadge}">${t.type}</span></td>
          <td class="${Number(t.amount) >= 0 ? 'text-success' : 'text-danger'} fw-bold">₹${Number(t.amount || 0).toLocaleString('en-IN')}</td>
          <td><span class="badge ${statusBadge}">${t.status}</span></td>
          <td class="small text-muted">${t.description || '—'}</td>
          <td class="small text-muted">${t.created_at ? new Date(t.created_at).toLocaleString('en-IN', {timeZone:'Asia/Kolkata'}) : '—'}</td>
        </tr>`;
      });
      html += '</tbody></table></div>';
      document.getElementById('transactionsContainer').innerHTML = html;
    })
    .catch(err => {
      document.getElementById('transactionsContainer').innerHTML = '<div class="alert alert-danger m-3"><i class="bi bi-exclamation-triangle me-2"></i>Failed to load transactions: ' + err.message + '</div>';
    });
}

// ── Load Participants ──────────────────────────────────────────────────────
function loadParticipants() {
  document.getElementById('participantsContainer').innerHTML = '<div class="text-center p-3"><div class="spinner-border text-primary"></div></div>';

  fetch('/api/performance/' + CONTEST_ID + '/participants')
    .then(r => r.json())
    .then(data => {
      const participants = data.participants || [];
      if (!participants.length) {
        document.getElementById('participantsContainer').innerHTML = '<div class="text-center p-4 text-muted"><i class="bi bi-people display-4 d-block mb-2"></i>No participants found.</div>';
        return;
      }
      let html = `<div class="table-responsive" style="max-height:500px;overflow-y:auto">
        <table class="table table-hover table-sm mb-0">
          <thead class="table-light sticky-top">
            <tr><th>Rank</th><th>User</th><th>Score</th><th>Prize</th><th>Status</th></tr>
          </thead><tbody>`;
      participants.forEach((p, i) => {
        const rank = i + 1;
        const isWinner = rank <= TOTAL_WINNERS;
        const prize = getPrizeForRank(rank);
        html += `<tr class="${isWinner ? 'table-success' : ''}">
          <td><span class="badge ${isWinner ? 'bg-success' : 'bg-secondary'}">${rank}</span>${isWinner ? '<br><small class="text-success">WINNER</small>' : ''}</td>
          <td><div class="fw-semibold">${p.user_name || 'User #' + p.user_id}</div><small class="text-muted">${p.user_mobile || ''}</small></td>
          <td><span class="fw-bold ${Number(p.total_score) >= 0 ? 'text-success' : 'text-danger'}">${Number(p.total_score || 0) >= 0 ? '+' : ''}${Number(p.total_score || 0).toFixed(2)}</span></td>
          <td>${isWinner ? '<span class="text-success fw-bold">₹' + Number(prize).toLocaleString('en-IN') + ' coins</span>' : '—'}</td>
          <td><span class="badge ${isWinner ? 'bg-success' : 'bg-secondary'}">${isWinner ? 'Winner' : 'Participant'}</span></td>
        </tr>`;
      });
      html += '</tbody></table></div>';
      document.getElementById('participantsContainer').innerHTML = html;
    })
    .catch(err => {
      document.getElementById('participantsContainer').innerHTML = '<div class="alert alert-danger m-3">Failed to load participants: ' + err.message + '</div>';
    });
}

function getPrizeForRank(rank) {
  for (const dist of FLEXIBLE_DIST) {
    const m = (dist.label || '').match(/Ranks?\s*(\d+)-?(\d+)?/i);
    if (m) {
      const s = parseInt(m[1]);
      const e = parseInt(m[2] || m[1]);
      if (rank >= s && rank <= e) return dist.perWinner || 0;
    }
  }
  return 0;
}
</script>

<script>
// PHP PARITY — RUN ALL, Calculate Results, Verify/Analyze prices (PHP performance/show.blade.php scripts)
(function () {
  var cid = <%- JSON.stringify(String(contest._id)) %>;
  var sid = <%- JSON.stringify(String(contest.session_id || '')) %>;
  var logUrl = '/api/run-all-log/' + cid;
  function esc(v) { return String(v == null ? '' : v).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
  function postJson(url, body) {
    return fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(body || {}) })
      .then(function (r) { return r.json(); });
  }

  // ── RUN ALL ──
  var runBtn = document.getElementById('runAllBtn');
  function running(on) {
    var b = document.getElementById('runAllStatusBadge'); if (b) b.style.display = on ? 'inline-block' : 'none';
    var s = document.getElementById('stopRunAllBtn'); if (s) s.style.display = on ? 'inline-block' : 'none';
    if (!runBtn) return;
    runBtn.disabled = on;
    runBtn.innerHTML = on ? '<span class="spinner-border spinner-border-sm me-1"></span>Running...' : '<i class="bi bi-lightning-charge-fill"></i> RUN ALL';
  }
  function logBox(lines, footer) {
    var d = document.getElementById('runAllLog');
    if (!d) {
      d = document.createElement('div');
      d.id = 'runAllLog';
      d.style.cssText = 'position:fixed;bottom:20px;right:20px;background:#1a1a2e;color:#00ff88;padding:15px 20px;border-radius:10px;z-index:9999;font-family:monospace;font-size:13px;max-width:420px;max-height:300px;overflow-y:auto;box-shadow:0 4px 20px rgba(0,0,0,0.5)';
      document.body.appendChild(d);
    }
    d.innerHTML = '<b>⚡ RUN ALL</b><br><hr style="border-color:#333">' + lines.map(esc).join('<br>') + (footer || '');
    d.scrollTop = d.scrollHeight;
  }
  function poll() {
    var iv = setInterval(function () {
      fetch(logUrl).then(function (r) { return r.json(); }).then(function (data) {
        if (data.log) logBox(data.log);
        if (data.status === 'done') {
          clearInterval(iv); running(false);
          logBox(data.log, '<br><b style="color:#ffff00">✅ ALL DONE!</b>');
          setTimeout(function () { location.reload(); }, 2500);
        } else if (data.status === 'failed' || data.status === 'not_started') {
          clearInterval(iv); running(false);
        }
      }).catch(function () {});
    }, 3000);
  }
  if (runBtn) runBtn.addEventListener('click', function () {
    var st = document.getElementById('runAllStartTime').value;
    var et = document.getElementById('runAllEndTime').value;
    if (!st || !et) { alert('Please enter both a start time and an end time'); return; }
    if (!confirm('RUN ALL from ' + st + ' to ' + et + ' (IST, today)?\n\nThe session goes live at the start time, and this contest\'s prizes are PAID at the end time.')) return;
    running(true);
    logBox(['Start: ' + st + ' | End: ' + et]);
    postJson('/api/run-all/' + cid, { start_time: st, end_time: et }).then(function (data) {
      if (data.success) { logBox(['Queued! Start: ' + data.start + ' End: ' + data.end, 'Polling...']); poll(); }
      else { logBox(['Error: ' + (data.message || 'Failed')]); running(false); }
    }).catch(function (e) { alert('Error: ' + e.message); running(false); });
  });
  var stopBtn = document.getElementById('stopRunAllBtn');
  if (stopBtn) stopBtn.addEventListener('click', function () {
    if (!confirm('Stop the RUN ALL job?')) return;
    stopBtn.disabled = true;
    postJson('/api/run-all-stop/' + cid).then(function (data) {
      if (data.success) {
        running(false);
        fetch(logUrl).then(function (r) { return r.json(); }).then(function (d) { logBox(d.log || [], '<br><b style="color:#ff4444">Stopped by admin.</b>'); });
      }
    }).finally(function () { stopBtn.disabled = false; });
  });
  document.addEventListener('DOMContentLoaded', function () {
    fetch(logUrl).then(function (r) { return r.json(); }).then(function (data) {
      if (data.status === 'running' || data.status === 'queued') { running(true); logBox(data.log || []); poll(); }
    }).catch(function () {});
  });

  // ── Calculate Results ──
  var calcBtn = document.getElementById('calculateResultsBtn');
  if (calcBtn) calcBtn.addEventListener('click', function () {
    if (!confirm('Recalculate contest results based on current start/end prices?\n\nIf the contest has not been calculated yet, winners are credited.')) return;
    calcBtn.disabled = true;
    calcBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Calculating...';
    postJson('/api/performance/' + cid + '/calculate-results').then(function (data) {
      if (data.success) { alert(data.message); location.reload(); } else { alert('Error: ' + (data.error || data.message)); }
    }).catch(function (e) { alert('Error: ' + e.message); })
      .finally(function () { calcBtn.disabled = false; calcBtn.innerHTML = '<i class="bi bi-calculator"></i> Calculate Results'; });
  });

  // ── Verify prices via API / Analyze price errors ──
  function withSpinner(btn, promise) {
    var original = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Working...';
    return promise.finally(function () { btn.disabled = false; btn.innerHTML = original; });
  }
  var verifyBtn = document.getElementById('verifyPricesBtn');
  if (verifyBtn) verifyBtn.addEventListener('click', function () {
    var box = document.getElementById('verificationContent');
    withSpinner(verifyBtn, postJson('/api/verify-historical-prices/' + sid).then(function (data) {
      if (!data.success) { box.innerHTML = '<div class="alert alert-danger">' + esc(data.error || 'Verification failed') + '</div>'; return; }
      var rows = data.verification_results.map(function (r) {
        var bad = !r.api_error && Math.abs(r.difference_percent) > 5;
        return '<tr class="' + (r.api_error ? 'table-secondary' : (bad ? 'table-danger' : 'table-success')) + '"><td><strong>' + esc(r.asset_symbol) + '</strong></td><td>' + esc(r.price_type) + '</td>'
          + '<td class="text-end">' + Number(r.our_price).toFixed(4) + '</td><td class="text-end">' + (r.api_price ? Number(r.api_price).toFixed(4) : '-') + '</td>'
          + '<td class="text-end">' + (r.api_error ? '-' : Number(r.difference_percent).toFixed(2) + '%') + '</td><td><small>' + esc(r.api_error || r.api_source) + '</small></td></tr>';
      }).join('');
      box.innerHTML = '<div class="table-responsive"><table class="table table-sm"><thead><tr><th>Asset</th><th>Type</th><th class="text-end">Our Price</th><th class="text-end">API Price</th><th class="text-end">Diff %</th><th>Source / Error</th></tr></thead><tbody>' + rows + '</tbody></table></div>';
    }).catch(function (e) { box.innerHTML = '<div class="alert alert-danger">' + esc(e.message) + '</div>'; }));
  });
  var analyzeBtn = document.getElementById('analyzeErrorsBtn');
  if (analyzeBtn) analyzeBtn.addEventListener('click', function () {
    var box = document.getElementById('errorAnalysisContent');
    withSpinner(analyzeBtn, postJson('/api/analyze-price-errors/' + sid).then(function (data) {
      if (!data.success) { box.innerHTML = '<div class="alert alert-danger">' + esc(data.error || 'Analysis failed') + '</div>'; return; }
      if (!data.analysis_results.length) { box.innerHTML = '<div class="alert alert-success">✅ No price errors detected.</div>'; return; }
      var tone = { critical: 'danger', data: 'danger', timing: 'warning', api: 'info' };
      box.innerHTML = data.analysis_results.map(function (e) {
        return '<div class="alert alert-' + (tone[e.error_category] || 'secondary') + '"><strong>' + esc(e.asset_symbol) + ' — ' + esc(e.price_type) + ': ' + esc(e.error_title) + '</strong>'
          + '<div class="small mt-1"><strong>Root cause:</strong> ' + esc(e.root_cause) + '<br><strong>Impact:</strong> ' + esc(e.impact_level) + '<br><strong>Details:</strong> ' + esc(e.technical_details) + '</div>'
          + '<ul class="small mb-0 mt-1">' + (e.solutions || []).map(function (x) { return '<li>' + esc(x) + '</li>'; }).join('') + '</ul></div>';
      }).join('');
    }).catch(function (e) { box.innerHTML = '<div class="alert alert-danger">' + esc(e.message) + '</div>'; }));
  });
})();
</script>
