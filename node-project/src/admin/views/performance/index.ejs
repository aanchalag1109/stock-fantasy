<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1"><i class="bi bi-graph-up-arrow text-primary me-2"></i>Performance - Sessions</h1>
            <p class="text-muted mb-0">Monitor and analyze session performance metrics</p>
        </div>
        <div>
            <select id="statusFilter" class="form-select">
                <option value="all">All Sessions</option>
                <option value="live">🔴 Live</option>
                <option value="upcoming">⏰ Upcoming</option>
                <option value="completed">✅ Completed</option>
            </select>
        </div>
    </div>
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0" id="sessionsTable">
                    <thead class="table-light">
                        <tr>
                            <th class="text-center">#</th>
                            <th><i class="bi bi-tag me-1"></i>Session Name</th>
                            <th class="text-center"><i class="bi bi-graph-up me-1"></i>Market</th>
                            <th class="text-center"><i class="bi bi-circle-fill me-1"></i>Status</th>
                            <th class="text-center"><i class="bi bi-play-circle me-1"></i>Start Time</th>
                            <th class="text-center"><i class="bi bi-stop-circle me-1"></i>End Time</th>
                            <th class="text-center"><i class="bi bi-gear me-1"></i>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <%
                          function clock(d) {
                            if (!d) return { date: '—', time: '' };
                            const parts = new Intl.DateTimeFormat('en-US', {
                              timeZone: 'Asia/Kolkata',
                              month: 'short', day: '2-digit', year: 'numeric',
                              hour: '2-digit', minute: '2-digit', hourCycle: 'h23',
                            }).formatToParts(new Date(d));
                            const get = (type) => (parts.find((part) => part.type === type) || {}).value || '';
                            return { date: get('month') + ' ' + get('day') + ', ' + get('year'), time: get('hour') + ':' + get('minute') };
                          }
                        %>
                        <% sessions.forEach(session => {
                            const start = clock(session.start_time);
                            const end = clock(session.end_time);
                            const market = session.market_type || 'stock';
                        %>
                        <tr data-status="<%= session.status %>" class="session-row">
                            <td class="text-center fw-bold text-primary"><%= session.old_id || session._id %></td>
                            <td class="fw-semibold"><%= session.name %></td>
                            <td class="text-center">
                                <span class="badge bg-dark">
                                    <i class="bi bi-<%= market === 'crypto' ? 'currency-bitcoin' : 'graph-up' %> me-1"></i>
                                    <%= market.charAt(0).toUpperCase() + market.slice(1) %>
                                </span>
                            </td>
                            <td class="text-center">
                                <% if (session.status === 'live') { %>
                                    <span class="badge bg-success pulse"><i class="bi bi-broadcast me-1"></i>Live</span>
                                <% } else if (session.status === 'upcoming') { %>
                                    <span class="badge bg-info"><i class="bi bi-clock me-1"></i>Upcoming</span>
                                <% } else if (session.status === 'completed') { %>
                                    <span class="badge bg-secondary"><i class="bi bi-check-circle me-1"></i>Completed</span>
                                <% } else { %>
                                    <span class="badge bg-light text-dark"><%= session.status ? session.status.charAt(0).toUpperCase() + session.status.slice(1) : '' %></span>
                                <% } %>
                            </td>
                            <td class="text-center text-muted"><small><%= start.date %></small><br><strong><%= start.time %></strong></td>
                            <td class="text-center text-muted"><small><%= end.date %></small><br><strong><%= end.time %></strong></td>
                            <td class="text-center">
                                <a href="/performance/session/<%= session._id %>" class="btn btn-primary btn-sm" target="_blank">
                                    <i class="bi bi-eye me-1"></i>View Details
                                </a>
                            </td>
                        </tr>
                        <% }) %>
                        <% if (!sessions.length) { %>
                        <tr><td colspan="7" class="text-center py-4 text-muted">No sessions found</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script>
document.getElementById('statusFilter').addEventListener('change', function () {
    const value = this.value;
    document.querySelectorAll('.session-row').forEach(row => {
        row.style.display = (value === 'all' || row.dataset.status === value) ? '' : 'none';
    });
});
</script>
<style>
.pulse { animation: pulse 2s infinite; }
@keyframes pulse { 0% { opacity: 1; } 50% { opacity: 0.7; } 100% { opacity: 1; } }
.session-row:hover { background-color: #f8f9fa; }
.table td { vertical-align: middle; }
</style>
