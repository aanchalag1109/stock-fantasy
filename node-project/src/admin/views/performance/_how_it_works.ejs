<%#
  PHP PARITY — "How It Works" modal from PHP admin/performance/show.blade.php (lines 200–1412):
  system status & error detection, step-by-step pool/prize calculation, prize breakdown,
  user-wise prizes, complete leaderboard, price timing validation, and the
  "Verify All Prices via API" / "Analyze Error Reasons" tools. Data: `diag` from
  services/performance-tools.service.js diagnostics().
%>
<%
  const n0 = (v) => Number(v || 0).toLocaleString('en-IN', { maximumFractionDigits: 0 });
  const n2 = (v) => Number(v || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const ist = (d) => d ? new Date(d).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', hour12: true }) : '—';
  const color = { error: 'danger', warning: 'warning', success: 'success' };
  const S = diag.steps;
%>
<div class="modal fade" id="workingModal" tabindex="-1">
  <div class="modal-dialog modal-xl">
    <div class="modal-content">
      <div class="modal-header bg-info text-white">
        <h5 class="modal-title"><i class="bi bi-gear-fill me-2"></i>Performance Page - Complete Working Guide</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" style="max-height:70vh; overflow-y:auto;">

        <div class="card border-primary mb-4">
          <div class="card-header bg-primary text-white"><h5 class="mb-0"><i class="bi bi-shield-check me-2"></i>System Status &amp; Error Detection</h5></div>
          <div class="card-body">
            <div class="row mb-3">
              <div class="col-md-4"><div class="alert <%= diag.errorCount ? 'alert-danger' : 'alert-success' %> text-center"><h6 class="mb-1"><%= diag.errorCount ? '❌ ' + diag.errorCount + ' Errors' : '✅ No Errors' %></h6><small>Critical issues that need fixing</small></div></div>
              <div class="col-md-4"><div class="alert <%= diag.warningCount ? 'alert-warning' : 'alert-success' %> text-center"><h6 class="mb-1"><%= diag.warningCount ? '⚠️ ' + diag.warningCount + ' Warnings' : '✅ No Warnings' %></h6><small>Issues that may need attention</small></div></div>
              <div class="col-md-4"><div class="alert <%= (diag.errorCount || diag.warningCount) ? 'alert-info' : 'alert-success' %> text-center"><h6 class="mb-1"><%= (diag.errorCount || diag.warningCount) ? '🔍 Review Needed' : '🎉 All Good' %></h6><small>Overall system status</small></div></div>
            </div>
            <div class="accordion" id="statusAccordion">
              <% diag.checks.forEach((c, i) => { %>
              <div class="accordion-item">
                <h2 class="accordion-header"><button class="accordion-button collapsed bg-<%= color[c.type] %> <%= c.type === 'warning' ? 'text-dark' : 'text-white' %>" type="button" data-bs-toggle="collapse" data-bs-target="#check<%= i %>"><i class="bi bi-<%= c.type === 'error' ? 'x-circle' : (c.type === 'warning' ? 'exclamation-triangle' : 'check-circle') %> me-2"></i><%= c.title %></button></h2>
                <div id="check<%= i %>" class="accordion-collapse collapse" data-bs-parent="#statusAccordion"><div class="accordion-body">
                  <p class="mb-2"><strong>Details:</strong> <%= c.message %></p>
                  <% if (c.type === 'error') { %><div class="alert alert-danger mb-0"><strong>Action Required:</strong> This error may cause incorrect calculations or system malfunction.</div><% } %>
                  <% if (c.type === 'warning') { %><div class="alert alert-warning mb-0"><strong>Recommendation:</strong> Review this issue to ensure optimal performance.</div><% } %>
                </div></div>
              </div>
              <% }) %>
            </div>
          </div>
        </div>

        <div class="card border-success mb-4">
          <div class="card-header bg-success text-white"><h5 class="mb-0"><i class="bi bi-calculator me-2"></i>Step-by-Step Real Calculation</h5></div>
          <div class="card-body"><div class="row g-3">
            <div class="col-md-6"><div class="p-3 bg-light rounded"><h6>📊 STEP 1: Basic Data Collection</h6>Participants <strong><%= S.participants %></strong> · Entry Fee <strong><%= S.entryFee %></strong> · Platform Fee <strong><%= S.platformPct %>%</strong> · Winning <strong><%= S.winningPct %>%</strong></div></div>
            <div class="col-md-6"><div class="p-3 bg-light rounded"><h6>💰 STEP 2: Pool Calculation</h6><code>Total Pool = Participants × Entry Fee</code><br><%= S.participants %> × <%= S.entryFee %> = <strong class="text-success"><%= n0(S.totalPool) %> coins</strong></div></div>
            <div class="col-md-6"><div class="p-3 bg-light rounded"><h6>🏦 STEP 3: Platform Fee Deduction</h6><code>Platform Fee = Total Pool × Platform Fee %</code><br><%= n0(S.totalPool) %> × <%= S.platformPct %>% = <strong class="text-danger"><%= n0(S.platformFee) %> coins</strong></div></div>
            <div class="col-md-6"><div class="p-3 bg-light rounded"><h6>🎁 STEP 4: Prize Pool Calculation</h6><code>Prize Pool = Total Pool - Platform Fee</code><br><%= n0(S.totalPool) %> - <%= n0(S.platformFee) %> = <strong class="text-success"><%= n0(S.prizePool) %> coins</strong></div></div>
            <div class="col-md-6"><div class="p-3 bg-light rounded"><h6>🏆 STEP 5: Winners Count</h6><code>Winners = Participants × Winning %</code><br><%= S.participants %> × <%= S.winningPct %>% = <strong class="text-primary"><%= S.totalWinners %> winners</strong></div></div>
            <div class="col-md-6"><div class="p-3 bg-light rounded"><h6>📈 STEP 6: Final Summary</h6>Total Collected <strong><%= n0(S.totalPool) %></strong> · Platform Keeps <strong><%= n0(S.platformFee) %></strong> · Prize Distribution <strong><%= n0(S.prizePool) %></strong> · Winners <strong><%= S.totalWinners %> users</strong></div></div>
          </div></div>
        </div>

        <% if (flexibleDistribution && flexibleDistribution.length) { %>
        <div class="card border-warning mb-4">
          <div class="card-header bg-warning text-dark"><h5 class="mb-0"><i class="bi bi-trophy me-2"></i>STEP 7: Prize Distribution Breakdown</h5></div>
          <div class="card-body">
            <div class="alert alert-info"><strong>Total Prize Pool:</strong> <%= n0(S.prizePool) %> coins will be distributed among <%= S.totalWinners %> winners</div>
            <div class="row">
              <% flexibleDistribution.forEach(d => { %>
              <div class="col-md-6 mb-2"><div class="p-2 border rounded d-flex justify-content-between"><span><span class="badge bg-dark"><%= d.label %></span> <small><%= d.winners %> winners · <%= d.percent %>% of <%= n0(S.prizePool) %></small></span><strong><%= n0(d.perWinner) %> coins</strong></div></div>
              <% }) %>
            </div>
            <div class="alert alert-success mt-2 mb-0"><strong>Verification:</strong> Total distributed = <%= n0(diag.distributed) %> coins (<%= diag.distributed <= S.prizePool ? '✅ Within budget' : '❌ Exceeds budget' %>)</div>
          </div>
        </div>
        <% } %>

        <div class="card border-info mb-4">
          <div class="card-header bg-info text-white"><h5 class="mb-0"><i class="bi bi-people me-2"></i>STEP 8: User-wise Prize Calculation</h5></div>
          <div class="card-body">
            <div class="row mb-3">
              <div class="col-md-4"><div class="alert alert-success text-center mb-0"><h6 class="mb-1">Total Winners</h6><h4 class="mb-0"><%= diag.winners.length %></h4></div></div>
              <div class="col-md-4"><div class="alert alert-warning text-center mb-0"><h6 class="mb-1">Prize Distributed</h6><h4 class="mb-0"><%= n0(diag.winnersTotal) %></h4></div></div>
              <div class="col-md-4"><div class="alert alert-info text-center mb-0"><h6 class="mb-1">Remaining Pool</h6><h4 class="mb-0"><%= n0(S.prizePool - diag.winnersTotal) %></h4></div></div>
            </div>
            <% if (diag.winners.length) { %>
            <div class="table-responsive" style="max-height:400px;overflow-y:auto;"><table class="table table-hover table-sm">
              <thead class="sticky-top bg-light"><tr><th>Rank</th><th>User Details</th><th>Score</th><th>Prize Group</th><th class="text-end">Prize Amount</th></tr></thead>
              <tbody><% diag.winners.forEach(w => { %><tr><td><span class="badge bg-primary"><%= w.rank %></span></td><td><div class="fw-bold"><%= w.user_name %></div><small class="text-muted"><%= w.user_mobile %></small><br><small class="text-info">ID: <%= w.user_id %></small></td><td class="<%= w.score >= 0 ? 'text-success' : 'text-danger' %> fw-bold"><%= n2(w.score) %></td><td><span class="badge bg-secondary"><%= w.prize_group %></span></td><td class="text-end fw-bold text-success"><%= n0(w.prize) %> coins</td></tr><% }) %></tbody>
            </table></div>
            <div class="alert alert-info mt-3 mb-0"><ol class="mb-0"><li><strong>Ranking:</strong> Users sorted by total score (highest first)</li><li><strong>Tie Handling:</strong> Same score = same rank</li><li><strong>Prize Groups:</strong> Each rank falls into a prize group</li><li><strong>Distribution:</strong> Only winners (top <%= S.totalWinners %> users) get prizes</li></ol></div>
            <% } else { %><div class="alert alert-warning mb-0">No winners found. Either no participants or prize structure not configured.</div><% } %>
          </div>
        </div>

        <div class="card border-success mb-4">
          <div class="card-header bg-success text-white"><h5 class="mb-0"><i class="bi bi-list-ol me-2"></i>STEP 9: Complete Leaderboard</h5></div>
          <div class="card-body">
            <% if (diag.leaderboard.length) { %>
            <div class="alert alert-info"><strong>Total Participants:</strong> <%= diag.leaderboard.length %> users joined this contest</div>
            <div class="table-responsive" style="max-height:400px;overflow-y:auto;"><table class="table table-hover table-sm">
              <thead class="sticky-top bg-light"><tr><th>Rank</th><th>User Details</th><th>Score</th><th>Wallet (Winnings)</th><th>Status</th></tr></thead>
              <tbody><% diag.leaderboard.forEach(p => { %><tr class="<%= p.winner ? 'table-success' : '' %>"><td><span class="badge <%= p.winner ? 'bg-success' : 'bg-secondary' %>"><%= p.rank %></span></td><td><div class="fw-bold"><%= p.user_name %></div><small class="text-muted"><%= p.user_mobile %></small></td><td class="fw-bold <%= p.score >= 0 ? 'text-success' : 'text-danger' %>"><%= p.score >= 0 ? '+' : '' %><%= n2(p.score) %></td><td><%= n2(p.winnings_balance) %></td><td><span class="badge <%= p.winner ? 'bg-success' : 'bg-secondary' %>"><%= p.winner ? 'Winner' : 'Participant' %></span></td></tr><% }) %></tbody>
            </table></div>
            <% } else { %><div class="alert alert-warning mb-0">No participants found in this contest.</div><% } %>
          </div>
        </div>

        <div class="card border-warning mb-4">
          <div class="card-header bg-warning text-dark"><h5 class="mb-0"><i class="bi bi-graph-up me-2"></i>STEP 10: Asset Prices (Start vs End) with Time Validation</h5></div>
          <div class="card-body">
            <% if (session) { %>
            <div class="alert alert-info"><strong>Session Start:</strong> <%= ist(session.start_time) %> · <strong>Session End:</strong> <%= ist(session.end_time) %> · <strong>Status:</strong> <span class="badge bg-secondary"><%= String(session.status || '').toUpperCase() %></span></div>
            <% } %>
            <div class="row mb-3">
              <div class="col-md-3"><div class="alert <%= diag.timingErrors ? 'alert-danger' : 'alert-success' %> text-center mb-0"><h6 class="mb-0"><%= diag.timingErrors ? '❌ ' + diag.timingErrors + ' Timing Errors' : '✅ No Timing Errors' %></h6></div></div>
              <div class="col-md-3"><div class="alert <%= diag.timingWarnings ? 'alert-warning' : 'alert-success' %> text-center mb-0"><h6 class="mb-0"><%= diag.timingWarnings ? '⚠️ ' + diag.timingWarnings + ' Warnings' : '✅ No Warnings' %></h6></div></div>
              <div class="col-md-3"><div class="alert alert-info text-center mb-0"><h6 class="mb-0">📊 Start Prices: <%= diag.prices.filter(p => p.start != null).length %></h6></div></div>
              <div class="col-md-3"><div class="alert alert-success text-center mb-0"><h6 class="mb-0">🏁 End Prices: <%= diag.prices.filter(p => p.end != null).length %></h6></div></div>
            </div>
            <% if (diag.timings.length) { %>
            <div class="table-responsive mb-3" style="max-height:300px;overflow-y:auto;"><table class="table table-hover table-sm">
              <thead class="sticky-top bg-light"><tr><th>Asset</th><th>Price Type</th><th>Expected Time</th><th>Actual Time</th><th>Difference</th><th>Message</th></tr></thead>
              <tbody><% diag.timings.forEach(t => { %><tr class="table-<%= color[t.type] %>"><td><strong><%= t.asset %></strong></td><td><%= t.price_type %></td><td><small><%= ist(t.expected_time) %></small></td><td><small><%= ist(t.actual_time) %></small></td><td><span class="badge bg-<%= color[t.type] %>"><%= t.difference %></span></td><td><small><%= t.message %></small></td></tr><% }) %></tbody>
            </table></div>
            <% } %>
            <% if (diag.prices.length) { %>
            <div class="table-responsive mb-3" style="max-height:400px;overflow-y:auto;"><table class="table table-hover table-sm mb-0">
              <thead class="sticky-top bg-light"><tr><th>Asset</th><th class="text-end">Start Price</th><th>Start Time</th><th class="text-end">End Price</th><th>End Time</th><th class="text-end">Change %</th></tr></thead>
              <tbody><% diag.prices.forEach(p => { const pct = p.start && p.end ? ((p.end - p.start) / p.start) * 100 : null; %><tr><td><strong><%= p.symbol %></strong></td><td class="text-end"><%- p.start != null ? n2(p.start) : '<span class="badge bg-danger">Missing</span>' %></td><td><small><%= ist(p.start_at) %></small></td><td class="text-end"><%- p.end != null ? n2(p.end) : '<span class="text-muted">Pending</span>' %></td><td><small><%= ist(p.end_at) %></small></td><td class="text-end fw-bold <%= pct == null ? '' : (pct >= 0 ? 'text-success' : 'text-danger') %>"><%= pct == null ? '-' : (pct >= 0 ? '▲ ' : '▼ ') + Math.abs(pct).toFixed(2) + '%' %></td></tr><% }) %></tbody>
            </table></div>
            <% } %>

            <div class="card border-info mb-3">
              <div class="card-header bg-info text-white"><h6 class="mb-0"><i class="bi bi-search me-2"></i>Historical Price Verification via API</h6></div>
              <div class="card-body">
                <p class="mb-2 small">Compares saved prices with prices from external APIs (each result shows its source; most sources give the current price).</p>
                <button class="btn btn-primary btn-sm" id="verifyPricesBtn">🔍 Verify All Prices via API</button>
                <button class="btn btn-secondary btn-sm ms-2" onclick="document.getElementById('verificationContent').innerHTML=''">🗑️ Clear Results</button>
                <div id="verificationContent" class="mt-3"></div>
              </div>
            </div>
            <div class="card border-danger">
              <div class="card-header bg-danger text-white"><h6 class="mb-0"><i class="bi bi-bug me-2"></i>Price Error Analysis &amp; Root Cause Detection</h6></div>
              <div class="card-body">
                <p class="mb-2 small">Analyzes why prices might be incorrect and identifies the root cause.</p>
                <button class="btn btn-danger btn-sm" id="analyzeErrorsBtn">🔍 Analyze Error Reasons</button>
                <button class="btn btn-secondary btn-sm ms-2" onclick="document.getElementById('errorAnalysisContent').innerHTML=''">🗑️ Clear Analysis</button>
                <div id="errorAnalysisContent" class="mt-3"></div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>
