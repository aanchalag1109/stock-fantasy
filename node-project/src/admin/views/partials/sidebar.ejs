<%# NEW IMPLEMENTATION — NODE.JS PROJECT: Admin User Access Control — links are shown only when can() allows the module. %>
<%
  function on(prefix) {
    if (prefix === '/dashboard') return currentPath === '/dashboard' || currentPath === '/';
    if (prefix === '/testing/test-users') return currentPath === '/testing/test-users';
    if (prefix === '/testing/my-game') return currentPath === '/testing/my-game' || currentPath.startsWith('/testing/session/') || currentPath.startsWith('/testing/contest/');
    if (prefix === '/testing') return currentPath === '/testing' || currentPath.startsWith('/testing/');
    return currentPath === prefix || currentPath.startsWith(prefix + '/');
  }
%>
<div class="sidebar text-white d-flex flex-column d-lg-block" :class="{ 'open': sidebarOpen, 'd-none': !sidebarOpen && window.innerWidth < 992 }" style="width: 250px; z-index: 1040;">
  <div class="sidebar-logo">
    <img src="/logo.png" alt="Logo" style="height: 80px;">
  </div>
  <div class="sidebar-divider"></div>
  <nav class="flex-grow-1 overflow-y-auto py-2">
    <div class="sidebar-section">Main</div>
    <ul class="nav flex-column px-2">
      <% if (can('dashboard.view')) { %>
      <li class="nav-item">
        <a href="/dashboard" class="sidebar-link <%= on('/dashboard') ? 'active' : '' %>">
          <i class="bi bi-speedometer2"></i> Dashboard
        </a>
      </li>
      <% } %>
      <% if (can('sessions.view')) { %>
      <li class="nav-item">
        <a href="/league_sessions" class="sidebar-link <%= (on('/league_sessions') || on('/sessions')) ? 'active' : '' %>">
          <i class="bi bi-calendar2-week"></i> Leagues/Sessions
        </a>
      </li>
      <% } %>
      <% if (can('templates.view')) { %>
      <li class="nav-item">
        <a href="/templates" class="sidebar-link <%= on('/templates') ? 'active' : '' %>">
          <i class="bi bi-bookmark"></i> Saved Templates
        </a>
      </li>
      <% } %>
      <% if (can('performance.view')) { %>
      <li class="nav-item">
        <a href="/performance" class="sidebar-link <%= on('/performance') ? 'active' : '' %>">
          <i class="bi bi-graph-up-arrow"></i> Performance
        </a>
      </li>
      <% } %>
      <% if (can('contest_analysis.view')) { %>
      <li class="nav-item">
        <a href="/contest-analysis" class="sidebar-link <%= on('/contest-analysis') ? 'active' : '' %>">
          <i class="bi bi-bar-chart-line"></i> Contest Analysis
        </a>
      </li>
      <% } %>
      <% if (can('announcements.view')) { %>
      <li class="nav-item">
        <a href="/announcements" class="sidebar-link <%= on('/announcements') ? 'active' : '' %>">
          <i class="bi bi-megaphone"></i> Announcements
        </a>
      </li>
      <% } %>
      <% if (can('market_categories.view')) { %>
      <li class="nav-item">
        <a href="/market_type_categories" class="sidebar-link <%= on('/market_type_categories') ? 'active' : '' %>">
          <i class="bi bi-tags"></i> Market Type Category
        </a>
      </li>
      <% } %>
      <% if (can('users.view')) { %>
      <li class="nav-item">
        <a href="/users" class="sidebar-link <%= on('/users') ? 'active' : '' %>">
          <i class="bi bi-people"></i> Players
        </a>
      </li>
      <% } %>
      <% if (can('contests.view')) { %>
      <li class="nav-item">
        <a href="/contests" class="sidebar-link <%= on('/contests') ? 'active' : '' %>">
          <i class="bi bi-trophy"></i> Contests
        </a>
      </li>
      <% } %>
      <% if (can('live_management.view')) { %>
      <li class="nav-item">
        <a href="/live-management" class="sidebar-link <%= on('/live-management') ? 'active' : '' %>">
          <i class="bi bi-broadcast-pin"></i> Live Management
          <span class="badge bg-danger ms-auto" id="liveContestCount">0</span>
        </a>
      </li>
      <% } %>
      <% if (can('cron.view')) { %>
      <li class="nav-item">
        <a href="/cron-logs" class="sidebar-link <%= (on('/cron-logs') || on('/cron')) ? 'active' : '' %>">
          <i class="bi bi-clock-history"></i> Cron Check
        </a>
      </li>
      <% } %>
      <% if (can('transactions.view')) { %>
      <li class="nav-item">
        <a href="/transactions" class="sidebar-link <%= on('/transactions') ? 'active' : '' %>">
          <i class="bi bi-arrow-left-right"></i> Transactions
        </a>
      </li>
      <% } %>
      <% if (can('pending_prizes.view')) { %>
      <li class="nav-item">
        <a href="/pending-prizes" class="sidebar-link <%= on('/pending-prizes') ? 'active' : '' %>">
          <i class="bi bi-trophy text-warning"></i> Pending Prizes
        </a>
      </li>
      <% } %>
      <% if (can('payments.view')) { %>
      <li class="nav-item">
        <a href="/payments" class="sidebar-link <%= on('/payments') ? 'active' : '' %>">
          <i class="bi bi-credit-card"></i> Payment Orders
        </a>
      </li>
      <% } %>
    </ul>
    <div class="sidebar-divider"></div>
    <div class="sidebar-section">Other</div>
    <ul class="nav flex-column px-2">
      <% if (can('banners.view')) { %>
      <li class="nav-item">
        <a href="/banners" class="sidebar-link <%= on('/banners') ? 'active' : '' %>">
          <i class="bi bi-image"></i> Manage Banners
        </a>
      </li>
      <% } %>
      <% if (can('withdrawals.view')) { %>
      <li class="nav-item">
        <a href="/withdrawal_requests" class="sidebar-link <%= (on('/withdrawal_requests') || on('/withdrawals')) ? 'active' : '' %>">
          <i class="bi bi-cash-coin"></i> Withdrawal Requests
        </a>
      </li>
      <% } %>
      <%# NEW IMPLEMENTATION (node-project only, not converted from PHP): Deposit and Withdrawal Settings Module %>
      <% if (can('deposit_withdrawal_settings.view')) { %>
      <li class="nav-item">
        <a href="/deposit-withdrawal-settings" class="sidebar-link <%= on('/deposit-withdrawal-settings') ? 'active' : '' %>">
          <i class="bi bi-sliders"></i> Deposit &amp; Withdrawal Settings
        </a>
      </li>
      <% } %>
      <%# NEW IMPLEMENTATION — NODE.JS PROJECT: USDT/INR to ProbCoin Conversion Settings %>
      <% if (can('probcoin_conversion.view')) { %>
      <li class="nav-item">
        <a href="/probcoin-conversion" class="sidebar-link <%= on('/probcoin-conversion') ? 'active' : '' %>">
          <i class="bi bi-currency-exchange"></i> ProbCoin Conversion
        </a>
      </li>
      <% } %>
      <%# NEW IMPLEMENTATION — NODE.JS PROJECT: Automated Notifications and Notification Management %>
      <% if (can('notification_settings.view')) { %>
      <li class="nav-item">
        <a href="/notification-settings" class="sidebar-link <%= on('/notification-settings') ? 'active' : '' %>">
          <i class="bi bi-bell"></i> Notification Settings
        </a>
      </li>
      <% } %>
      <%# NEW IMPLEMENTATION — NODE.JS PROJECT: Admin-Controlled Android Force Update System %>
      <% if (can('app_update_settings.view')) { %>
      <li class="nav-item">
        <a href="/android-app-update" class="sidebar-link <%= on('/android-app-update') ? 'active' : '' %>">
          <i class="bi bi-phone"></i> Android App Update
        </a>
      </li>
      <%# NEW IMPLEMENTATION — NODE.JS PROJECT: Admin-Controlled iOS Force Update System %>
      <li class="nav-item">
        <a href="/ios-app-update" class="sidebar-link <%= on('/ios-app-update') ? 'active' : '' %>">
          <i class="bi bi-apple"></i> iOS App Update
        </a>
      </li>
      <% } %>
      <% if (can('live_price_feeds.view')) { %>
      <li class="nav-item">
        <a href="/live-price-feeds" class="sidebar-link <%= on('/live-price-feeds') ? 'active' : '' %>">
          <i class="bi bi-graph-up"></i> Live Price Feeds
        </a>
      </li>
      <% } %>
      <% if (can('testing.view')) { %>
      <li class="nav-item">
        <a href="/testing/test-users" class="sidebar-link <%= on('/testing/test-users') ? 'active' : '' %>">
          <i class="bi bi-bug"></i> Test Users
        </a>
      </li>
      <% } %>
      <% if (can('testing.view')) { %>
      <li class="nav-item">
        <a href="/testing/my-game" class="sidebar-link <%= on('/testing') ? 'active' : '' %>">
          <i class="bi bi-bug"></i> Testing
        </a>
      </li>
      <% } %>
    </ul>
    <%# NEW IMPLEMENTATION — NODE.JS PROJECT: Admin User Access Control (super admin only) %>
    <% if (isSuperAdmin) { %>
    <div class="sidebar-divider"></div>
    <div class="sidebar-section">Admin Access</div>
    <ul class="nav flex-column px-2">
      <li class="nav-item">
        <a href="/admin-users" class="sidebar-link <%= on('/admin-users') ? 'active' : '' %>">
          <i class="bi bi-person-badge"></i> Admin Users
        </a>
      </li>
      <li class="nav-item">
        <a href="/admin-roles" class="sidebar-link <%= on('/admin-roles') ? 'active' : '' %>">
          <i class="bi bi-shield-lock"></i> Roles &amp; Permissions
        </a>
      </li>
    </ul>
    <% } %>
  </nav>
  <div class="sidebar-divider"></div>
  <div class="px-3 pb-3">
    <form action="/logout" method="POST" class="w-100">
      <button type="submit" class="btn btn-outline-light w-100">
        <i class="bi bi-box-arrow-right me-2"></i> Logout
      </button>
    </form>
  </div>
</div>
