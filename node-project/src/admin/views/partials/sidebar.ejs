<%# NEW IMPLEMENTATION — NODE.JS PROJECT: Admin User Access Control — links are shown only when can() allows the module. %>
<%# NEW IMPLEMENTATION — NODE.JS PROJECT: client feedback — tabs grouped into sections, renamed, and a Back button added. %>
<%
  function on(prefix) {
    if (prefix === '/dashboard') return currentPath === '/dashboard' || currentPath === '/';
    if (prefix === '/testing/test-users') return currentPath === '/testing/test-users';
    if (prefix === '/testing/my-game') return currentPath === '/testing/my-game' || currentPath.startsWith('/testing/session/') || currentPath.startsWith('/testing/contest/');
    if (prefix === '/testing') return currentPath === '/testing' || currentPath.startsWith('/testing/');
    return currentPath === prefix || currentPath.startsWith(prefix + '/');
  }

  // A section's heading is shown only when the admin can open at least one of its links.
  const sections = [
    { title: 'Main', items: [
      { show: can('dashboard.view'), href: '/dashboard', icon: 'bi-speedometer2', label: 'Dashboard', active: on('/dashboard') },
      { show: can('live_management.view'), href: '/live-management', icon: 'bi-broadcast-pin', label: 'Live Management', active: on('/live-management'), liveBadge: true },
    ] },
    { title: 'Sessions & Contests', items: [
      { show: can('sessions.view'), href: '/league_sessions', icon: 'bi-calendar2-week', label: 'Leagues / Sessions', active: on('/league_sessions') || on('/sessions') },
      { show: can('contests.view'), href: '/contests', icon: 'bi-trophy', label: 'Contests', active: on('/contests') },
      { show: can('templates.view'), href: '/templates', icon: 'bi-bookmark', label: 'Saved Templates', active: on('/templates') },
      { show: can('market_categories.view'), href: '/market_type_categories', icon: 'bi-tags', label: 'Market Categories', active: on('/market_type_categories') },
      { show: can('assets.view'), href: '/market-assets', icon: 'bi-list-columns', label: 'Assets', active: on('/market-assets') },
    ] },
    { title: 'Banners & Notifications', items: [
      { show: can('banners.view'), href: '/banners', icon: 'bi-image', label: 'Banners', active: on('/banners') },
      { show: can('announcements.view'), href: '/announcements', icon: 'bi-megaphone', label: 'Announcements', active: on('/announcements') },
      { show: can('notification_settings.view'), href: '/notification-settings', icon: 'bi-bell', label: 'Notification Settings', active: on('/notification-settings') },
    ] },
    { title: 'Payments & Transactions', items: [
      { show: can('payments.view'), href: '/payments', icon: 'bi-credit-card', label: 'Deposit Orders', active: on('/payments') },
      { show: can('withdrawals.view'), href: '/withdrawal_requests', icon: 'bi-cash-coin', label: 'Withdrawal Requests', active: on('/withdrawal_requests') || on('/withdrawals') },
      { show: can('transactions.view'), href: '/transactions', icon: 'bi-arrow-left-right', label: 'Transactions', active: on('/transactions') },
      { show: can('pending_prizes.view'), href: '/pending-prizes', icon: 'bi-gift', label: 'Pending Prizes', active: on('/pending-prizes') },
      { show: can('deposit_withdrawal_settings.view'), href: '/deposit-withdrawal-settings', icon: 'bi-sliders', label: 'Deposit &amp; Withdrawal Settings', active: on('/deposit-withdrawal-settings') },
      { show: can('probcoin_conversion.view'), href: '/probcoin-conversion', icon: 'bi-currency-exchange', label: 'ProbCoin Conversion', active: on('/probcoin-conversion') },
    ] },
    { title: 'Analytics', items: [
      { show: can('performance.view'), href: '/performance', icon: 'bi-graph-up-arrow', label: 'Performance', active: on('/performance') },
      { show: can('contest_analysis.view'), href: '/contest-analysis', icon: 'bi-bar-chart-line', label: 'Contest Analysis', active: on('/contest-analysis') },
      { show: can('live_price_feeds.view'), href: '/live-price-feeds', icon: 'bi-graph-up', label: 'Live Price Feeds', active: on('/live-price-feeds') },
    ] },
    { title: 'Bots', items: [
      { show: can('testing.view'), href: '/testing/test-users', icon: 'bi-robot', label: 'Bot Users', active: on('/testing/test-users') },
      { show: can('testing.view'), href: '/testing/my-game', icon: 'bi-joystick', label: 'Bot Contests', active: on('/testing') && !on('/testing/test-users') },
    ] },
    { title: 'Users & Admin Management', items: [
      { show: can('users.view'), href: '/users', icon: 'bi-people', label: 'Players', active: on('/users') },
      { show: isSuperAdmin, href: '/admin-users', icon: 'bi-person-badge', label: 'Admin Users', active: on('/admin-users') },
      { show: isSuperAdmin, href: '/admin-roles', icon: 'bi-shield-lock', label: 'Roles &amp; Permissions', active: on('/admin-roles') },
    ] },
    { title: 'App & System', items: [
      { show: can('app_update_settings.view'), href: '/android-app-update', icon: 'bi-phone', label: 'Android App Update', active: on('/android-app-update') },
      { show: can('app_update_settings.view'), href: '/ios-app-update', icon: 'bi-apple', label: 'iOS App Update', active: on('/ios-app-update') },
      { show: can('cron.view'), href: '/cron-logs', icon: 'bi-clock-history', label: 'Cron Check', active: on('/cron-logs') || on('/cron') },
    ] },
  ];
  const isHome = on('/dashboard');
%>
<div class="sidebar text-white d-flex flex-column d-lg-block" :class="{ 'open': sidebarOpen, 'd-none': !sidebarOpen && window.innerWidth < 992 }" style="width: 250px; z-index: 1040;">
  <div class="sidebar-logo">
    <img src="/logo.png" alt="Logo" style="height: 80px;">
  </div>
  <div class="sidebar-divider"></div>
  <nav class="flex-grow-1 overflow-y-auto py-2">
    <% if (!isHome) { %>
    <ul class="nav flex-column px-2 mb-0">
      <li class="nav-item">
        <a href="/dashboard" class="sidebar-link sidebar-back" onclick="if (history.length > 1 && document.referrer.indexOf(location.host) !== -1) { history.back(); return false; }">
          <i class="bi bi-arrow-left"></i> Back
        </a>
      </li>
    </ul>
    <% } %>
    <% sections.forEach(function (section, i) { const items = section.items.filter(function (it) { return it.show; }); if (!items.length) return; %>
    <div class="sidebar-section"><%= section.title %></div>
    <ul class="nav flex-column px-2">
      <% items.forEach(function (it) { %>
      <li class="nav-item">
        <a href="<%= it.href %>" class="sidebar-link <%= it.active ? 'active' : '' %>">
          <i class="bi <%= it.icon %>"></i> <%- it.label %>
          <% if (it.liveBadge) { %><span class="badge bg-danger ms-auto" id="liveContestCount">0</span><% } %>
        </a>
      </li>
      <% }) %>
    </ul>
    <% }) %>
  </nav>
  <div class="sidebar-divider"></div>
  <div class="px-3 pb-3">
    <form action="/logout" method="POST" class="w-100">
      <button type="submit" class="btn btn-outline-light w-100">
        <i class="bi bi-box-arrow-right me-2"></i> Logout
      </button>
    </form>
  </div>
</div>
