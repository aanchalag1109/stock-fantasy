<%#
  NEW IMPLEMENTATION — NODE.JS PROJECT

  Feature: Fantasy Contest Formats — admin Contest Settings page
  Purpose: Default platform fee % per contest type and automatic result declaration.
  Origin: Newly implemented in node-project; not directly converted
           from the original PHP implementation.
%>
<% const canEdit = can('contest_settings.edit'); %>
<div class="container-fluid">
    <div class="mb-4">
        <h1 class="h3 mb-1"><i class="bi bi-trophy text-warning me-2"></i>Contest Settings</h1>
        <p class="text-muted mb-0">Defaults for new contests and how results are declared when a session ends.</p>
    </div>

    <form action="/contest-settings" method="POST" novalidate>
        <fieldset <%= canEdit ? '' : 'disabled' %>>
        <% if (!canEdit) { %><div class="alert alert-info small py-2">You can view these settings but not change them.</div><% } %>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-warning text-white"><h2 class="h6 mb-0 text-white"><i class="bi bi-flag-fill me-2"></i>Result declaration</h2></div>
            <div class="card-body">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="auto_declare_results" name="auto_declare_results" value="1" <%= values.auto_declare_results ? 'checked' : '' %>>
                    <label class="form-check-label fw-semibold" for="auto_declare_results">Declare results and pay prizes automatically when a session ends</label>
                </div>
                <div class="form-text">
                    About 2 minutes after a session's end prices are captured, each contest is scored, ranked and its prizes are credited to winners' wallets (winners are notified).
                    Contests with fewer players than their minimum are cancelled and refunded either way.
                    When off, prizes wait on <a href="/pending-prizes">Pending Prizes</a> for an admin to pay.
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-dark text-white"><h2 class="h6 mb-0 text-white"><i class="bi bi-percent me-2"></i>Default platform fee by contest type</h2></div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light"><tr><th>Contest type</th><th>How it works</th><th style="width:200px">Platform fee %</th></tr></thead>
                        <tbody>
                            <% types.forEach(function (t) { const key = 'platform_fee.' + t[0]; %>
                            <tr>
                                <td class="fw-semibold"><label for="fee_<%= t[0] %>" class="mb-0"><%= t[1] %></label></td>
                                <td class="small text-muted"><%= t[2] %></td>
                                <td>
                                    <div class="input-group input-group-sm">
                                        <input type="number" class="form-control <%= errors[key] ? 'is-invalid' : '' %>" id="fee_<%= t[0] %>" name="platform_fee[<%= t[0] %>]"
                                               value="<%= values.platform_fee[t[0]] %>" min="0" max="100" step="0.01" required>
                                        <span class="input-group-text">%</span>
                                        <div class="invalid-feedback"><%= errors[key] %></div>
                                    </div>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer bg-white small text-muted">
                Pre-filled when an admin picks the type on <a href="/contests/create">Create Contest</a>; each contest can still use its own fee. Changing a default does not change existing contests.
            </div>
        </div>
        </fieldset>

        <% if (canEdit) { %>
        <div class="text-end mb-5">
            <button type="submit" class="btn btn-warning"><i class="bi bi-save me-1"></i>Save Settings</button>
        </div>
        <% } %>
    </form>
</div>
