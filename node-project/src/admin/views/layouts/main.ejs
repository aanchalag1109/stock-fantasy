<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ProbTrade | <%= typeof title !== 'undefined' ? title : 'Dashboard' %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        @media (min-width: 992px) {
            .sidebar {
                position: fixed !important;
                left: 0;
                top: 0;
                width: 250px !important;
                height: 100vh;
                z-index: 1040;
                transform: none !important;
            }
            .content-wrapper {
                margin-left: 250px !important;
                transition: margin-left 0.3s cubic-bezier(.4,0,.2,1);
            }
        }
        @media (max-width: 991.98px) {
            body.sidebar-open { overflow: hidden; }
            .sidebar {
                position: fixed !important;
                left: 0;
                top: 0;
                height: 100vh;
                width: 80vw !important;
                max-width: 320px !important;
                box-shadow: 2px 0 16px rgba(44,62,80,0.18);
                background: linear-gradient(135deg, #232526 0%, #414345 100%);
                transform: translateX(-100%);
                transition: transform 0.3s cubic-bezier(.4,0,.2,1);
                z-index: 4000 !important;
            }
            .sidebar.open { transform: translateX(0); }
            .content-wrapper { margin-left: 0 !important; padding-top: 56px; }
            .navbar { position: sticky; top: 0; z-index: 1050; }
        }
        @media (max-width: 575.98px) {
            .sidebar { width: 100vw !important; max-width: 100vw !important; }
            .sidebar-logo img { height: 24px; }
            .btn, .form-control, .form-select { font-size: 0.95rem; padding: 0.4rem 1rem; }
            .table th, .table td { font-size: 0.92rem; }
        }
        body, html {
            font-family: 'Inter', 'Segoe UI', Arial, sans-serif;
            background: #f5f6fa;
            color: #23272f;
        }
        h1, h2, h3, h4, h6 { font-weight: 700; color: #23272f; }
        .card {
            border-radius: 1rem;
            box-shadow: 0 2px 16px rgba(44,62,80,0.08);
            border: none;
            background: #fff;
        }
        .card-header {
            background: #fff;
            border-bottom: 1px solid #f0f1f3;
            font-weight: 600;
            font-size: 1.1rem;
        }
        .table {
            border-radius: 0.75rem;
            overflow: hidden;
            background: #fff;
            font-size: 0.98rem;
            color: #000;
        }
        .table th {
            background: #f5f6fa;
            color: #6c757d;
            font-weight: 600;
            border: none;
        }
        .table td { border: none; vertical-align: middle; }
        .btn {
            border-radius: 0.5rem;
            font-weight: 500;
            padding: 0.5rem 1.25rem;
            transition: background 0.2s, color 0.2s;
        }
        .btn-sm { padding: 0.25rem 0.5rem; font-size: 0.875rem; }
        .btn-primary {
            background: linear-gradient(90deg, #1677ff 0%, #11cdef 100%);
            border: none;
        }
        .btn-outline-primary { border-color: #1677ff; color: #1677ff; }
        .btn-outline-primary:hover { background: #1677ff; color: #fff; }
        .form-control, .form-select {
            border-radius: 0.5rem;
            border: 1px solid #e0e3e7;
            font-size: 1rem;
        }
        .badge {
            border-radius: 1rem;
            font-size: 0.85rem;
            font-weight: 600;
            padding: 0.4em 0.8em;
        }
        .avatar {
            border-radius: 50%;
            background: #1677ff;
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
        }
        [x-cloak] { display: none !important; }
        .sidebar {
            overflow-y: auto;
            max-height: 100vh;
            scrollbar-width: thin;
            scrollbar-color: #1677ff #232526;
            overscroll-behavior-y: contain;
            min-height: 100vh;
            transition: all 0.3s cubic-bezier(.4,0,.2,1);
            background: linear-gradient(135deg, #232526 0%, #414345 100%);
            box-shadow: 2px 0 16px rgba(44,62,80,0.08);
        }
        .sidebar::-webkit-scrollbar { width: 8px; }
        .sidebar::-webkit-scrollbar-thumb { background: #1677ff; border-radius: 8px; }
        .sidebar::-webkit-scrollbar-track { background: #232526; }
        .sidebar-logo {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem 0 1rem 0;
        }
        .sidebar-logo img { height: 32px; margin-right: 0.5rem; }
        .sidebar-section {
            padding: 0.75rem 1.5rem 0.25rem 1.5rem;
            font-size: 0.75rem;
            color: #b0b3b8;
            letter-spacing: 1px;
            text-transform: uppercase;
        }
        .sidebar-divider { border-bottom: 1px solid #343a40; margin: 0.5rem 0; }
        .sidebar-link {
            color: #f8f9fa;
            text-decoration: none;
            display: flex;
            align-items: center;
            padding: 0.65rem 1.25rem;
            border-radius: 0.5rem;
            margin-bottom: 0.25rem;
            font-weight: 500;
            font-size: 1rem;
            transition: background 0.2s, color 0.2s;
            position: relative;
        }
        .sidebar-link.active {
            background: linear-gradient(90deg, #1677ff 0%, #11cdef 100%);
            color: #fff;
            box-shadow: 0 2px 8px rgba(22,119,255,0.08);
        }
        .sidebar-link:hover { background: rgba(22,119,255,0.12); color: #fff; }
        .sidebar-link i { width: 1.5rem; text-align: center; margin-right: 0.75rem; font-size: 1.2rem; }
        .sidebar .nav { margin-bottom: 1rem; }
        .sidebar h5 { color: white !important; }
        .navbar h1, .navbar .h5 { color: #23272f !important; }
        @media (min-width: 992px) { .ms-lg-250 { margin-left: 250px; } }

        /* Light-theme support for pages that still use the earlier utility classes */
        :root {
            --bg: #f5f6fa;
            --card-bg: #fff;
            --border: #e0e3e7;
            --accent: #1677ff;
            --accent2: #11cdef;
            --danger: #dc3545;
            --warning: #ffc107;
            --success: #198754;
            --text: #23272f;
            --text-muted: #6c757d;
        }
        .stats-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px; }
        .stat-card { background: #fff; border-radius: 12px; padding: 18px; display: flex; align-items: flex-start; gap: 14px; box-shadow: 0 2px 16px rgba(44,62,80,0.08); }
        .stat-icon { width: 42px; height: 42px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0; }
        .stat-icon.blue { background: rgba(22,119,255,0.12); color: #1677ff; }
        .stat-icon.green { background: rgba(25,135,84,0.12); color: #198754; }
        .stat-icon.yellow { background: rgba(255,193,7,0.2); color: #b58100; }
        .stat-icon.red { background: rgba(220,53,69,0.12); color: #dc3545; }
        .stat-icon.teal { background: rgba(17,205,239,0.15); color: #0aa2c0; }
        .stat-label { font-size: 11px; color: #6c757d; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 500; }
        .stat-value { font-size: 22px; font-weight: 700; margin-top: 2px; }
        .table-wrap { overflow-x: auto; }
.table-wrap table { width: 100%; border-collapse: collapse; background: #fff; }
.table-wrap th { background: #f5f6fa; color: #6c757d; font-weight: 600; padding: 10px 12px; text-align: left; font-size: 0.85rem; }
.table-wrap td { padding: 11px 12px; border-bottom: 1px solid #f0f1f3; vertical-align: middle; }
        .card-title { font-size: 14px; font-weight: 600; }
        .card-subtitle { font-size: 12px; color: #6c757d; margin-top: 2px; }
        .badge-success { background: #198754; color: #fff; }
        .badge-danger { background: #dc3545; color: #fff; }
        .badge-warning { background: #ffc107; color: #212529; }
        .badge-info { background: #1677ff; color: #fff; }
        .badge-secondary { background: #6c757d; color: #fff; }
        .search-bar { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 16px; align-items: center; }
        .search-bar .form-control { max-width: 260px; }
        .form-label { display: block; font-size: 12px; font-weight: 600; color: #6c757d; margin-bottom: 6px; }
        .form-group { margin-bottom: 16px; }
        .form-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; }
        .form-actions { display: flex; gap: 10px; margin-top: 20px; padding-top: 16px; border-top: 1px solid #e0e3e7; }
        .alert-error { background: #f8d7da; border: 1px solid #f5c2c7; color: #842029; padding: 12px 16px; border-radius: 8px; margin-bottom: 16px; }
        .btn-group { display: flex; gap: 6px; flex-wrap: wrap; }
        .pagination { display: flex; gap: 6px; align-items: center; justify-content: center; margin-top: 16px; }
        .page-link.active, .pagination .page-link.active { background: #1677ff; border-color: #1677ff; color: #fff; }
        .dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; margin-right: 6px; }
        .dot-green { background: #198754; }
        .dot-red { background: #dc3545; }
        .dot-yellow { background: #ffc107; }
    </style>
    <%- typeof extraHead !== 'undefined' ? extraHead : '' %>
    <%- typeof extraCss !== 'undefined' ? extraCss : '' %>
</head>
<body class="bg-light">
<%
  const adminName = (locals.admin && admin.name) ? admin.name : 'Admin';
  const adminInitial = String(adminName).charAt(0).toUpperCase();
%>
<div x-data="{ sidebarOpen: window.innerWidth >= 992, dropdownOpen: false, notificationOpen: false }" x-init="window.addEventListener('resize', () => { sidebarOpen = window.innerWidth >= 992; })">
    <div x-show="sidebarOpen && window.innerWidth < 992" @click="sidebarOpen = false" class="position-fixed w-100 bg-dark opacity-50" style="z-index: 3000; top:56px; height:calc(100vh - 56px);" x-cloak></div>

    <%- include('../partials/sidebar') %>

    <div class="content-wrapper d-flex flex-column" :class="{ 'ms-lg-250': sidebarOpen }" style="min-height: 100vh;">
        <header class="navbar navbar-expand-lg navbar-light bg-white border-bottom">
            <div class="container-fluid">
                <button @click="sidebarOpen = !sidebarOpen" class="btn btn-link text-dark d-lg-none" type="button">
                    <i class="bi bi-list" style="font-size: 1.5rem;"></i>
                </button>
                <h1 class="h5 mb-0"><%= typeof title !== 'undefined' ? title : 'Dashboard' %></h1>
                <div class="d-flex align-items-center">
                    <div class="dropdown ms-3" x-data="{ open: false }">
                        <button @click="open = !open" class="btn btn-link text-dark position-relative" type="button">
                            <i class="bi bi-bell" style="font-size: 1.25rem;"></i>
                            <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle">
                                <span class="visually-hidden">New alerts</span>
                            </span>
                        </button>
                        <div x-show="open" @click.away="open = false" class="dropdown-menu dropdown-menu-end shadow" style="min-width: 300px;">
                            <div class="dropdown-header"><h6 class="mb-0">Notifications</h6></div>
                            <div class="dropdown-divider"></div>
                            <a href="#" class="dropdown-item">
                                <div class="d-flex align-items-center">
                                    <div class="flex-shrink-0"><i class="bi bi-person-plus text-primary me-2"></i></div>
                                    <div class="flex-grow-1">
                                        <div>New user registered</div>
                                        <small class="text-muted">2 minutes ago</small>
                                    </div>
                                </div>
                            </a>
                            <div class="dropdown-divider"></div>
                            <a href="#" class="dropdown-item text-center">View all notifications</a>
                        </div>
                    </div>
                    <div class="dropdown ms-2" x-data="{ open: false }">
                        <button @click="open = !open" class="btn btn-link text-dark text-decoration-none d-flex align-items-center" type="button">
                            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                <%= adminInitial %>
                            </div>
                            <span class="ms-2 d-none d-md-inline"><%= adminName %></span>
                            <i class="bi bi-chevron-down ms-1"></i>
                        </button>
                        <div x-show="open" @click.away="open = false" class="dropdown-menu dropdown-menu-end shadow">
                            <h6 class="dropdown-header">Welcome, <%= adminName %></h6>
                            <%# NEW IMPLEMENTATION — NODE.JS PROJECT: Admin User Access Control — show role, hide links the admin cannot open %>
                            <div class="px-3 pb-1 small text-muted"><i class="bi bi-shield me-1"></i><%= locals.adminRoleName || 'No role assigned' %></div>
                            <div class="dropdown-divider"></div>
                            <a href="/profile" class="dropdown-item"><i class="bi bi-person me-2"></i> Profile</a>
                            <% if (typeof can === 'function' && can('app_settings.view')) { %>
                            <a href="/settings" class="dropdown-item"><i class="bi bi-gear me-2"></i> Settings</a>
                            <% } %>
                            <div class="dropdown-divider"></div>
                            <form action="/logout" method="POST" class="w-100">
                                <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2"></i> Sign out</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <main class="flex-grow-1 p-4">
            <% if (locals.success && success.length > 0) { %>
                <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    <%= success[0] %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>
            <% if (locals.warning && warning.length > 0) { %>
                <div class="alert alert-warning alert-dismissible fade show mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <%= warning[0] %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>
            <% if (locals.error && error.length > 0) { %>
                <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                    <i class="bi bi-x-circle-fill me-2"></i>
                    <%= error[0] %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>
            <%- body %>
        </main>

        <footer class="bg-light py-3 border-top">
            <div class="container-fluid">
                <div class="text-center text-muted small">
                    &copy; <%= new Date().getFullYear() %> ProbTrade. All rights reserved.
                </div>
            </div>
        </footer>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
<script>
function updateLiveContestCount() {
    fetch('/api/live-contests-count')
        .then(response => response.json())
        .then(data => {
            const badge = document.getElementById('liveContestCount');
            if (badge) {
                badge.textContent = data.count || 0;
                badge.style.display = data.count > 0 ? 'inline' : 'none';
            }
        })
        .catch(() => {});
}
<%# NEW IMPLEMENTATION — NODE.JS PROJECT: Admin User Access Control — only poll when the admin can see Live Management %>
<% if (typeof can === 'function' && can('live_management.view')) { %>
setInterval(updateLiveContestCount, 30000);
document.addEventListener('DOMContentLoaded', updateLiveContestCount);
<% } %>
document.querySelectorAll('[data-confirm]').forEach(el => {
    el.addEventListener('click', e => {
        if (!confirm(el.dataset.confirm || 'Are you sure?')) e.preventDefault();
    });
});
</script>
<%- typeof extraJs !== 'undefined' ? extraJs : '' %>
</body>
</html>
