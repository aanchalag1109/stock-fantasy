<%
  // NEW IMPLEMENTATION — NODE.JS PROJECT: INR ProbCoin purchases (orders before the conversion: ₹ 1:1)
  const fmt2 = (n) => Number(n || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const coinsOf = (p) => (p.probcoins != null ? p.probcoins : p.amount);
  const when = (d) => d ? new Date(d).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '—';
  const tabs = [['', 'All'], ['0', 'Pending'], ['3', 'Needs review'], ['4', 'Processing'], ['1', 'Success'], ['-1', 'Failed']];
  const tabLink = (value) => '/payments?' + [value !== '' ? 'status=' + value : '', search ? 'search=' + encodeURIComponent(search) : ''].filter(Boolean).join('&');
%>
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0">Deposit Orders</h1>
            <small class="text-muted">INR ProbCoin purchases via LG Pay. USDT deposits are under <a href="/usdt-deposits">USDT Deposits</a>.</small>
        </div>
    </div>
    <div class="card mb-3">
        <div class="card-body">
            <%# NEW IMPLEMENTATION — NODE.JS PROJECT (client feedback): status tabs like USDT Deposits %>
            <div class="btn-group flex-wrap mb-3" role="group">
                <% tabs.forEach(([value, label]) => { const on = String(status) === value; %>
                <a href="<%= tabLink(value) %>" class="btn btn-sm <%= on ? 'btn-dark' : 'btn-outline-dark' %>" data-status-tab="<%= value || 'all' %>"><%= label %> <span class="badge <%= on ? 'bg-light text-dark' : 'bg-secondary' %> ms-1"><%= counts[value || 'all'] || 0 %></span></a>
                <% }) %>
            </div>
            <form method="GET" action="/payments" class="row g-3" id="filterForm">
                <div class="col-md-3">
                    <input type="text" name="search" class="form-control" placeholder="Search Order ID, User..." value="<%= search %>" id="searchInput">
                </div>
                <div class="col-md-3">
                    <select name="status" class="form-select" id="statusSelect">
                        <option value="">All Status</option>
                        <option value="0" <%= status === '0' ? 'selected' : '' %>>Pending</option>
                        <option value="1" <%= status === '1' ? 'selected' : '' %>>Success</option>
                        <option value="3" <%= status === '3' ? 'selected' : '' %>>Needs review</option>
                        <option value="4" <%= status === '4' ? 'selected' : '' %>>Processing</option>
                        <option value="-1" <%= status === '-1' ? 'selected' : '' %>>Failed</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary">Filter</button>
                    <a href="/payments" class="btn btn-secondary">Reset</a>
                </div>
            </form>
        </div>
    </div>
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr><th>Order ID</th><th>User</th><th>Paid (INR)</th><th>ProbCoins</th><th>Status</th><th>Created</th><th>Updated</th><th>Action</th></tr>
                    </thead>
                    <tbody>
                        <% payments.forEach(payment => { %>
                        <tr>
                            <td><strong><%= payment.order_id %></strong></td>
                            <td>
                                <div><%= payment.user ? payment.user.name : 'N/A' %></div>
                                <small class="text-muted"><%= payment.user ? (payment.user.mobile || payment.user.email || '') : '' %></small>
                            </td>
                            <td>
                                <strong>₹<%= fmt2(payment.amount) %></strong>
                                <% if (payment.charges) { %><div class="small text-muted">₹<%= fmt2(payment.base_amount) %> + charges ₹<%= fmt2(payment.charges) %><%= payment.charges_bearer === 'platform' ? ' (absorbed)' : '' %></div><% } %>
                                <% if (payment.paid_amount != null && Number(payment.paid_amount) !== Number(payment.amount)) { %><div class="small text-danger">received ₹<%= fmt2(payment.paid_amount) %></div><% } %>
                            </td>
                            <td><strong><%= fmt2(coinsOf(payment)) %></strong> <small class="text-muted"><%= payment.rate ? '@' + payment.rate : '1:1' %></small></td>
                            <td>
                                <% if (payment.payment_status == 1) { %><span class="badge bg-success">Success</span>
                                <% } else if (payment.payment_status == 3) { %><span class="badge bg-warning text-dark">Needs review</span>
                                <% } else if (payment.payment_status == -1) { %><span class="badge bg-danger">Failed</span>
                                <% } else if (payment.payment_status == 4) { %><span class="badge bg-warning">Processing</span>
                                <% } else { %><span class="badge bg-secondary">Pending</span><% } %>
                                <% if (payment.review_reason) { %><div class="small text-muted mt-1" style="max-width:240px"><%= payment.review_reason %></div><% } %>
                            </td>
                            <td><%= when(payment.created_at) %></td>
                            <td><%= when(payment.updated_at) %></td>
                            <td>
                                <a href="/payments/<%= payment._id %>" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye me-1"></i>View</a>
                            </td>
                        </tr>
                        <% }) %>
                        <% if (!payments.length) { %>
                        <tr><td colspan="8" class="text-center">No payments found</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
            <p class="text-muted mb-0 mt-3"><%= total %> results</p>
            <%- include('../partials/pagination', { pages, page, extraQuery: 'search=' + encodeURIComponent(search || '') + '&status=' + encodeURIComponent(status || '') }) %>
        </div>
    </div>
</div>
<script>
document.getElementById('statusSelect')?.addEventListener('change', function() {
    document.getElementById('filterForm').submit();
});
</script>
