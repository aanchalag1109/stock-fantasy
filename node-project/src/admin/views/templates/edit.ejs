<%#
  PHP PARITY — restored from PHP admin/templates/edit.blade.php: besides the name fields, the
  template's assets can be changed.
  NEW IMPLEMENTATION — NODE.JS PROJECT (client feedback): Market Type (Indian Stock / US Stock /
  Crypto) and the same category ↔ asset picker and minimum checks as Create Session.
%>
<div class="container-fluid">
    <h1 class="h3 mb-4">Edit Template</h1>
    <div class="card shadow-sm">
        <div class="card-body">
            <form method="POST" action="/templates/<%= template._id %>?_method=PUT" id="templateForm">
                <input type="hidden" name="assets_loaded" id="assets_loaded" value="0">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" for="template_name">Template Name</label>
                        <input class="form-control" id="template_name" name="template_name" value="<%= template.template_name %>" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="name">Session Name</label>
                        <input class="form-control" id="name" name="name" value="<%= template.name %>" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="market">Market Type</label>
                        <select class="form-select" id="market" name="market">
                            <% Object.entries(marketOptions).forEach(([key, m]) => { %>
                            <option value="<%= key %>" <%= market === key ? 'selected' : '' %>><%= m.label %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="max_stocks">Max Assets</label>
                        <input class="form-control" type="number" id="max_stocks" name="max_stocks" value="<%= template.max_stocks || 5 %>">
                    </div>
                </div>

                <h6 class="mt-4 mb-2"><i class="bi bi-collection me-2"></i>Market Categories &amp; Assets</h6>
                <div class="card border-0 bg-light"><div class="card-body">
                    <div id="asset-picker"></div>
                    <div class="form-text">If the picker can't load, saving keeps the template's current assets.</div>
                </div></div>

                <div class="mt-4">
                    <button class="btn btn-primary" type="submit">Save</button>
                    <a href="/templates" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="/js/session-asset-picker.js"></script>
<script>
(function () {
    var picker = SessionAssetPicker({
        root: document.getElementById('asset-picker'),
        marketSelect: document.getElementById('market'),
        market: <%- JSON.stringify(market).replace(/</g, '\\u003c') %>,
        selection: <%- JSON.stringify(selection).replace(/</g, '\\u003c') %>,
        categoryIds: <%- JSON.stringify(selectedCategoryIds).replace(/</g, '\\u003c') %>,
        loadedInput: document.getElementById('assets_loaded'),
    });
    document.getElementById('templateForm').addEventListener('submit', function (e) {
        if (picker.isReady() && picker.validate().length) { e.preventDefault(); picker.showErrors(); }
    });
})();
</script>
