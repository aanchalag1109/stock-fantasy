<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-md-6">
            <h4 class="mb-0">
                <i class="bi bi-clock-history me-2"></i>Cron Check Logs
                <span id="updateIndicator" class="ms-2 badge bg-success d-none" style="font-size: 0.6rem;">Updating...</span>
            </h4>
            <p class="text-muted small">
                Live Status: <span id="lastUpdated" class="fw-bold text-dark"></span>
                <span class="ms-2 text-info small"><i class="bi bi-broadcast"></i> Auto-refreshing via AJAX</span>
            </p>
        </div>
        <div class="col-md-6 text-end">
            <div class="d-flex justify-content-end gap-2">
                <button onclick="fetchLogs()" class="btn btn-outline-primary btn-sm" type="button">
                    <i class="bi bi-arrow-clockwise me-1"></i>Refresh Now
                </button>
                <form action="/cron-logs/clear?_method=DELETE" method="POST" onsubmit="return confirm('Are you sure you want to clear all logs?');" class="d-inline">
                    <button type="submit" class="btn btn-danger btn-sm"><i class="bi bi-trash me-2"></i>Clear All Logs</button>
                </form>
            </div>
        </div>
    </div>
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Run Time</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th>Output</th>
                            <th class="pe-4 text-end">Diff</th>
                        </tr>
                    </thead>
                    <tbody id="logsTableBody">
                        <%- include('_rows', { logs }) %>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white border-0 py-3">
            <%- include('../partials/pagination', { pages, page, extraQuery: '' }) %>
        </div>
    </div>
</div>
<script>
// PHP PARITY: refresh the log table over AJAX every 20 s (PHP cron_logs/index.blade.php)
function fetchLogs() {
    const indicator = document.getElementById('updateIndicator');
    indicator.classList.remove('d-none');
    fetch(window.location.href, { headers: { 'X-Requested-With': 'XMLHttpRequest', Accept: 'application/json' } })
        .then(r => r.json())
        .then(data => {
            document.getElementById('logsTableBody').innerHTML = data.html;
            document.getElementById('lastUpdated').textContent = data.last_updated;
        })
        .catch(err => console.error('Error fetching logs:', err))
        .finally(() => setTimeout(() => indicator.classList.add('d-none'), 500));
}
document.getElementById('lastUpdated').textContent = new Date().toLocaleTimeString('en-GB', { hour12: false });
setInterval(fetchLogs, 20000);
</script>
