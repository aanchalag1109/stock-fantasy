<%#
  NEW IMPLEMENTATION — NODE.JS PROJECT

  Feature: USDT/INR to ProbCoin Conversion Settings
  Purpose: Allow authorized administrators to configure conversion rates.
  Origin: Newly implemented in node-project.
  Note: This feature must remain distinguishable from PHP-converted code.
%>
<%
  const canEdit = can('probcoin_conversion.edit');
  const val = (k) => (rates[k] === null || rates[k] === undefined) ? '' : rates[k];
  const fmt = (n) => Number(n).toLocaleString('en-IN', { maximumFractionDigits: rateDecimals });
  const when = (d) => d ? new Intl.DateTimeFormat('en-IN', { timeZone: 'Asia/Kolkata', day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', hour12: true }).format(new Date(d)) + ' IST' : 'Never';
  const step = '0.' + '0'.repeat(rateDecimals - 1) + '1';
  const sections = [
    { key: 'usdt_to_probcoin_rate', title: 'USDT to ProbCoin', icon: 'currency-dollar', unit: 'USDT', one: '1 USDT', example: 10, exampleLabel: '10 USDT' },
    { key: 'inr_to_probcoin_rate', title: 'INR to ProbCoin', icon: 'currency-rupee', unit: 'INR', one: '₹1 INR', example: 500, exampleLabel: '₹500 INR' },
  ];
%>
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div id="pcAlert" class="d-none mb-4" role="alert"></div>

            <div class="card shadow-lg border-0 mb-4">
                <div class="card-header bg-primary text-white d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-currency-exchange me-2" style="font-size:1.5rem;"></i>
                        <h2 class="mb-0 text-white h4">ProbCoin Conversion Settings</h2>
                    </div>
                    <span class="small">Last updated: <%= when(rates.updated_at) %></span>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-3">Set how many ProbCoin a user receives for each unit of currency. These are application rates you control — not market prices. <strong>ProbCoin = amount × rate</strong>.</p>
                    <% if (!rates.configured) { %>
                    <div class="alert alert-warning small py-2"><i class="bi bi-exclamation-triangle me-1"></i>Conversion rates have not been configured yet. Nothing is converted until both rates are saved.</div>
                    <% } %>
                    <% if (!canEdit) { %><div class="alert alert-info small py-2">You can view these rates but not change them.</div><% } %>

                    <form id="pcSettingsForm" action="/probcoin-conversion?_method=PUT" method="POST" novalidate>
                        <fieldset <%= canEdit ? '' : 'disabled' %>>
                        <div class="row g-4">
                            <% sections.forEach(section => { %>
                            <div class="col-md-6">
                                <div class="card h-100 border-0 bg-light">
                                    <div class="card-body">
                                        <h5 class="card-title mb-3"><i class="bi bi-<%= section.icon %> me-2"></i><%= section.title %></h5>
                                        <label for="<%= section.key %>" class="form-label">ProbCoin received for <%= section.one %> <span class="text-danger">*</span></label>
                                        <div class="input-group has-validation">
                                            <span class="input-group-text"><%= section.one %> =</span>
                                            <input type="number" name="<%= section.key %>" id="<%= section.key %>" class="form-control"
                                                   value="<%= val(section.key) %>" min="<%= step %>" max="<%= maxRate %>" step="<%= step %>"
                                                   inputmode="decimal" required data-example="<%= section.example %>">
                                            <span class="input-group-text">ProbCoin</span>
                                            <div class="invalid-feedback" data-error-for="<%= section.key %>"></div>
                                        </div>
                                        <div class="mt-3 p-2 bg-white rounded border small" data-preview-for="<%= section.key %>">
                                            <% if (rates[section.key] !== null) { %>
                                                <div><strong><%= section.one %> = <%= fmt(rates[section.key]) %> ProbCoin</strong></div>
                                                <div class="text-muted"><%= section.exampleLabel %> = <%= fmt(Math.floor(section.example * rates[section.key] * 100) / 100) %> ProbCoin</div>
                                            <% } else { %>
                                                <span class="text-muted">Not configured</span>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <% }) %>
                        </div>
                        </fieldset>
                        <% if (canEdit) { %>
                        <div class="d-flex justify-content-end mt-4">
                            <button type="submit" id="pcSaveBtn" class="btn btn-primary"><i class="bi bi-save me-1"></i> Save Settings</button>
                        </div>
                        <% } %>
                    </form>
                    <p class="small text-muted mt-3 mb-0">Rates must be greater than 0, up to <%= rateDecimals %> decimal places and at most <%= maxRate.toLocaleString('en-IN') %>. Converted amounts are rounded down to 2 decimals.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<% if (canEdit) { %>
<script>
document.addEventListener('DOMContentLoaded', function () {
    var form = document.getElementById('pcSettingsForm');
    var btn = document.getElementById('pcSaveBtn');
    var alertBox = document.getElementById('pcAlert');
    var btnHtml = btn.innerHTML;
    var FIELDS = {
        usdt_to_probcoin_rate: { one: '1 USDT', example: '10 USDT' },
        inr_to_probcoin_rate: { one: '₹1 INR', example: '₹500 INR' }
    };
    var submitting = false;

    function fmt(n) { return Number(n).toLocaleString('en-IN', { maximumFractionDigits: <%= rateDecimals %> }); }

    function showAlert(type, message) {
        var icon = type === 'success' ? 'check-circle-fill' : 'x-circle-fill';
        alertBox.className = 'alert alert-' + type + ' alert-dismissible fade show mb-4';
        alertBox.innerHTML = '<i class="bi bi-' + icon + ' me-2"></i><span></span>' +
            '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>';
        alertBox.querySelector('span').textContent = message;
        alertBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function setErrors(errors) {
        Object.keys(FIELDS).forEach(function (key) {
            var input = document.getElementById(key);
            var fb = form.querySelector('[data-error-for="' + key + '"]');
            if (errors[key]) { input.classList.add('is-invalid'); fb.textContent = errors[key]; }
            else { input.classList.remove('is-invalid'); fb.textContent = ''; }
        });
    }

    // Live preview only; the server is authoritative for validation and conversion.
    function updatePreview(key) {
        var input = document.getElementById(key);
        var box = form.querySelector('[data-preview-for="' + key + '"]');
        var rate = Number(input.value);
        box.textContent = '';
        if (!input.value || !(rate > 0)) {
            var none = document.createElement('span');
            none.className = 'text-muted';
            none.textContent = 'Enter a rate greater than 0';
            box.appendChild(none);
            return;
        }
        var line = document.createElement('div');
        var strong = document.createElement('strong');
        strong.textContent = FIELDS[key].one + ' = ' + fmt(rate) + ' ProbCoin';
        line.appendChild(strong);
        var ex = document.createElement('div');
        ex.className = 'text-muted';
        ex.textContent = FIELDS[key].example + ' = ' + fmt(Math.floor(Number(input.dataset.example) * rate * 100) / 100) + ' ProbCoin';
        box.appendChild(line);
        box.appendChild(ex);
    }

    function setBusy(busy) {
        submitting = busy;
        btn.disabled = busy;
        btn.innerHTML = busy ? '<span class="spinner-border spinner-border-sm me-1"></span> Saving...' : btnHtml;
    }

    Object.keys(FIELDS).forEach(function (key) {
        document.getElementById(key).addEventListener('input', function () {
            this.classList.remove('is-invalid');
            updatePreview(key);
        });
    });

    form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (submitting) return; // no duplicate submissions
        var data = {};
        Object.keys(FIELDS).forEach(function (key) { data[key] = document.getElementById(key).value; });

        setBusy(true);
        fetch('/probcoin-conversion', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify(data)
        })
            .then(function (r) {
                if (r.redirected) throw new Error('Your session has expired. Please log in again.');
                return r.json().then(function (body) { return { ok: r.ok, body: body }; });
            })
            .then(function (res) {
                if (res.ok && res.body.success) {
                    setErrors({});
                    showAlert('success', res.body.message);
                    setTimeout(function () { window.location.reload(); }, 1200); // refresh timestamp & status
                } else {
                    setErrors(res.body.errors || {});
                    showAlert('danger', res.body.message || 'Failed to save settings.');
                }
            })
            .catch(function (err) { showAlert('danger', err.message || 'Network error. Please try again.'); })
            .finally(function () { setBusy(false); });
    });
});
</script>
<% } %>
