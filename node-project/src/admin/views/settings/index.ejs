<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-lg border-0 mb-4">
                <div class="card-header bg-primary text-white d-flex align-items-center">
                    <i class="bi bi-gear me-2" style="font-size:1.5rem;"></i>
                    <h2 class="mb-0 text-white">Admin Settings</h2>
                </div>
                <div class="card-body">
                    <div class="row g-4">
                        <div class="col-md-12">
                            <div class="card h-100 border-0 bg-light">
                                <div class="card-body">
                                    <h5 class="card-title"><i class="bi bi-credit-card me-2"></i>Payment API Key</h5>
                                    <form action="/settings/payment" method="POST" class="mt-3">
                                        <div class="mb-3">
                                            <label for="payment_api" class="form-label">Payment API Key</label>
                                            <input type="text" name="payment_api" id="payment_api" class="form-control" value="<%= settingsMap.payment_api || '' %>">
                                        </div>
                                        <button type="submit" class="btn btn-primary">Save Payment API Key</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                        <%# NEW IMPLEMENTATION — NODE.JS PROJECT: Social links managed from the admin panel %>
                        <div class="col-md-12" id="social-links">
                            <div class="card h-100 border-0 bg-light">
                                <div class="card-body">
                                    <h5 class="card-title"><i class="bi bi-share me-2"></i>Social Links</h5>
                                    <p class="text-muted small mb-3">Shown in the app and on the website. Only links that are switched on are shown, in this order.
                                        <% if (social.updated_at) { %>Last saved <%= new Date(social.updated_at).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' }) %>.<% } else { %>Not saved yet — showing the website's current links.<% } %></p>
                                    <% if (Object.keys(socialErrors).length) { %>
                                    <div class="alert alert-danger py-2"><% Object.values(socialErrors).forEach((msg) => { %><div><%= msg %></div><% }) %></div>
                                    <% } %>
                                    <form action="/settings/social-links" method="POST">
                                        <% socialPlatforms.forEach((p) => { const row = social.links[p.key] || {}; %>
                                        <div class="row g-2 align-items-center mb-2">
                                            <div class="col-sm-3">
                                                <label class="form-label mb-0 fw-semibold" for="social_<%= p.key %>"><i class="bi bi-<%= p.icon %> me-1"></i><%= p.label %></label>
                                            </div>
                                            <div class="col-sm-7">
                                                <input type="url" maxlength="500" class="form-control form-control-sm <%= socialErrors[p.key] ? 'is-invalid' : '' %>" id="social_<%= p.key %>" name="links[<%= p.key %>][url]" value="<%= row.url || '' %>" placeholder="<%= p.placeholder %>">
                                            </div>
                                            <div class="col-sm-2">
                                                <div class="form-check form-switch mb-0">
                                                    <input class="form-check-input" type="checkbox" role="switch" id="social_<%= p.key %>_on" name="links[<%= p.key %>][enabled]" value="1" <%= row.enabled ? 'checked' : '' %>>
                                                    <label class="form-check-label small" for="social_<%= p.key %>_on">Show</label>
                                                </div>
                                            </div>
                                        </div>
                                        <% }) %>
                                        <button type="submit" class="btn btn-primary mt-2">Save Social Links</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                        <% const blocks = [
                            { key: 'terms', title: 'Terms & Conditions', icon: 'file-earmark-text', action: '/settings/terms', label: 'Update Terms' },
                            { key: 'privacy', title: 'Privacy Policy', icon: 'shield-lock', action: '/settings/privacy', label: 'Update Privacy Policy' },
                            { key: 'about', title: 'About', icon: 'info-circle', action: '/settings/about', label: 'Update About' },
                            { key: 'payment_policy', title: 'Payment Policy', icon: 'cash-coin', action: '/settings/payment-policy', label: 'Update Payment Policy' },
                        ]; %>
                        <% blocks.forEach(block => { %>
                        <div class="col-md-12">
                            <div class="card h-100 border-0 bg-light">
                                <div class="card-body">
                                    <h5 class="card-title"><i class="bi bi-<%= block.icon %> me-2"></i><%= block.title %></h5>
                                    <form action="<%= block.action %>" method="POST" class="mt-3">
                                        <div class="mb-3">
                                            <label class="form-label" for="<%= block.key %>"><%= block.title %></label>
                                            <textarea name="<%= block.key %>" id="<%= block.key %>" rows="5" class="form-control"><%= settingsMap[block.key] || '' %></textarea>
                                        </div>
                                        <button type="submit" class="btn btn-primary"><%= block.label %></button>
                                    </form>
                                </div>
                            </div>
                        </div>
                        <% }) %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
