<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-lg border-0 mb-4">
                <div class="card-header bg-primary text-white d-flex align-items-center">
                    <i class="bi bi-gear me-2" style="font-size:1.5rem;"></i>
                    <h2 class="mb-0 text-white">Admin Settings</h2>
                </div>
                <div class="card-body">
                    <div class="row g-4">
                        <div class="col-md-12">
                            <div class="card h-100 border-0 bg-light">
                                <div class="card-body">
                                    <h5 class="card-title"><i class="bi bi-credit-card me-2"></i>Payment API Key</h5>
                                    <form action="/settings/payment" method="POST" class="mt-3">
                                        <div class="mb-3">
                                            <label for="payment_api" class="form-label">Payment API Key</label>
                                            <input type="text" name="payment_api" id="payment_api" class="form-control" value="<%= settingsMap.payment_api || '' %>">
                                        </div>
                                        <button type="submit" class="btn btn-primary">Save Payment API Key</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                        <% const blocks = [
                            { key: 'terms', title: 'Terms & Conditions', icon: 'file-earmark-text', action: '/settings/terms', label: 'Update Terms' },
                            { key: 'privacy', title: 'Privacy Policy', icon: 'shield-lock', action: '/settings/privacy', label: 'Update Privacy Policy' },
                            { key: 'about', title: 'About', icon: 'info-circle', action: '/settings/about', label: 'Update About' },
                            { key: 'payment_policy', title: 'Payment Policy', icon: 'cash-coin', action: '/settings/payment-policy', label: 'Update Payment Policy' },
                        ]; %>
                        <% blocks.forEach(block => { %>
                        <div class="col-md-12">
                            <div class="card h-100 border-0 bg-light">
                                <div class="card-body">
                                    <h5 class="card-title"><i class="bi bi-<%= block.icon %> me-2"></i><%= block.title %></h5>
                                    <form action="<%= block.action %>" method="POST" class="mt-3">
                                        <div class="mb-3">
                                            <label class="form-label" for="<%= block.key %>"><%= block.title %></label>
                                            <textarea name="<%= block.key %>" id="<%= block.key %>" rows="5" class="form-control"><%= settingsMap[block.key] || '' %></textarea>
                                        </div>
                                        <button type="submit" class="btn btn-primary"><%= block.label %></button>
                                    </form>
                                </div>
                            </div>
                        </div>
                        <% }) %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
