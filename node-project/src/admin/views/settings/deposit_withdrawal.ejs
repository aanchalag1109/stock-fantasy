<%#
  NEW IMPLEMENTATION — NODE.JS PROJECT

  Feature: Deposit and Withdrawal Settings Module
  Purpose: Manage minimum and maximum deposit and withdrawal limits
  Origin: Newly implemented in node-project; not directly converted
           from the original PHP implementation.

  Important: Keep this implementation distinguishable from the
  original PHP project when comparing functionality in the future.

  Client feedback: limits and deposit gateway charges are configured separately for INR (LG Pay)
  and USDT (PayRam). Conversion rates stay on the ProbCoin Conversion page.
%>
<%
  const val = (k) => (limits[k] === null || limits[k] === undefined) ? '' : limits[k];
  const columns = [
    { currency: 'INR', unit: '₹', gateway: 'LG Pay', rate: rates.inr_to_probcoin_rate, required: true,
      limits: [['min_deposit_amount', 'Minimum deposit'], ['max_deposit_amount', 'Maximum deposit'], ['min_withdrawal_amount', 'Minimum withdrawal'], ['max_withdrawal_amount', 'Maximum withdrawal']],
      charges: ['inr_deposit_charge_percent', 'inr_deposit_charge_fixed', 'inr_deposit_charge_bearer'] },
    { currency: 'USDT', unit: 'USDT', gateway: 'PayRam', rate: rates.usdt_to_probcoin_rate, required: false,
      limits: [['usdt_min_deposit_amount', 'Minimum deposit'], ['usdt_max_deposit_amount', 'Maximum deposit'], ['usdt_min_withdrawal_amount', 'Minimum withdrawal'], ['usdt_max_withdrawal_amount', 'Maximum withdrawal']],
      charges: ['usdt_deposit_charge_percent', 'usdt_deposit_charge_fixed', 'usdt_deposit_charge_bearer'] },
  ];
  const fieldKeys = Object.keys(limits);
%>
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-xl-11">
            <div id="dwAlert" class="d-none mb-4" role="alert"></div>

            <div class="card shadow-lg border-0 mb-4">
                <div class="card-header bg-primary text-white d-flex align-items-center">
                    <i class="bi bi-sliders me-2" style="font-size:1.5rem;"></i>
                    <h2 class="mb-0 text-white h4">Deposit &amp; Withdrawal Settings</h2>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-4">
                        Users buy ProbCoins in INR (LG Pay) or USDT (PayRam) and withdraw ProbCoins as INR or USDT.
                        Limits are in each currency. Deposit gateway charges are added on top when the user pays them, or absorbed when the platform pays.
                        Conversion rates are set on <a href="/probcoin-conversion">ProbCoin Conversion</a>.
                    </p>

                    <form id="dwSettingsForm" action="/deposit-withdrawal-settings" method="POST" novalidate>
                        <div class="row g-4">
                            <% columns.forEach(col => { %>
                            <div class="col-lg-6">
                                <div class="card h-100 border-0 bg-light" data-currency="<%= col.currency %>">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start mb-3">
                                            <h5 class="card-title mb-0"><%= col.currency %> <small class="text-muted">via <%= col.gateway %></small></h5>
                                            <% if (col.rate) { %>
                                            <span class="badge bg-success">1 <%= col.currency === 'INR' ? '₹' : 'USDT' %> = <%= col.rate %> ProbCoins</span>
                                            <% } else { %>
                                            <a href="/probcoin-conversion" class="badge bg-danger text-decoration-none">Rate not set</a>
                                            <% } %>
                                        </div>

                                        <h6 class="text-muted text-uppercase small mt-2">Limits (<%= col.unit %>)</h6>
                                        <% if (!col.required) { %><p class="small text-muted mb-2">Leave all four empty to use the server defaults for deposits (<%= usdtDefaults.min %>–<%= usdtDefaults.max %> USDT) and keep USDT withdrawals off.</p><% } %>
                                        <div class="row g-2">
                                            <% col.limits.forEach(([key, label]) => { %>
                                            <div class="col-sm-6">
                                                <label for="<%= key %>" class="form-label small mb-1"><%= label %><% if (col.required) { %> <span class="text-danger">*</span><% } %></label>
                                                <div class="input-group input-group-sm has-validation">
                                                    <span class="input-group-text"><%= col.unit %></span>
                                                    <input type="number" name="<%= key %>" id="<%= key %>" class="form-control" value="<%= val(key) %>"
                                                           min="0.01" max="<%= maxAllowed %>" step="0.01" inputmode="decimal" <%= col.required ? 'required' : '' %>>
                                                    <div class="invalid-feedback" data-error-for="<%= key %>"></div>
                                                </div>
                                            </div>
                                            <% }) %>
                                        </div>

                                        <h6 class="text-muted text-uppercase small mt-4">Deposit gateway charges</h6>
                                        <div class="row g-2">
                                            <div class="col-sm-4">
                                                <label for="<%= col.charges[0] %>" class="form-label small mb-1">Percent</label>
                                                <div class="input-group input-group-sm has-validation">
                                                    <input type="number" name="<%= col.charges[0] %>" id="<%= col.charges[0] %>" class="form-control" value="<%= val(col.charges[0]) %>" min="0" max="<%= maxChargePercent %>" step="0.01">
                                                    <span class="input-group-text">%</span>
                                                    <div class="invalid-feedback" data-error-for="<%= col.charges[0] %>"></div>
                                                </div>
                                            </div>
                                            <div class="col-sm-4">
                                                <label for="<%= col.charges[1] %>" class="form-label small mb-1">Fixed</label>
                                                <div class="input-group input-group-sm has-validation">
                                                    <span class="input-group-text"><%= col.unit %></span>
                                                    <input type="number" name="<%= col.charges[1] %>" id="<%= col.charges[1] %>" class="form-control" value="<%= val(col.charges[1]) %>" min="0" step="0.01">
                                                    <div class="invalid-feedback" data-error-for="<%= col.charges[1] %>"></div>
                                                </div>
                                            </div>
                                            <div class="col-sm-4">
                                                <label for="<%= col.charges[2] %>" class="form-label small mb-1">Paid by</label>
                                                <select name="<%= col.charges[2] %>" id="<%= col.charges[2] %>" class="form-select form-select-sm">
                                                    <option value="user" <%= val(col.charges[2]) !== 'platform' ? 'selected' : '' %>>User (added on top)</option>
                                                    <option value="platform" <%= val(col.charges[2]) === 'platform' ? 'selected' : '' %>>Platform (absorbed)</option>
                                                </select>
                                                <div class="invalid-feedback" data-error-for="<%= col.charges[2] %>"></div>
                                            </div>
                                        </div>
                                        <div class="small text-muted mt-2" data-example="<%= col.currency %>"></div>

                                        <%# NEW IMPLEMENTATION — NODE.JS PROJECT (client feedback): withdrawals on / off per currency %>
                                        <% const switchKey = col.currency.toLowerCase() + '_withdrawal_status'; %>
                                        <h6 class="text-muted text-uppercase small mt-4"><%= col.currency %> withdrawals</h6>
                                        <label for="<%= switchKey %>" class="form-label small mb-1">Allow users to withdraw in <%= col.currency %></label>
                                        <select name="<%= switchKey %>" id="<%= switchKey %>" class="form-select form-select-sm" style="max-width:200px">
                                            <option value="enabled" <%= val(switchKey) !== 'disabled' ? 'selected' : '' %>>Enabled</option>
                                            <option value="disabled" <%= val(switchKey) === 'disabled' ? 'selected' : '' %>>Disabled</option>
                                        </select>
                                        <div class="invalid-feedback" data-error-for="<%= switchKey %>"></div>
                                        <div class="form-text mb-2">Disabled stops new <%= col.currency %> requests at once. Requests already made stay in Withdrawal Requests and can still be accepted or rejected.<% if (col.currency === 'USDT') { %> Enabled also needs the USDT limits and rate to be set.<% } %></div>
                                        <% if (col.currency === 'USDT') { %>
                                        <label for="usdt_withdrawal_network" class="form-label small mb-1">Network users withdraw to</label>
                                        <select name="usdt_withdrawal_network" id="usdt_withdrawal_network" class="form-select form-select-sm" style="max-width:200px">
                                            <% networks.forEach(n => { %><option value="<%= n %>" <%= val('usdt_withdrawal_network') === n ? 'selected' : '' %>><%= n %></option><% }) %>
                                        </select>
                                        <div class="invalid-feedback" data-error-for="usdt_withdrawal_network"></div>
                                        <div class="form-text">If you change this, players must save a USDT address for the new network before their next withdrawal.</div>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                            <% }) %>
                        </div>

                        <div class="d-flex justify-content-end mt-4">
                            <button type="submit" id="dwSaveBtn" class="btn btn-primary">
                                <i class="bi bi-save me-1"></i> Save Settings
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    var form = document.getElementById('dwSettingsForm');
    var btn = document.getElementById('dwSaveBtn');
    var alertBox = document.getElementById('dwAlert');
    var btnHtml = btn.innerHTML;
    var FIELDS = <%- String(JSON.stringify(fieldKeys)).replace(/</g, '\\u003c') %>;
    var RATES = { INR: <%- String(JSON.stringify(rates.inr_to_probcoin_rate)).replace(/</g, '\\u003c') %>, USDT: <%- String(JSON.stringify(rates.usdt_to_probcoin_rate)).replace(/</g, '\\u003c') %> };
    var submitting = false;
    var el = function (id) { return document.getElementById(id); };

    function showAlert(type, message) {
        var icon = type === 'success' ? 'check-circle-fill' : 'x-circle-fill';
        alertBox.className = 'alert alert-' + type + ' alert-dismissible fade show mb-4';
        alertBox.innerHTML = '<i class="bi bi-' + icon + ' me-2"></i><span></span>' +
            '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>';
        alertBox.querySelector('span').textContent = message;
        alertBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function setErrors(errors) {
        FIELDS.forEach(function (key) {
            var input = el(key);
            var fb = form.querySelector('[data-error-for="' + key + '"]');
            if (!input || !fb) return;
            if (errors[key]) { input.classList.add('is-invalid'); fb.textContent = errors[key]; }
            else { input.classList.remove('is-invalid'); fb.textContent = ''; }
        });
    }

    // Live example: what a user pays for a 1,000 deposit (₹1,000 / 100 USDT) with the charges entered.
    function example(currency) {
        var box = form.querySelector('[data-example="' + currency + '"]');
        var p = currency === 'INR' ? 'inr' : 'usdt';
        if (!box) return;
        var base = currency === 'INR' ? 1000 : 100;
        var charges = Math.ceil(base * (Number(el(p + '_deposit_charge_percent').value) || 0)) / 100 + (Number(el(p + '_deposit_charge_fixed').value) || 0);
        var userPays = el(p + '_deposit_charge_bearer').value === 'user';
        var f = function (n) { return currency === 'INR' ? '₹' + n.toFixed(2) : n.toFixed(2) + ' USDT'; };
        var coins = RATES[currency] ? ' → ' + (base * RATES[currency]).toLocaleString('en-IN') + ' ProbCoins' : '';
        box.textContent = 'Example: deposit ' + f(base) + coins + ', charges ' + f(charges) + ', user pays ' + f(userPays ? base + charges : base) + (userPays ? '' : ' (charges absorbed)');
    }
    ['INR', 'USDT'].forEach(function (c) {
        var p = c === 'INR' ? 'inr' : 'usdt';
        ['_deposit_charge_percent', '_deposit_charge_fixed', '_deposit_charge_bearer'].forEach(function (s) {
            el(p + s).addEventListener('input', function () { example(c); });
            el(p + s).addEventListener('change', function () { example(c); });
        });
        example(c);
    });

    function setBusy(busy) {
        submitting = busy;
        btn.disabled = busy;
        btn.innerHTML = busy ? '<span class="spinner-border spinner-border-sm me-1"></span> Saving...' : btnHtml;
    }

    FIELDS.forEach(function (key) {
        if (el(key)) el(key).addEventListener('input', function () { this.classList.remove('is-invalid'); });
    });

    // The server validates everything (services/deposit-withdrawal-settings.service.js) and returns field errors.
    form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (submitting) return;
        var data = {};
        FIELDS.forEach(function (key) { if (el(key)) data[key] = el(key).value; });
        setBusy(true);
        fetch(form.action, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify(data)
        })
            .then(function (r) {
                if (r.redirected) throw new Error('Your session has expired. Please log in again.');
                return r.json().then(function (body) { return { ok: r.ok, body: body }; });
            })
            .then(function (res) {
                if (res.ok && res.body.success) {
                    FIELDS.forEach(function (key) {
                        if (el(key) && res.body.data && res.body.data[key] !== null && res.body.data[key] !== undefined) el(key).value = res.body.data[key];
                    });
                    setErrors({});
                    showAlert('success', res.body.message);
                } else {
                    setErrors(res.body.errors || {});
                    showAlert('danger', res.body.message || 'Failed to save settings.');
                }
            })
            .catch(function (err) { showAlert('danger', err.message || 'Network error. Please try again.'); })
            .finally(function () { setBusy(false); });
    });
});
</script>
